---
// A pause from reading: a big photo of Shainy beside her tools as large logo tiles. No sentences.
import { tools } from '../../data/tools';
---

<section class="studio" aria-label="Shainy and the tools she works with">
  <figure class="studio-photo">
    <img src="/images/me-placeholder.svg" alt="Shainy" width="400" height="500"/>
  </figure>
  <ul class="studio-tools">
    {tools.map((t) => <li class="tile" data-tile><Fragment set:html={t.icon} /><span>{t.name}</span></li>)}
  </ul>
</section>
