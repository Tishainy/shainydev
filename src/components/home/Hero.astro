---
import { hero } from '../../data/site';
import { star, glyph } from '../../lib/marks';

interface Props {
  /** Preview: the headline lines step in and out instead of sharing one left edge. */
  stagger?: boolean;
}
const { stagger = false } = Astro.props;
---

<!-- The star leads: it assembles shard by shard, then the headline rises in line by line. -->
<section class="hero" data-hero>
  <div class="hero-stage">
    <div class="hero-star-wrap" data-hero-star><Fragment set:html={star('hero-star')} /></div>
    <h1 class:list={['hero-h', { stagger }]}>
      {hero.lines.map((line, i) => (
        <span class="ln"><span class="in"><Fragment set:html={line} />{i === 1 && <Fragment set:html={' ' + glyph('sparkle', 'inl inl-mid')} />}{stagger && i === hero.lines.length - 1 && <Fragment set:html={' ' + glyph('sparkle', 'inl inl-end')} />}</span></span>
      ))}
    </h1>
  </div>
  <div class="hero-foot">
    <p class="hero-note">{hero.note}</p>
    <a class="btn" href="#contact">{hero.cta} <span aria-hidden="true">→</span></a>
    <p class="scroll-cue" aria-hidden="true"><span></span>Scroll</p>
  </div>
</section>
