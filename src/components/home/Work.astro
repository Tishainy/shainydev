---
import { work } from '../../data/site';
import { projects, media } from '../../data/work';
import { star } from '../../lib/marks';
---

<!-- Posters slide sideways while the section holds (desktop); phones get a vertical stack. -->
<section class="work" id="work">
  <div class="posters" data-posters>
    <div class="poster-track" data-track>
      <article class="poster po-intro">
        <p class="sec-no">{work.label}</p>
        <h2 set:html={work.html} />
        <p class="po-hint">{work.hint} <span aria-hidden="true">→</span></p>
      </article>
      {projects.map((p, i) => (
        <article class={`poster po-${p.id}`}>
          <div class="po-media"><Fragment set:html={media(p.id)} /></div>
          <div class="po-text">
            {p.wip && <p class="po-wip"><span aria-hidden="true"></span>In progress · not finished yet</p>}
            <p class="po-kind">0{i + 1} · {p.kind} · {p.who}</p>
            <h3>{p.name}</h3>
            <p class="po-line">{p.line}</p>
            {p.url && <span class="po-visit" aria-hidden="true">{p.wip ? 'Preview the site' : 'Visit the site'} <span>↗</span></span>}
          </div>
          {p.url && <a class="po-cover" href={p.url} target="_blank" rel="noopener" aria-label={p.wip ? `${p.name}: preview the site, still in progress (opens in a new tab)` : `${p.name}: visit the live site (opens in a new tab)`}></a>}
        </article>
      ))}
      <article class="poster po-next">
        <Fragment set:html={star('po-star')} />
        <h3>{work.next}</h3>
        <a class="po-btn" href="#contact">{work.nextCta}</a>
      </article>
    </div>
    <p class="po-count" aria-hidden="true"><span data-count>01</span> / 0{projects.length}</p>
  </div>
</section>
