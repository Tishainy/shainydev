---
// The homepage sections in order; shared by the real homepage and the lab previews.
import Hero from './Hero.astro';
import Band from './Band.astro';
import Services from './Services.astro';
import Work from './Work.astro';
import Process from './Process.astro';
import Chores from './Chores.astro';
import Contact from './Contact.astro';

interface Props {
  /** Preview: the staggered hero headline. */
  stagger?: boolean;
}
const { stagger = false } = Astro.props;
---

<Hero stagger={stagger} />
<Band />
<Services />
<Work />
<Process />
<Chores />
<Contact />
