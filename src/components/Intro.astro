---
// The site intro: the page's marks and the name sit across a seam between a red half and an ink half,
// then the two halves pull apart to show the page. The layout decides whether it plays (once per visit);
// scripts/intro.ts runs it and hands over to the hero animation.
import { glyph, type Glyph } from '../lib/marks';

const marks: Glyph[] = ['sparkle', 'flower', 'ring', 'plus', 'half'];
---

<!-- Each half holds the same full-screen scene, clipped to its own side, so the name looks cut in two. -->
<div class="intro" data-intro-el aria-hidden="true">
  {['top', 'bot'].map((h) => (
    <div class={`ic-half ic-${h}`}>
      <div class="ic-scene">
        <span class="ic-marks">{marks.map((g) => <Fragment set:html={glyph(g, 'ic-g')} />)}</span>
        <span class="ic-word">{[...'ShainyDev'].map((c) => <span class="ic-ch">{c}</span>)}</span>
      </div>
    </div>
  ))}
</div>
