---
import { site } from '../../data/content';
// Hero (ticket 05). Animation, wave lines and the orb live in src/scripts/hero.ts.
// The hero follows the site's theme: dark and light each have their own palette below.
// Without JS or with reduced motion, this markup is the full, readable composition.

const { lines, cta, name } = site.hero;
// The glass orb sits exactly over the dot of the name's "i", covering it. (A plain "i", not the
// dotless "ı": some phone browsers render that character in a fallback font, or not at all.)
const iIndex = name.indexOf('i');
const nameStart = name.slice(0, iIndex);
const nameEnd = name.slice(iIndex + 1);
---

<section id="hero" class="hero" data-hero>
  <canvas class="wave-lines" aria-hidden="true" data-hero-lines></canvas>
  <canvas class="wave-lines wave-lines-glow" aria-hidden="true" data-hero-glow></canvas>

  <h1 class="hero-headline">
    {lines.map((line, index) => (
      <span class:list={['hero-l', `hero-l${index + 1}`, { 'hero-it': line.italic }]} data-hero-line>
        <span class="hero-l-inner" data-hero-line-inner>
          {line.text}
          {index === lines.length - 1 && (
            <a href="#contact" class="hero-pill" data-hero-pill data-lines-avoid>{cta}</a>
          )}
        </span>
      </span>
    ))}
  </h1>

  <p class="hero-giant" aria-hidden="true" data-hero-giant>
    {nameStart}<span class="hero-i">i<span class="hero-orb" data-hero-orb data-lines-avoid><span class="hero-orb-ball glass-orb" data-hero-orb-ball></span></span></span>{nameEnd}
  </p>
</section>

<style>
  .hero {
    --hero-bg: var(--color-bg);
    --hero-fg: var(--color-fg);
    --hero-on-fg: var(--color-bg);
    --hero-pill-line: color-mix(in srgb, var(--color-fg) 55%, transparent);
    --hero-giant-fill: var(--light-fill);
    position: relative;
    height: 100svh;
    min-height: 38rem;
    overflow: clip;
    background: var(--hero-bg);
    color: var(--hero-fg);
  }

  /* Hidden only while the intro waits for fonts (see Layout). */
  :global(html.hero-pending) .hero-headline,
  :global(html.hero-pending) .hero-giant {
    visibility: hidden;
  }


  /* A centred block, each line pushed to its own spot. */
  .hero-headline {
    position: absolute;
    left: 50%;
    top: 15%;
    translate: -50% 0;
    width: min(64rem, 90vw);
    margin: 0;
    z-index: 2;
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.95;
    font-size: clamp(2.8rem, 6.3vw, 6.2rem);
    text-wrap: nowrap;
  }

  .hero-l {
    display: block;
    white-space: nowrap;
    /* Lines rise into view from behind this edge; the padding keeps descenders and
       italic overhangs from being clipped. */
    overflow: clip;
    padding: 0.06em 0.12em 0.16em 0;
    margin-bottom: -0.22em;
  }
  .hero-l-inner {
    display: inline-flex;
    align-items: center;
  }
  .hero-it {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    font-size: 1.1em;
  }
  .hero-l1 { padding-left: 2%; }
  .hero-l2 { padding-left: 40%; }
  .hero-l3 { padding-left: 0; }
  .hero-l4 { padding-left: 33%; }

  .hero-pill {
    margin-left: 1.3em;
    padding: 0.85rem 1.7rem;
    border: 1.5px solid var(--hero-pill-line);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
    color: var(--hero-fg);
    text-decoration: none;
    transition: background-color 0.25s, color 0.25s, border-color 0.25s;
  }
  .hero-pill:hover {
    background: var(--hero-fg);
    color: var(--hero-on-fg);
    border-color: var(--hero-fg);
  }

  /* The giant name, filled with light that drifts toward the cursor. */
  .hero-giant {
    position: absolute;
    left: -1%;
    right: -1%;
    bottom: -6%;
    margin: 0;
    z-index: 1;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.8;
    font-size: 29vw;
    white-space: nowrap;
    text-align: center;
    background: var(--hero-giant-fill);
    background-size: 130% 130%;
    background-position: 50% 50%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transform-origin: 50% 100%;
  }

  /* Placed from Clash Display Semibold's own metrics: the i's square dot spans 0.04–0.19em across and
     0.552–0.67em above the baseline (centre 0.115em in, 0.279em below the top of the 0.89em ascent).
     A patch in the page colour hides the square dot; the round orb sits centred on top of it. */
  .hero-i {
    position: relative;
  }
  .hero-i::before {
    content: '';
    position: absolute;
    left: 0.03em;
    top: 0.21em;
    width: 0.17em;
    height: 0.14em;
    background: var(--hero-bg);
  }
  .hero-orb {
    position: absolute;
    left: 0.045em;
    top: 0.209em;
    width: 0.14em;
    height: 0.14em;
  }
  .hero-orb-ball {
    position: absolute;
    inset: 0;
  }

  @media (max-width: 767px) {
    /* Sits lower on phones, closing the gap above the name. */
    .hero-headline { top: 27%; font-size: 12vw; }
    .hero-l2 { padding-left: 22%; }
    .hero-l4 { padding-left: 12%; }
    .hero-l4 .hero-l-inner { flex-wrap: wrap; row-gap: 1rem; }
    .hero-pill { margin-left: 0.8em; font-size: 1rem; padding: 0.75rem 1.4rem; }
    /* Sized so the whole name fits the screen width, rather than being cut off at the edges. */
    .hero-giant { font-size: 30vw; bottom: 3%; }
    .wave-lines { display: none; }
  }
</style>
