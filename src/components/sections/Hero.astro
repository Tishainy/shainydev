---
import { site } from '../../data/content';
// Hero (ticket 05). Animation, wave lines and the orb live in src/scripts/hero.ts.
// The hero follows the site's theme: dark and light each have their own palette below.
// Without JS or with reduced motion, this markup is the full, readable composition.

const { lines, cta, name } = site.hero;
// The name stays one plain text run: Safari won't paint clipped-background text inside a nested,
// positioned element, so the "i" can't be wrapped. The orb and the patch hiding the i's square dot
// are siblings, positioned by hero.ts from where the "i" actually lands.
---

<section id="hero" class="hero" data-hero>
  <canvas class="wave-lines" aria-hidden="true" data-hero-lines></canvas>
  <canvas class="wave-lines wave-lines-glow" aria-hidden="true" data-hero-glow></canvas>

  <h1 class="hero-headline">
    {lines.map((line, index) => (
      <span class:list={['hero-l', `hero-l${index + 1}`, { 'hero-it': line.italic }]} data-hero-line>
        <span class="hero-l-inner" data-hero-line-inner>
          {line.text}
          {index === lines.length - 1 && (
            <a href="#contact" class="hero-pill" data-hero-pill data-lines-avoid>{cta}</a>
          )}
        </span>
      </span>
    ))}
  </h1>

  <p class="hero-giant" aria-hidden="true" data-hero-giant>
    {name}<span class="hero-dot-cover" aria-hidden="true"></span><span class="hero-orb" data-hero-orb data-lines-avoid><span class="hero-orb-ball glass-orb" data-hero-orb-ball></span></span>
  </p>

  <!-- Phones: instead of the giant name, the glass orb leads, with ripples spreading from it. -->
  <div class="hero-m" data-hero-m aria-hidden="true">
    <span class="hero-m-ring"></span><span class="hero-m-ring"></span><span class="hero-m-ring"></span>
    <span class="hero-m-orb glass-orb" data-hero-m-orb></span>
  </div>
</section>

<style>
  .hero {
    --hero-bg: var(--color-bg);
    --hero-fg: var(--color-fg);
    --hero-on-fg: var(--color-bg);
    --hero-pill-line: color-mix(in srgb, var(--color-fg) 55%, transparent);
    --hero-giant-fill: var(--light-fill);
    position: relative;
    height: 100svh;
    min-height: 38rem;
    overflow: clip;
    background: var(--hero-bg);
    color: var(--hero-fg);
  }

  /* Hidden only while the intro waits for fonts (see Layout). */
  :global(html.hero-pending) .hero-headline,
  :global(html.hero-pending) .hero-giant {
    visibility: hidden;
  }


  /* A centred block, each line pushed to its own spot. */
  .hero-headline {
    position: absolute;
    left: 50%;
    top: 15%;
    translate: -50% 0;
    width: min(64rem, 90vw);
    margin: 0;
    z-index: 2;
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.95;
    font-size: clamp(2.8rem, 6.3vw, 6.2rem);
    text-wrap: nowrap;
  }

  .hero-l {
    display: block;
    white-space: nowrap;
    /* Lines rise into view from behind this edge; the padding keeps descenders and
       italic overhangs from being clipped. */
    overflow: clip;
    padding: 0.06em 0.12em 0.16em 0;
    margin-bottom: -0.22em;
  }
  .hero-l-inner {
    display: inline-flex;
    align-items: center;
  }
  .hero-it {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    font-size: 1.1em;
  }
  .hero-l1 { padding-left: 2%; }
  .hero-l2 { padding-left: 40%; }
  .hero-l3 { padding-left: 0; }
  .hero-l4 { padding-left: 33%; }

  .hero-pill {
    margin-left: 1.3em;
    padding: 0.85rem 1.7rem;
    border: 1.5px solid var(--hero-pill-line);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
    color: var(--hero-fg);
    text-decoration: none;
    transition: background-color 0.25s, color 0.25s, border-color 0.25s;
  }
  .hero-pill:hover {
    background: var(--hero-fg);
    color: var(--hero-on-fg);
    border-color: var(--hero-fg);
  }

  /* The giant name, filled with light that drifts toward the cursor. */
  .hero-giant {
    position: absolute;
    left: -1%;
    right: -1%;
    bottom: -6%;
    margin: 0;
    z-index: 1;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.8;
    font-size: 29vw;
    white-space: nowrap;
    text-align: center;
    background: var(--hero-giant-fill);
    background-size: 130% 130%;
    background-position: 50% 50%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transform-origin: 50% 100%;
  }

  /* The orb replaces the dot of the "i". --i-x (set by hero.ts) is where the "i" starts, in em.
     Vertical positions come from Clash Display Semibold's metrics: with line-height 0.8 the baseline
     sits 0.72em below the top of the box, and the i's square dot spans 0.552–0.67em above it
     (0.04–0.19em across). A patch in the page colour hides the square dot; the round orb sits on top.
     Until the script has measured (or without JS), neither shows and the "i" keeps its own dot. */
  .hero-dot-cover,
  .hero-orb {
    position: absolute;
    visibility: hidden;
  }
  .hero-giant:global(.has-orb) .hero-dot-cover,
  .hero-giant:global(.has-orb) .hero-orb {
    visibility: visible;
  }
  .hero-dot-cover {
    left: calc(var(--i-x, 0) * 1em + 0.03em);
    top: 0.04em;
    width: 0.17em;
    height: 0.14em;
    background: var(--hero-bg);
  }
  .hero-orb {
    left: calc(var(--i-x, 0) * 1em + 0.045em);
    top: 0.039em;
    width: 0.14em;
    height: 0.14em;
  }
  .hero-orb-ball {
    position: absolute;
    inset: 0;
  }

  .hero-m {
    display: none;
  }

  /* Phones: the orb sits up top with ripples spreading from it; the headline is centred beneath. */
  @media (max-width: 767px) {
    .wave-lines { display: none; }
    .hero-giant { display: none; }
    .hero-headline {
      top: 46%;
      width: 90vw;
      font-size: 10.5vw;
      text-align: center;
    }
    .hero-l { padding-left: 0.12em; }
    .hero-l-inner { justify-content: center; }
    .hero-l2, .hero-l4 { padding-left: 0.12em; }
    .hero-it { color: color-mix(in srgb, var(--hero-fg) 80%, var(--color-accent)); }
    .hero-l4 .hero-l-inner { flex-direction: column; align-items: center; }
    .hero-pill {
      margin: 1.8rem 0 0;
      padding: 0.9rem 2rem;
      border: 0;
      background: var(--color-accent);
      color: var(--color-on-accent);
      font-size: 1.05rem;
    }
    .hero-m {
      display: grid;
      place-items: center;
      position: absolute;
      left: 50%;
      top: 13%;
      width: min(62vw, 16rem);
      aspect-ratio: 1;
      margin-left: max(-31vw, -8rem);
      z-index: 1;
      pointer-events: none;
    }
    /* The orb's shading is sized in em (0.16em wide elsewhere), so its font-size sets its proportions. */
    .hero-m-orb {
      width: 46%;
      height: 46%;
      font-size: min(178vw, 46rem);
    }
    .hero-m-ring {
      position: absolute;
      inset: 27%;
      border-radius: 50%;
      border: 1px solid color-mix(in srgb, var(--color-accent) 70%, transparent);
      animation: hero-ripple 3.6s ease-out infinite;
    }
    .hero-m-ring:nth-child(2) { animation-delay: 1.2s; }
    .hero-m-ring:nth-child(3) { animation-delay: 2.4s; }
  }
  @keyframes hero-ripple {
    from { transform: scale(1); opacity: 0.8; }
    to { transform: scale(2.3); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-m-ring { animation: none; opacity: 0; }
  }
</style>
