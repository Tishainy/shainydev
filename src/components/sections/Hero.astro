---
import { site } from '../../data/content';
// Stub. The scrubbed set piece replaces this in ticket 05.
---

<section id="hero" class="mx-auto flex min-h-svh max-w-6xl flex-col justify-center gap-6 px-4 pt-20 sm:px-6">
  <p class="text-muted">{site.hero.greeting}</p>
  <h1 class="text-5xl font-bold tracking-tight sm:text-7xl">{site.brand}</h1>
  <p class="max-w-2xl text-2xl">{site.hero.offer}</p>
  <p class="max-w-xl text-lg text-muted">{site.hero.sub}</p>
  <a href="#contact" class="self-start rounded-full bg-accent px-6 py-3 font-medium text-on-accent">{site.hero.cta}</a>
</section>
