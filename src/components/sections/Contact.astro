---
import { site } from '../../data/content';
// Contact (ticket 12): the closing section. Left: the headline and the personal touch that used to
// be the About section (portrait or monogram, "Hi, I'm Shainy", a short bio). Right: the form,
// which posts to /api/contact (sent on by email through Resend). Script: src/scripts/contact.ts.

const { headingLines, replyNote, lead, form, altHeading, emailLabel, linkedinLabel } = site.contact;
const { intro, bio, languagesLabel, languages, photo, photoAlt } = site.about;
---

<section id="contact" class="contact">
  <div class="contact-left">
    <h2 class="contact-heading">
      {headingLines.map((line, i) => (
        <span class:list={['contact-h-line', { 'contact-h-it': i > 0 }]} data-reveal>{line}</span>
      ))}
    </h2>

    <div class="contact-me" data-reveal>
      <span class="contact-photo">
        {photo ? (
          <picture>
            <source srcset={photo.replace(/\.jpe?g$/, '.webp')} type="image/webp" />
            <img src={photo} alt={photoAlt} width="480" height="480" loading="lazy" decoding="async" />
          </picture>
        ) : (
          <span class="contact-mono" aria-hidden="true">S</span>
        )}
      </span>
      <div class="contact-me-copy">
        <p class="contact-hi" data-about-intro>{intro}</p>
        <p class="contact-reply">{replyNote}</p>
      </div>
    </div>

    <div class="contact-bio" data-reveal>
      {bio.slice(0, 2).map((paragraph) => <p>{paragraph}</p>)}
      <p class="contact-langs">
        <span class="contact-langs-label">{languagesLabel}</span>
        {languages.map((language, i) => (
          <span>{language}{i < languages.length - 1 && <span class="contact-sep" aria-hidden="true"> / </span>}</span>
        ))}
      </p>
    </div>
  </div>

  <div class="contact-right">
    <p class="contact-lead" data-reveal>{lead}</p>

    <form class="contact-form" action="/api/contact" method="post" novalidate data-contact-form data-reveal>
      <div class="field">
        <label for="contact-name">{form.nameLabel}</label>
        <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="120" />
      </div>
      <div class="field">
        <label for="contact-email">{form.emailLabel}</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="200" />
      </div>


      <div class="field">
        <label for="contact-message">{form.messageLabel}</label>
        <textarea id="contact-message" name="message" rows="4" required maxlength="5000" placeholder={form.messagePlaceholder}></textarea>
      </div>

      <!-- Spam trap: hidden from people, irresistible to bots. -->
      <div class="trap" aria-hidden="true">
        <label for="contact-website">Website</label>
        <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="started" value="" data-contact-started />

      <div class="contact-actions">
        <button type="submit" class="contact-submit" data-contact-submit data-label={form.submit} data-sending={form.sending}>
          {form.submit}
        </button>
        <p class="contact-status" role="status" aria-live="polite" data-contact-status
          data-success={form.success} data-error={form.error} data-missing={form.missing} data-bad-email={form.badEmail} data-not-connected={form.notConnected}></p>
      </div>
    </form>

    <div class="contact-alt" data-reveal>
      <p class="contact-alt-heading">{altHeading}</p>
      <p class="contact-alt-links">
        <a href={`mailto:${site.links.email}`}>{emailLabel}: {site.links.email}</a>
        <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer">{linkedinLabel}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .contact {
    max-width: 90rem;
    margin: 0 auto;
    padding: 18svh 6vw 14svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 5rem 7vw;
    align-items: start;
  }

  /* ---------- Left: headline and the personal touch ---------- */
  .contact-left {
    display: grid;
    gap: 3rem;
    align-content: start;
  }
  .contact-heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.9;
    font-size: clamp(3.5rem, 7.5vw, 7.5rem);
  }
  .contact-h-line {
    display: block;
    white-space: nowrap;
  }
  .contact-h-it {
    padding-left: 0.9em;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
    font-size: 1.08em;
  }

  .contact-me {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }
  .contact-photo {
    flex: none;
    display: grid;
    place-items: center;
    width: 7.5rem;
    height: 7.5rem;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-fg) 3%, transparent);
  }
  .contact-photo picture {
    display: contents;
  }
  .contact-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .contact-mono {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 4.2rem;
    line-height: 1;
    padding: 0 0.1em 0.08em 0;
    background: var(--light-fill);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .contact-me-copy {
    display: grid;
    gap: 0.3rem;
  }
  .contact-hi {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(2rem, 3.2vw, 3rem);
    line-height: 1.12;
  }
  .contact-reply {
    margin: 0;
    color: var(--color-muted);
  }
  .contact-bio {
    display: grid;
    gap: 0.9rem;
    max-width: 34rem;
  }
  .contact-bio p {
    margin: 0;
    font-size: clamp(1.02rem, 1.2vw, 1.15rem);
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-fg) 82%, transparent);
  }
  .contact-bio .contact-langs {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--color-fg);
  }
  .contact-langs-label {
    margin-right: 0.7rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--color-muted);
  }
  .contact-sep {
    color: var(--color-accent);
  }

  /* ---------- Right: the form ---------- */
  .contact-right {
    display: grid;
    gap: 2.5rem;
    align-content: start;
    padding-top: 1rem;
  }
  .contact-lead {
    margin: 0;
    max-width: 30rem;
    font-size: clamp(1.15rem, 1.5vw, 1.45rem);
    line-height: 1.45;
  }
  .contact-form {
    display: grid;
    gap: 1.8rem;
  }
  .field {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .field label,
  .field legend {
    padding: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-muted);
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 0.5rem 0 0.7rem;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    border-radius: 0;
    background: transparent;
    color: var(--color-fg);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.2rem, 1.6vw, 1.5rem);
    letter-spacing: -0.01em;
    transition: border-color 0.25s;
  }
  .field textarea {
    resize: vertical;
    min-height: 7rem;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.1rem;
    line-height: 1.5;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--color-accent);
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    box-shadow: 0 2px 0 0 var(--color-accent);
  }
  .field textarea::placeholder {
    color: color-mix(in srgb, var(--color-muted) 70%, transparent);
  }


  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .contact-submit {
    padding: 0.95rem 2rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.1rem;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.25s;
  }
  .contact-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }
  .contact-submit[disabled] {
    opacity: 0.6;
    cursor: progress;
    transform: none;
  }
  .contact-status {
    margin: 0;
    flex: 1 1 16rem;
    font-size: 1rem;
    line-height: 1.45;
  }
  .contact-status.is-ok {
    color: var(--color-accent);
  }
  .contact-status.is-error {
    color: #ff8a8a;
  }
  :global(:root[data-theme='light']) .contact-status.is-error {
    color: #b42318;
  }

  .contact-alt {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .contact-alt-heading {
    margin: 0 0 0.6rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--color-muted);
  }
  .contact-alt-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
    margin: 0;
  }
  .contact-alt-links a {
    color: var(--color-fg);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.3em;
  }

  @media (max-width: 767px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      padding: 12svh 5vw 10svh;
      gap: 4rem;
    }
    .contact-h-line {
      white-space: normal;
    }
  }
</style>
