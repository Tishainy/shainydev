---
import { site } from '../../data/content';
// Stub. Built out in ticket 11.
---

<section id="process" class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
  <h2 class="text-3xl font-bold" data-reveal>{site.process.heading}</h2>
  <ol class="mt-10 grid gap-6 sm:grid-cols-2 md:grid-cols-4">
    {site.process.steps.map((step) => (
      <li class="border-t border-line pt-4 text-xl font-bold" data-reveal>{step}</li>
    ))}
  </ol>
  <ul class="mt-12 flex flex-wrap gap-x-6 gap-y-2 text-muted" data-reveal>
    {site.process.formats.map((format) => <li>{format}</li>)}
  </ul>
  <p class="mt-4" data-reveal>{site.process.quoteNote}</p>
</section>
