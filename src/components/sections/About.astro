---
import { site } from '../../data/content';
// About (ticket 11). "Hi, I'm Shainy." large in the serif italic, the bio and languages, beside a
// portrait. Until the photo exists (ticket 04), the frame shows a lit "S" monogram.

const { heading, intro, bio, languagesLabel, languages, photo, photoAlt } = site.about;
---

<section id="about" class="about" data-about>
  <div class="about-photo" data-reveal>
    {photo ? (
      <img src={photo} alt={photoAlt} loading="lazy" decoding="async" />
    ) : (
      <span class="about-mono" aria-hidden="true">S</span>
    )}
  </div>

  <div class="about-copy">
    <h2 class="about-heading" data-reveal>{heading}</h2>
    <p class="about-intro" data-about-intro>{intro}</p>
    <div class="about-bio">
      {bio.map((paragraph) => <p data-reveal>{paragraph}</p>)}
    </div>
    <p class="about-langs" data-reveal>
      <span class="about-langs-label">{languagesLabel}</span>
      {languages.map((language, i) => (
        <span>{language}{i < languages.length - 1 && <span class="about-sep" aria-hidden="true"> / </span>}</span>
      ))}
    </p>
  </div>
</section>

<style>
  .about {
    max-width: 90rem;
    margin: 0 auto;
    padding: 14svh 6vw 18svh;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 3rem 7vw;
    align-items: center;
  }

  /* ---------- Portrait (or its lit monogram) ---------- */
  .about-photo {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 100%;
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-fg) 3%, transparent);
    display: grid;
    place-items: center;
  }
  .about-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about-mono {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(10rem, 22vw, 20rem);
    line-height: 1;
    padding: 0 0.12em 0.1em 0;
    background: var(--light-fill);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ---------- Words ---------- */
  .about-copy {
    display: grid;
    gap: 1.6rem;
    align-content: center;
  }
  .about-heading {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-accent);
  }
  .about-intro {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(3.2rem, 7.5vw, 7rem);
    /* Tall enough that the words' rise-in masks don't clip the descenders (the y in Shainy). */
    line-height: 1.12;
    letter-spacing: -0.015em;
    padding-right: 0.1em;
  }
  .about-bio {
    display: grid;
    gap: 1rem;
    max-width: 36rem;
  }
  .about-bio p {
    margin: 0;
    font-size: clamp(1.1rem, 1.4vw, 1.35rem);
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-fg) 85%, transparent);
  }
  .about-langs {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.05rem, 1.35vw, 1.3rem);
    letter-spacing: -0.01em;
  }
  .about-langs-label {
    margin-right: 0.8rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--color-muted);
  }
  .about-sep {
    color: var(--color-accent);
  }

  @media (max-width: 767px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      padding: 10svh 5vw 12svh;
    }
    .about-photo {
      max-width: 22rem;
    }
  }
</style>
