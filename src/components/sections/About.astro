---
import { site } from '../../data/content';
// Stub. Built out in ticket 11; the portrait arrives with ticket 04.
---

<section id="about" class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
  <h2 class="text-3xl" data-reveal>{site.about.heading}</h2>
  <div class="mt-10 max-w-prose space-y-4" data-reveal>
    <p class="text-3xl">{site.about.intro}</p>
    {site.about.bio.map((paragraph) => <p class="text-muted">{paragraph}</p>)}
    <p>
      {site.about.languagesLabel}: {site.about.languages.join(', ')}.
    </p>
  </div>
</section>
