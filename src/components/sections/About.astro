---
import { site } from '../../data/content';
// Stub. Built out in ticket 11.
---

<section id="about" class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
  <h2 class="text-3xl font-bold" data-reveal>{site.about.heading}</h2>
  <div class="mt-10 max-w-prose space-y-4" data-reveal>
    <p class="text-2xl">{site.about.intro}</p>
    <p class="text-muted">{site.about.bio}</p>
    <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
      {site.about.languages.map((language) => <li>{language}</li>)}
    </ul>
  </div>
</section>
