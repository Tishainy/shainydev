---
import { site } from '../../data/content';
// Services (ticket 06): "grow & shrink". One service word at a time is huge, lit with the cobalt
// light and finished with the glass orb; the other two sit small in a mini index in the corner.
// Scrolling grows the next word out of the index while the current one shrinks into it.
// On desktop with motion this is a pinned scene (src/scripts/services.ts). Elsewhere, and without
// JS, the simple stack below it is shown instead.

const { heading, includesLabel, items } = site.services;
---

<section id="services" class="svc" data-services>
  <!-- ================= The scene (desktop, with motion) ================= -->
  <div class="svc-scene" data-svc-scene>
    <h2 class="svc-kicker">{heading}</h2>

    {items.map((item) => (
      <p class="svc-w" aria-hidden="true" data-svc-w>
        <span class="svc-w-solid" data-svc-solid>{item.name}</span>
        <span class="svc-w-fill" data-svc-fill>{item.name}</span>
      </p>
    ))}
    <span class="svc-orb glass-orb" aria-hidden="true" data-svc-orb></span>

    <div class="svc-slot svc-slot-sum">
      {items.map((item) => (
        <h3 class="svc-sum" data-svc-sum>
          <span class="svc-sr">{item.name}: </span>
          {item.summaryLines.map((line, lineIndex) => (
            <span class:list={['svc-sum-line', { 'svc-sum-indent': lineIndex > 0 }]} data-svc-sum-line>
              {line}
            </span>
          ))}
        </h3>
      ))}
    </div>

    <div class="svc-slot svc-slot-desc">
      {items.map((item) => <p class="svc-desc" data-svc-desc>{item.description}</p>)}
    </div>

    <div class="svc-slot svc-slot-inc">
      {items.map((item) => (
        <div class="svc-inc" data-svc-inc>
          <p class="svc-inc-label">{includesLabel}</p>
          <ul class="svc-list">
            {item.list.map((entry) => <li>{entry}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <!-- ================= The stack (phones, reduced motion, no JS) ================= -->
  <div class="svc-stack">
    <h2 class="svc-kicker">{heading}</h2>
    {items.map((item) => (
      <article class="svc-card">
        <p class="svc-stack-word" aria-hidden="true">{item.name}<span class="svc-stack-orb glass-orb"></span></p>
        <h3 class="svc-sum">
          <span class="svc-sr">{item.name}: </span>
          {item.summaryLines.map((line, lineIndex) => (
            <span class:list={['svc-sum-line', { 'svc-sum-indent': lineIndex > 0 }]}>{line}</span>
          ))}
        </h3>
        <p class="svc-desc">{item.description}</p>
        <div class="svc-inc">
          <p class="svc-inc-label">{includesLabel}</p>
          <ul class="svc-list">
            {item.list.map((entry) => <li>{entry}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .svc {
    position: relative;
    --word-size: 14.5vw;
  }

  /* ---------- Shared type ---------- */
  .svc-kicker {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.4rem, 2.1vw, 2rem);
    color: var(--color-muted);
  }
  .svc-sum {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.6rem, 4.6vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .svc-sum-line {
    display: block;
    white-space: nowrap;
  }
  .svc-sum-indent {
    padding-left: 1.1em;
  }
  .svc-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .svc-desc {
    margin: 0;
    font-size: clamp(1.1rem, 1.5vw, 1.5rem);
    line-height: 1.5;
  }
  .svc-inc-label {
    margin: 0 0 0.4rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-accent);
  }
  .svc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .svc-list li {
    padding: 0.5rem 0;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.1rem, 1.5vw, 1.5rem);
    letter-spacing: -0.01em;
  }

  /* ================= The scene ================= */
  .svc-scene {
    display: none;
  }
  .svc:global(.is-staged) .svc-scene {
    display: block;
    position: relative;
    height: 100svh;
    overflow: clip;
  }
  .svc:global(.is-staged) .svc-stack {
    display: none;
  }

  .svc-scene .svc-kicker {
    position: absolute;
    left: 5vw;
    top: 10svh;
  }

  /* Every word lives at the big spot; the script scales and moves the inactive ones into the index. */
  .svc-w {
    position: absolute;
    left: 4.5vw;
    top: 22svh;
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.84;
    font-size: var(--word-size);
    transform-origin: 0 0;
    will-change: transform;
  }
  .svc-w-solid {
    color: var(--color-fg);
  }
  .svc-w-fill {
    position: absolute;
    left: 0;
    top: 0;
    padding-right: 0.06em;
    background: var(--light-fill);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .svc-orb {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--word-size) * 0.16);
    height: calc(var(--word-size) * 0.16);
    z-index: 2;
    will-change: transform;
  }

  /* Each service's details stack in the same cell and trade places. */
  .svc-slot {
    position: absolute;
    display: grid;
    align-items: start;
  }
  .svc-slot > * {
    grid-area: 1 / 1;
  }
  .svc-slot-sum {
    left: 8vw;
    top: 54svh;
  }
  .svc-slot-desc {
    left: 44vw;
    top: 57svh;
    width: 25vw;
  }
  .svc-slot-inc {
    right: 5vw;
    top: 57svh;
    width: 22vw;
  }

  /* ================= The stack ================= */
  .svc-stack {
    max-width: 90rem;
    margin: 0 auto;
    padding: 6rem 6vw 2rem;
    display: grid;
    gap: 2.5rem;
  }
  .svc-card {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 3rem;
  }
  .svc-stack-word {
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.85;
    font-size: min(18vw, 10rem);
    background: var(--light-fill);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .svc-stack-orb {
    display: inline-block;
    width: 0.16em;
    height: 0.16em;
    margin-left: 0.05em;
  }
  .svc-stack .svc-desc {
    max-width: 34rem;
    color: color-mix(in srgb, var(--color-fg) 82%, transparent);
  }
  .svc-stack .svc-inc {
    max-width: 26rem;
  }
</style>
