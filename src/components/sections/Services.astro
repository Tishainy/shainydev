---
import { site } from '../../data/content';
// Stub. The pinned services set piece replaces this in ticket 06.
---

<section id="services" class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
  <h2 class="text-3xl font-bold" data-reveal>{site.services.heading}</h2>
  <div class="mt-10 grid gap-8 md:grid-cols-3">
    {site.services.items.map((item) => (
      <article class="min-w-0" data-reveal>
        <h3 class="text-2xl font-bold text-accent">{item.name}</h3>
        <p class="mt-1 text-muted">{item.summary}</p>
        <ul class="mt-4 space-y-1">
          {item.list.map((entry) => <li>{entry}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>
