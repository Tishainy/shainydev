---
import { site } from '../../data/content';
// Services (ticket 06, with the showcases from tickets 07–09): a film strip. Scrolling down slides
// the services sideways, one full-screen frame each: the lit word across the top, the details around a live demo that the scroll plays.
// Phones get an index instead: the three words as a list, each opening as you scroll to it.
// Animation lives in src/scripts/services.ts. Reduced motion and no-JS get the frames stacked,
// with each demo shown complete.

const { heading, includesLabel, items } = site.services;
const { build, automate, ai } = site.interludes;
---

<section id="services" class="svc" data-services>
  <h2 class="svc-heading">{heading}</h2>
  <div class="svc-viewport">
    <div class="svc-strip" data-svc-strip>
      {items.map((item, index) => (
        <article class="svc-frame" data-svc-frame={index}>
          <p class="svc-word" aria-hidden="true" data-svc-word>
            {item.name}<span class="svc-word-fill" data-svc-fill>{item.name}</span><span class="svc-word-orb glass-orb" data-svc-orb></span>
          </p>

          <!-- Layout-neutral everywhere except the phone index, where it opens as you reach it. -->
          <div class="svc-body" data-svc-body>
          <h3 class="svc-sum" data-svc-part>
            <span class="svc-sr">{item.name}: </span>
            {item.summaryLines.map((line, lineIndex) => (
              <span class:list={['svc-sum-line', { 'svc-sum-indent': lineIndex > 0 }]}>{line}</span>
            ))}
          </h3>

          <p class="svc-desc" data-svc-part>{item.description}</p>

          <div class="svc-inc" data-svc-part>
            <p class="svc-inc-label">{includesLabel}</p>
            <ul class="svc-list">
              {item.list.map((entry) => <li>{entry}</li>)}
            </ul>
          </div>

          <!-- ---------- The live demo for this service ---------- -->
          <figure class="svc-demo" data-svc-demo={item.interlude}>
            {item.interlude === 'build' && (
              <div class="mock" data-demo-build>
                <div class="mock-nav">
                  <span class="mock-logo" data-wire>{build.demoBusiness}</span>
                  <span class="mock-links"><span data-wire>Services</span><span data-wire>Prices</span><span data-wire>Book</span></span>
                </div>
                <div class="mock-hero">
                  <p class="mock-h" data-wire>{build.demoHeadline}</p>
                  <span class="mock-btn" data-wire data-wire-button>{build.demoButton}</span>
                </div>
                <div class="mock-img" data-wire-img><span class="mock-img-fill" data-wire-fill></span></div>
                <div class="mock-row">
                  <span data-wire-card><span class="mock-card-fill" data-wire-fill></span></span>
                  <span data-wire-card><span class="mock-card-fill" data-wire-fill></span></span>
                  <span data-wire-card><span class="mock-card-fill" data-wire-fill></span></span>
                </div>
              </div>
            )}

            {item.interlude === 'automate' && (
              <div class="flow" data-demo-automate>
                <div class="flow-steps">
                  <span class="flow-track" aria-hidden="true" data-flow-track><span class="flow-track-fill" data-flow-fill></span></span>
                  <span class="flow-orb glass-orb" aria-hidden="true" data-flow-orb></span>
                  <ol class="flow-list">
                    {automate.steps.map((step) => (
                      <li class="flow-step" data-flow-step>
                        <span class="flow-dot" aria-hidden="true"></span>
                        <span class="flow-label">{step}</span>
                      </li>
                    ))}
                  </ol>
                </div>
                <div class="mail" data-flow-mail>
                  <p class="mail-from">{automate.email.from}</p>
                  <p class="mail-subject">{automate.email.subject}</p>
                  <p class="mail-body">{automate.email.greeting} {automate.email.body}</p>
                  <span class="mail-btn">{automate.email.button}</span>
                </div>
              </div>
            )}

            {item.interlude === 'ai' && (
              <div class="chat" data-demo-ai>
                <p class="chat-head"><span class="chat-avatar glass-orb" aria-hidden="true"></span>{ai.assistantName}</p>
                <p class="chat-bubble chat-them" data-chat-q>{ai.question}</p>
                <p class="chat-typing" aria-hidden="true" data-chat-typing><span></span><span></span><span></span></p>
                <p class="chat-bubble chat-bot" data-chat-a>{ai.answer}</p>
              </div>
            )}

            <figcaption class="svc-demo-caption">
              {site.interludes[item.interlude as keyof typeof site.interludes].caption}
            </figcaption>
          </figure>
          </div>
        </article>
      ))}
    </div>

    <div class="svc-hud" aria-hidden="true">
      <p class="svc-kicker">{heading}</p>
      <span class="svc-dots">
        {items.map((_, index) => <span class="svc-dot" data-svc-dot={index}></span>)}
      </span>
    </div>
  </div>
</section>

<style>
  .svc {
    position: relative;
    --word-size: clamp(3.5rem, 7.5vw, 7rem);
  }

  /* ================= Base: frames stacked (phones, reduced motion, no JS) ================= */
  .svc-viewport {
    position: relative;
  }
  .svc-strip {
    display: grid;
  }
  .svc-frame {
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding: 4rem 5vw 5rem;
  }
  .svc-hud {
    display: none;
  }
  .svc-body {
    display: contents;
  }
  .svc-word-orb,
  .svc-word-fill {
    display: none;
  }
  .svc-heading {
    margin: 0;
    padding: 6rem 5vw 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.6rem, 6vw, 2.2rem);
    color: var(--color-muted);
  }
  /* In the film strip the same words show in the bottom caption, so the heading is kept for screen readers only. */
  .svc:global(.is-strip) .svc-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }


  .svc-word {
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.9;
    font-size: var(--word-size);
    padding-right: 0.06em;
    justify-self: start;
    background: var(--light-fill);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .svc-sum {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.4rem, 4.3vw, 4.3rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .svc-sum-line {
    display: block;
    white-space: nowrap;
  }
  .svc-sum-indent {
    padding-left: 1.1em;
  }
  .svc-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .svc-desc {
    margin: 0;
    max-width: 30rem;
    font-size: clamp(1.1rem, 1.4vw, 1.4rem);
    line-height: 1.5;
  }
  .svc-inc-label {
    margin: 0 0 0.4rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-accent);
  }
  .svc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .svc-list li {
    padding: 0.5rem 0;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.05rem, 1.35vw, 1.35rem);
    letter-spacing: -0.01em;
  }

  /* ================= Film strip (desktop + motion, set by JS) ================= */
  .svc:global(.is-strip) .svc-viewport {
    height: 100svh;
    overflow: clip;
  }
  .svc:global(.is-strip) .svc-strip {
    display: flex;
    height: 100%;
    width: max-content;
    will-change: transform;
  }
  .svc:global(.is-strip) .svc-frame {
    display: block;
    flex: none;
    width: 100vw;
    height: 100%;
    padding: 0;
  }
  /* Title, subtitle and description down the left; the demo takes the middle; the list sits right. */
  .svc:global(.is-strip) .svc-word {
    position: absolute;
    left: 5vw;
    top: 19svh;
  }
  .svc:global(.is-strip) .svc-sum {
    position: absolute;
    left: 5vw;
    top: calc(19svh + var(--word-size) * 1.15);
  }
  .svc:global(.is-strip) .svc-desc {
    position: absolute;
    left: 5vw;
    top: 58svh;
    width: 27vw;
  }
  .svc:global(.is-strip) .svc-demo {
    position: absolute;
    left: 36vw;
    top: 17svh;
    width: 40vw;
    height: 68svh;
  }
  .svc:global(.is-strip) .svc-inc {
    position: absolute;
    right: 4vw;
    top: 22svh;
    width: 17vw;
  }
  .svc:global(.is-strip) .svc-hud {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    position: absolute;
    left: 5vw;
    bottom: 5svh;
    z-index: 3;
  }
  .svc-kicker {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.1rem, 1.5vw, 1.4rem);
    color: var(--color-muted);
  }
  .svc-dots {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }
  .svc-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    border: 1px solid var(--color-muted);
    transition: background 0.3s, border-color 0.3s, transform 0.3s;
  }
  .svc-dot.is-on {
    background: var(--color-accent);
    border-color: var(--color-accent);
    transform: scale(1.35);
  }

  /* ================= Demos ================= */
  .svc-demo {
    margin: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.8rem;
    min-height: 22rem;
  }
  .svc-demo-caption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.05rem, 1.3vw, 1.3rem);
    color: var(--color-muted);
  }

  /* --- Build: a small website mockup (wireframe until the scroll styles it) --- */
  .mock {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.9rem;
    padding: 1.1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--color-fg) 3%, transparent);
    overflow: hidden;
  }
  .mock-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
  }
  /* Wireframe cover bars (added by the script): grey blocks over each element until the scroll reveals it. */
  .mock [data-wire] {
    position: relative;
  }
  .mock :global(.wire-bar) {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 0.3rem;
    background: color-mix(in srgb, var(--color-fg) 14%, var(--color-bg));
  }
  .mock-logo {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
  }
  .mock-links {
    display: flex;
    gap: 0.8rem;
  }
  .mock-hero {
    display: grid;
    gap: 0.7rem;
    justify-items: start;
    padding-top: 0.6rem;
  }
  .mock-h {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.03em;
    font-size: clamp(1.4rem, 2.2vw, 2.1rem);
    line-height: 1;
  }
  .mock-btn {
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .mock-img,
  .mock-row > span {
    position: relative;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--color-fg) 10%, transparent);
    overflow: hidden;
  }
  .mock-img {
    min-height: 5rem;
  }
  .mock-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
  }
  .mock-row > span {
    height: 3.2rem;
  }
  .mock-img-fill,
  .mock-card-fill {
    position: absolute;
    inset: 0;
    background: var(--light-fill);
  }
  .mock-card-fill {
    opacity: 0.7;
  }

  /* --- Automate: a booking flowing through the steps --- */
  .flow {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1.5rem;
    align-items: center;
  }
  .flow-steps {
    position: relative;
    padding-left: 2.4rem;
  }
  .flow-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.4rem;
  }
  .flow-track {
    position: absolute;
    left: 0.55rem;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 2px;
    background: var(--color-line);
  }
  .flow-track-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(#709bff, #8ef0ff);
    transform-origin: 50% 0;
  }
  .flow-orb {
    position: absolute;
    left: 0.05rem;
    top: 0.1rem;
    width: 1.1rem;
    height: 1.1rem;
    font-size: 7rem;
    z-index: 1;
  }
  .flow-step {
    position: relative;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    letter-spacing: -0.01em;
  }
  .flow-dot {
    position: absolute;
    left: -2.15rem;
    top: 0.35rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-accent);
  }
  .mail {
    display: grid;
    gap: 0.45rem;
    padding: 1.1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--color-fg) 3%, transparent);
  }
  .mail p {
    margin: 0;
  }
  .mail-from {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .mail-subject {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }
  .mail-body {
    font-size: 0.9rem;
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-fg) 80%, transparent);
  }
  .mail-btn {
    justify-self: start;
    margin-top: 0.3rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  /* --- AI: a customer chat --- */
  .chat {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: 1.1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--color-fg) 3%, transparent);
  }
  .chat-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.4rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--color-line);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .chat-avatar {
    width: 1.5rem;
    height: 1.5rem;
    font-size: 9rem;
  }
  .chat-bubble {
    margin: 0;
    max-width: 80%;
    padding: 0.75rem 1rem;
    border-radius: 1.1rem;
    font-size: clamp(0.95rem, 1.15vw, 1.1rem);
    line-height: 1.4;
  }
  .chat-them {
    justify-self: end;
    border-bottom-right-radius: 0.3rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .chat-bot {
    justify-self: start;
    border-bottom-left-radius: 0.3rem;
    background: color-mix(in srgb, var(--color-fg) 9%, transparent);
  }
  .chat-typing {
    display: none;
    gap: 0.3rem;
    margin: 0;
    padding: 0.75rem 1rem;
    justify-self: start;
    border-radius: 1.1rem;
    background: color-mix(in srgb, var(--color-fg) 9%, transparent);
  }
  .chat-typing span {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-muted);
  }
  .svc:global(.is-strip) .chat-typing {
    display: flex;
  }

  /* ---------- Phones: the index plays like a film. The section holds in place while you scroll:
     Build opens, then closes as Automate opens, then AI; scrolling back up plays it in reverse.
     Everything is driven by one scroll timeline (services.ts), so nothing flickers. ---------- */
  @media (max-width: 767px) {
    .svc:global(.is-index) {
      height: 100svh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .svc:global(.is-index) .svc-heading {
      padding: 5rem 6vw 0.6rem;
      font-size: 1.5rem;
    }
    .svc:global(.is-index) .svc-strip {
      padding: 0 6vw;
    }
    .svc:global(.is-index) .svc-frame {
      display: block;
      padding: 0;
      border-top: 1px solid var(--color-line);
    }
    .svc:global(.is-index) .svc-frame:last-child {
      border-bottom: 1px solid var(--color-line);
    }
    .svc:global(.is-index) .svc-word {
      position: relative;
      display: flex;
      align-items: baseline;
      justify-self: stretch;
      padding: 0.5rem 0;
      font-size: 3.2rem;
      background: none;
      color: color-mix(in srgb, var(--color-fg) 28%, transparent);
    }
    /* The light sits exactly over the grey word; the timeline fades it in and out. */
    .svc:global(.is-index) .svc-word-fill {
      display: block;
      position: absolute;
      left: 0;
      top: 0.5rem;
      padding-right: 0.06em;
      background: var(--light-fill);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      opacity: 0;
    }
    .svc:global(.is-index) .svc-word-orb {
      display: inline-block;
      width: 0.16em;
      height: 0.16em;
      margin-left: 0.05em;
      transform: scale(0);
    }
    .svc:global(.is-index) .svc-body {
      display: grid;
      gap: 0.8rem;
      height: 0;
      overflow: hidden;
    }
    .svc:global(.is-index) .svc-body > :last-child {
      margin-bottom: 1.2rem;
    }
    .svc:global(.is-index) .svc-sum {
      font-size: 1.6rem;
    }
    .svc:global(.is-index) .svc-sum-line {
      display: inline;
    }
    .svc:global(.is-index) .svc-sum-indent {
      padding-left: 0.25em;
    }
    /* Kept lean on phones: one line of subtitle and the demo. */
    .svc:global(.is-index) .svc-desc,
    .svc:global(.is-index) .svc-inc,
    .svc:global(.is-index) .svc-demo-caption {
      display: none;
    }
    .svc:global(.is-index) .svc-demo {
      min-height: 0;
    }
    .svc:global(.is-index) .mock-img {
      min-height: 3.2rem;
    }
    .svc:global(.is-index) .mock-row > span {
      height: 2.2rem;
    }
    .svc:global(.is-index) .chat-typing {
      display: flex;
    }
    .flow {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 0.9rem;
    }
    .flow-steps {
      padding-left: 1.8rem;
    }
    .flow-list {
      gap: 1.6rem;
    }
    .flow-step {
      font-size: 0.9rem;
    }
    .flow-dot {
      left: -1.6rem;
    }
    .mail {
      padding: 0.8rem;
    }
    .mail-subject {
      font-size: 0.95rem;
    }
    .mail-body {
      font-size: 0.8rem;
    }
  }
</style>
