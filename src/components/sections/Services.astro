---
import { site } from '../../data/content';
// Services (ticket 06): "the type index". All three service words stacked full-width; the active
// one fills with cobalt light and takes the glass orb as its full stop, the others are outlines.
// The active service's details sit in the open space beside the shorter words.
// On desktop with motion this is a pinned scene (src/scripts/services.ts). Elsewhere, and without
// JS, the simple stack below it is shown instead.

const { heading, includesLabel, items } = site.services;
---

<section id="services" class="svc" data-services>
  <!-- ================= The index (desktop, with motion) ================= -->
  <div class="svc-index" data-svc-index>
    <h2 class="svc-kicker">{heading}</h2>

    <div class="svc-rows">
      {items.map((item, index) => (
        <div class="svc-row" data-svc-row={index}>
          <p class="svc-w" aria-hidden="true" data-svc-w>
            <span class="svc-w-outline">{item.name}</span>
            <span class="svc-w-fill" data-svc-fill>{item.name}</span>
          </p>

          {index === 0 && (
            <div class="svc-slot svc-slot-summary">
              {items.map((detail) => (
                <h3 class="svc-sum" data-svc-sum>
                  <span class="svc-sr">{detail.name}: </span>
                  {detail.summaryLines.map((line, lineIndex) => (
                    <span class:list={['svc-sum-line', { 'svc-sum-indent': lineIndex > 0 }]} data-svc-sum-line>
                      {line}
                    </span>
                  ))}
                </h3>
              ))}
            </div>
          )}

          {index === items.length - 1 && (
            <div class="svc-slot svc-slot-detail">
              {items.map((detail) => (
                <div class="svc-det" data-svc-det>
                  <p class="svc-desc">{detail.description}</p>
                  <div class="svc-inc">
                    <p class="svc-inc-label">{includesLabel}</p>
                    <ul class="svc-list">
                      {detail.list.map((entry) => <li>{entry}</li>)}
                    </ul>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>

    <span class="svc-orb glass-orb" aria-hidden="true" data-svc-orb></span>
  </div>

  <!-- ================= The stack (phones, reduced motion, no JS) ================= -->
  <div class="svc-stack">
    <h2 class="svc-kicker">{heading}</h2>
    {items.map((item) => (
      <article class="svc-card">
        <p class="svc-stack-word" aria-hidden="true">{item.name}<span class="svc-stack-orb glass-orb"></span></p>
        <h3 class="svc-sum">
          <span class="svc-sr">{item.name}: </span>
          {item.summaryLines.map((line, lineIndex) => (
            <span class:list={['svc-sum-line', { 'svc-sum-indent': lineIndex > 0 }]}>{line}</span>
          ))}
        </h3>
        <p class="svc-desc">{item.description}</p>
        <div class="svc-inc">
          <p class="svc-inc-label">{includesLabel}</p>
          <ul class="svc-list">
            {item.list.map((entry) => <li>{entry}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .svc {
    position: relative;
    --word-size: 16vw;
  }

  /* ---------- Shared type ---------- */
  .svc-kicker {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.4rem, 2.1vw, 2rem);
    color: var(--color-muted);
  }
  .svc-sum {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.4rem, 4vw, 4rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .svc-sum-line {
    display: block;
    white-space: nowrap;
  }
  .svc-sum-indent {
    padding-left: 1.1em;
  }
  .svc-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .svc-desc {
    margin: 0;
    font-size: clamp(1.1rem, 1.45vw, 1.45rem);
    line-height: 1.5;
  }
  .svc-inc-label {
    margin: 0 0 0.4rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-accent);
  }
  .svc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .svc-list li {
    padding: 0.45rem 0;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.05rem, 1.4vw, 1.4rem);
    letter-spacing: -0.01em;
  }

  /* ================= The index ================= */
  .svc-index {
    display: none;
  }
  .svc:global(.is-staged) .svc-index {
    display: block;
    position: relative;
    height: 100svh;
    overflow: clip;
  }
  .svc:global(.is-staged) .svc-stack {
    display: none;
  }

  .svc-index .svc-kicker {
    position: absolute;
    left: 5vw;
    top: 9svh;
  }
  .svc-rows {
    position: absolute;
    left: 4vw;
    right: 4vw;
    top: 17svh;
    display: grid;
  }
  .svc-row {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 4vw;
  }

  .svc-w {
    position: relative;
    flex: none;
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.84;
    font-size: var(--word-size);
  }
  .svc-w-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--color-fg) 32%, transparent);
  }
  /* The light, laid exactly over the outline; revealed by a left-to-right sweep. */
  .svc-w-fill {
    position: absolute;
    left: 0;
    top: 0;
    background: var(--light-fill);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    clip-path: inset(-10% 100% -10% 0);
    padding-right: 0.06em;
  }

  /* The slots beside the short words; each service's details stack in the same cell. */
  .svc-slot {
    flex: 1;
    min-width: 0;
    display: grid;
    align-items: end;
    padding-bottom: 1.2vw;
  }
  .svc-slot > * {
    grid-area: 1 / 1;
  }
  .svc-det {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 3vw;
    align-items: end;
  }

  .svc-orb {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--word-size) * 0.16);
    height: calc(var(--word-size) * 0.16);
    z-index: 2;
    will-change: transform;
  }

  /* ================= The stack ================= */
  .svc-stack {
    max-width: 90rem;
    margin: 0 auto;
    padding: 6rem 6vw 2rem;
    display: grid;
    gap: 2.5rem;
  }
  .svc-card {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 3rem;
  }
  .svc-stack-word {
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.85;
    font-size: min(18vw, 10rem);
    background: var(--light-fill);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .svc-stack-orb {
    display: inline-block;
    width: 0.16em;
    height: 0.16em;
    margin-left: 0.05em;
  }
  .svc-stack .svc-desc {
    max-width: 34rem;
    color: color-mix(in srgb, var(--color-fg) 82%, transparent);
  }
  .svc-stack .svc-inc {
    max-width: 26rem;
  }
</style>
