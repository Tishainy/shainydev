---
// Ticket 05, round 5: sketch I plus one small visual detail.
// Hidden (noindex), not linked. Open one alone with /hero-lab/#k or #l.
import '../styles/global.css';
import { Font } from 'astro:assets';

const nav = ['Services', 'Work', 'Process', 'About'];
const variants = [
  { id: 'k', name: 'K. Glass orb as the dot of the i', fill: 'fill-light', italics: 'it-solid', detail: 'orb' },
  { id: 'l', name: 'L. Glass lens over the name', fill: 'fill-light', italics: 'it-solid', detail: 'lens' },
];
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Hero lab — ShainyDev</title>
    <Font cssVariable="--font-clash" preload />
    <Font cssVariable="--font-hanken" preload />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" />
  </head>
  <body>
    {variants.map((variant) => (
      <section class="sketch" id={variant.id}>
        <p class="tag">{variant.name}</p>

        <header class="top">
          <span class="mark">ShainyDev</span>
          <nav class="top-nav">
            {nav.map((item) => <a href="#">{item}</a>)}
            <a href="#">Let's talk ↗</a>
          </nav>
        </header>

        <h1 class={`headline ${variant.italics}`}>
          <span class="l l1">Websites, apps</span>
          <span class="l l2 it">&amp; automations</span>
          <span class="l l3">that do the work</span>
          <span class="l l4"><span class="it">for you.</span><a class="pill" href="#">Let's talk</a></span>
        </h1>

        {variant.detail === 'orb' ? (
          <p class={`giant ${variant.fill}`} aria-hidden="true">Sha<span class="i-wrap">ı<span class="orb"></span></span>ny</p>
        ) : (
          <>
            <p class={`giant ${variant.fill}`} aria-hidden="true">Shainy</p>
            <div class="lens" aria-hidden="true">
              <div class="lens-stage"><p class={`giant ${variant.fill}`}>Shainy</p></div>
            </div>
          </>
        )}
      </section>
    ))}

    <script is:inline>
      const only = location.hash.slice(1);
      if (['k', 'l'].includes(only)) {
        document.querySelectorAll('.sketch').forEach((el) => { if (el.id !== only) el.hidden = true; });
      }

      // Lens: a magnified copy of the section behind a round window.
      const MAGNIFY = 1.35;
      function placeLenses() {
        document.querySelectorAll('.lens').forEach((lens) => {
          const section = lens.closest('.sketch');
          const stage = lens.querySelector('.lens-stage');
          const r = lens.offsetWidth / 2;
          stage.style.width = section.clientWidth + 'px';
          stage.style.height = section.clientHeight + 'px';
          stage.style.left = -lens.offsetLeft + 'px';
          stage.style.top = -lens.offsetTop + 'px';
          stage.style.transformOrigin = `${lens.offsetLeft + r}px ${lens.offsetTop + r}px`;
          stage.style.transform = `scale(${MAGNIFY})`;
        });
      }
      placeLenses();
      addEventListener('resize', placeLenses);
      document.fonts?.ready.then(placeLenses);
    </script>

    <style is:global>
      :root {
        --serif: 'Instrument Serif', Georgia, serif;
        --ink: #040a24;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--ink); color: #f3f6ff; font-family: var(--font-hanken); }
      a { color: inherit; text-decoration: none; }

      .sketch { position: relative; height: 100svh; min-height: 38rem; overflow: clip; }
      .sketch + .sketch { border-top: 1px solid rgb(255 255 255 / 0.15); }

      .tag {
        position: absolute; right: 1rem; bottom: 1rem; z-index: 9; margin: 0;
        font-size: 0.8rem; padding: 0.3rem 0.6rem; border-radius: 0.4rem; background: rgb(255 255 255 / 0.12);
      }

      .top {
        position: absolute; top: 0; left: 0; right: 0; z-index: 2;
        display: flex; align-items: center; gap: 2rem; padding: 1.6rem 6%;
      }
      .mark { font-family: var(--font-clash); font-weight: 600; font-size: 1.35rem; letter-spacing: -0.02em; }
      .top-nav { flex: 1; display: flex; justify-content: flex-end; gap: clamp(1.5rem, 4vw, 3.5rem); font-weight: 500; opacity: 0.9; }

      /* A's placement: a centred block, each line pushed to its own spot. */
      .headline {
        position: absolute; left: 50%; top: 15%; translate: -50% 0; margin: 0; z-index: 2;
        width: min(64rem, 90vw);
        font-family: var(--font-clash); font-weight: 500; letter-spacing: -0.035em; line-height: 0.95;
        font-size: clamp(2.8rem, 6.3vw, 6.2rem);
      }
      .l { display: block; white-space: nowrap; }
      .it { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.01em; }
      .l1 { padding-left: 2%; }
      .l2 { padding-left: 40%; font-size: 1.1em; }
      .l3 { padding-left: 0; }
      .l4 { padding-left: 33%; display: flex; align-items: center; gap: 0.4em; font-size: 1.1em; }

      .it-solid .it { color: #8fb0ff; }
      /* The italic words carry the same light as the giant name. */
      .it-lit .it {
        background:
          radial-gradient(60% 120% at 20% 30%, #dbe6ff 0%, #7aa2ff 40%, transparent 80%),
          radial-gradient(50% 120% at 85% 70%, #8ef0ff 0%, #3a8bff 45%, transparent 85%),
          linear-gradient(90deg, #5b84ff, #8a6bff);
        -webkit-background-clip: text; background-clip: text; color: transparent;
        padding: 0 0.08em 0.18em 0;
        margin-bottom: -0.18em;
        display: inline-block;
      }

      .pill {
        display: inline-flex; align-items: center;
        font-family: var(--font-hanken); font-size: 1.1rem; letter-spacing: 0; font-weight: 600; font-style: normal;
        padding: 0.85rem 1.7rem; border-radius: 999px; border: 1.5px solid rgb(243 246 255 / 0.6);
      }

      /* The giant name carries all the colour. */
      .giant {
        position: absolute; left: -1%; right: -1%; bottom: -6%; margin: 0;
        font-family: var(--font-clash); font-weight: 600; letter-spacing: -0.055em; line-height: 0.8;
        font-size: 29vw; white-space: nowrap; text-align: center;
        -webkit-background-clip: text; background-clip: text; color: transparent;
      }

      /* The light every fill sits on: cobalt with a cyan and a violet glow. */
      .giant {
        --glow:
          radial-gradient(28% 70% at 16% 35%, #dbe6ff 0%, #7aa2ff 28%, transparent 70%),
          radial-gradient(24% 70% at 78% 55%, #8ef0ff 0%, #3a8bff 35%, transparent 72%),
          radial-gradient(30% 60% at 48% 90%, #8a6bff 0%, transparent 70%),
          linear-gradient(90deg, #1d3fd6, #2f5bff 50%, #1a36c4);
      }

      /* F. Vertical reeds, as in sketch C. */
      .fill-reeds {
        background:
          repeating-linear-gradient(90deg, rgb(255 255 255 / 0.22) 0 2px, rgb(255 255 255 / 0.04) 2px 1.2vw, rgb(0 0 40 / 0.35) 1.9vw 2.6vw),
          var(--glow);
        -webkit-background-clip: text; background-clip: text;
      }

      /* G. Square glass blocks. */
      .fill-blocks {
        background:
          linear-gradient(90deg, rgb(2 6 30 / 0.6) 0 3px, transparent 3px) 0 0 / 4.2vw 4.2vw,
          linear-gradient(0deg, rgb(2 6 30 / 0.6) 0 3px, transparent 3px) 0 0 / 4.2vw 4.2vw,
          radial-gradient(circle at 30% 26%, rgb(255 255 255 / 0.3), transparent 34%) 0 0 / 4.2vw 4.2vw,
          radial-gradient(farthest-corner, transparent 50%, rgb(0 6 40 / 0.4)) 0 0 / 4.2vw 4.2vw,
          var(--glow);
        -webkit-background-clip: text; background-clip: text;
      }

      /* H. Just the light: no texture. */
      .fill-light {
        background: var(--glow);
        -webkit-background-clip: text; background-clip: text;
      }

      /* K. The dot of the i becomes a small glowing glass sphere. */
      .i-wrap { position: relative; }
      .orb {
        position: absolute; left: 50%; top: 0.15em; translate: -50% 0;
        width: 0.145em; height: 0.145em; border-radius: 50%;
        background:
          radial-gradient(circle at 34% 28%, #ffffff 0 6%, rgb(255 255 255 / 0.6) 12%, transparent 30%),
          radial-gradient(circle at 50% 55%, #8ef0ff 0%, #709bff 38%, #2346e0 72%, #0d1f8a 100%);
        box-shadow:
          inset -0.012em -0.016em 0.03em rgb(0 0 40 / 0.55),
          inset 0.01em 0.01em 0.02em rgb(255 255 255 / 0.5),
          0 0 0.08em rgb(142 176 255 / 0.55);
      }

      /* L. A round glass lens resting on the name. */
      .lens {
        position: absolute; left: 37%; top: 71%; z-index: 3;
        width: clamp(9rem, 17vw, 17rem); aspect-ratio: 1; border-radius: 50%;
        overflow: hidden; background: var(--ink);
        border: 1px solid rgb(255 255 255 / 0.35);
        box-shadow:
          inset 0.6rem 0.8rem 1.6rem rgb(255 255 255 / 0.12),
          inset -0.8rem -1rem 2rem rgb(0 0 30 / 0.45),
          0 1.5rem 3rem rgb(0 0 20 / 0.55);
      }
      .lens::after {
        content: ''; position: absolute; inset: 0; border-radius: 50%; pointer-events: none;
        background:
          radial-gradient(circle at 30% 24%, rgb(255 255 255 / 0.35), transparent 26%),
          radial-gradient(circle at 70% 82%, rgb(142 240 255 / 0.18), transparent 30%);
      }
      .lens-stage { position: absolute; }

      @media (max-width: 767px) {
        .top-nav { display: none; }
        .headline { top: 15%; font-size: 11vw; }
        .l2 { padding-left: 22%; }
        .l4 { padding-left: 12%; flex-wrap: wrap; row-gap: 1.2rem; }
        .giant { font-size: 38vw; bottom: -3%; }
      }
    </style>
  </body>
</html>
