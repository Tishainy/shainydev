---
// Ticket 05, round 2: A's full-bleed colour + C's text layout, with an original glass texture.
// Hidden (noindex), not linked. Static on purpose: judge the composition first.
// Open one sketch alone with /hero-lab/#d or #e.
import '../styles/global.css';
import { Font } from 'astro:assets';

const nav = ['Services', 'Work', 'Process', 'About'];
const variants = [
  { id: 'd', name: 'D. Glass blocks', glass: 'glass-blocks' },
  { id: 'e', name: 'E. Lens grid', glass: 'glass-lenses' },
];
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Hero lab — ShainyDev</title>
    <Font cssVariable="--font-clash" preload />
    <Font cssVariable="--font-hanken" preload />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" />
  </head>
  <body>
    {variants.map((variant) => (
      <section class="sketch" id={variant.id}>
        <div class="light" aria-hidden="true"></div>
        <div class={`glass ${variant.glass}`} aria-hidden="true"></div>

        <p class="tag">{variant.name}</p>

        <header class="top">
          <span class="mark">ShainyDev</span>
          <nav class="top-nav">
            {nav.map((item) => <a href="#">{item}</a>)}
            <a href="#">Let's talk ↗</a>
          </nav>
          <span class="sun" aria-hidden="true">☀</span>
        </header>

        <h1 class="headline">
          <span class="l l1">I build the tools</span>
          <span class="l l2 it">your business</span>
          <span class="l l3">wishes it had.<a class="pill" href="#">Let's talk</a></span>
        </h1>

        <p class="intro">Hi, I'm Shainy. A freelance developer making websites, automations and AI tools for small businesses.</p>

        <div class="giant-wrap">
          <p class="giant" aria-hidden="true">Shainy</p>
          <span class="label label-1">Websites</span>
          <span class="label label-2">Automation</span>
          <span class="label label-3">AI</span>
        </div>
      </section>
    ))}

    <script is:inline>
      const only = location.hash.slice(1);
      if (['d', 'e'].includes(only)) {
        document.querySelectorAll('.sketch').forEach((el) => { if (el.id !== only) el.hidden = true; });
      }
    </script>

    <style is:global>
      :root {
        --serif: 'Instrument Serif', Georgia, serif;
        --ink: #040a26;
        --tile: clamp(3.5rem, 6.5vw, 6.5rem);
        --lens: clamp(1.1rem, 1.9vw, 1.7rem);
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--ink); color: #f3f6ff; font-family: var(--font-hanken); }
      a { color: inherit; text-decoration: none; }

      .sketch { position: relative; height: 100svh; min-height: 40rem; overflow: clip; isolation: isolate; }
      .sketch + .sketch { border-top: 1px solid rgb(255 255 255 / 0.2); }

      .tag {
        position: absolute; left: 1rem; bottom: 1rem; z-index: 9; margin: 0;
        font-size: 0.8rem; padding: 0.3rem 0.6rem; border-radius: 0.4rem; background: rgb(0 0 0 / 0.6); color: #fff;
      }

      /* ---------- The light behind the glass ---------- */
      .light {
        position: absolute; inset: 0; z-index: 0;
        background:
          radial-gradient(26% 38% at 14% 22%, #dce7ff 0%, #7aa2ff 30%, transparent 70%),
          radial-gradient(22% 34% at 86% 30%, #8ef0ff 0%, #3a8bff 35%, transparent 72%),
          radial-gradient(30% 40% at 62% 62%, #5b7cff 0%, transparent 70%),
          radial-gradient(40% 50% at 30% 85%, #7c5cff 0%, transparent 70%),
          linear-gradient(115deg, #0b2bb8 0%, #0a1a73 40%, #1840e6 75%, #0c1f86 100%);
        filter: blur(12px) saturate(1.15);
        transform: scale(1.05);
      }

      /* ---------- D. Glass blocks: square bricks, each catching its own highlight ---------- */
      .glass { position: absolute; inset: 0; z-index: 1; }
      .glass-blocks {
        background-image:
          linear-gradient(90deg, rgb(2 6 30 / 0.55) 0 3px, transparent 3px),
          linear-gradient(0deg, rgb(2 6 30 / 0.55) 0 3px, transparent 3px),
          radial-gradient(circle at 30% 26%, rgb(255 255 255 / 0.28), transparent 32%),
          radial-gradient(farthest-corner at 50% 50%, transparent 52%, rgb(0 6 40 / 0.42) 100%),
          linear-gradient(135deg, rgb(255 255 255 / 0.1), transparent 45%, rgb(0 0 30 / 0.18));
        background-size: var(--tile) var(--tile);
        -webkit-backdrop-filter: blur(6px);
        backdrop-filter: blur(6px);
      }

      /* ---------- E. Lens grid: small round lenses, like a halftone screen ---------- */
      .glass-lenses {
        background-color: rgb(2 6 30 / 0.28);
        background-image:
          radial-gradient(circle at 38% 34%, rgb(255 255 255 / 0.45) 0 8%, transparent 22%),
          radial-gradient(circle at 50% 50%, transparent 0 36%, rgb(2 6 30 / 0.55) 46%, rgb(2 6 30 / 0.75) 100%);
        background-size: var(--lens) var(--lens);
      }

      /* ---------- Content layer ---------- */
      .sketch > :not(.light):not(.glass) { z-index: 2; }

      .top {
        position: absolute; top: 0; left: 0; right: 0;
        display: flex; align-items: center; justify-content: space-between; gap: 2rem;
        padding: 1.6rem 4%;
      }
      .mark { font-family: var(--font-clash); font-weight: 600; font-size: 1.35rem; letter-spacing: -0.02em; }
      .top-nav { flex: 1; display: flex; justify-content: space-evenly; font-weight: 500; font-size: 1.02rem; }
      .sun { font-size: 1.15rem; opacity: 0.85; }

      .headline {
        position: absolute; left: 6%; top: 17%; margin: 0;
        font-family: var(--font-clash); font-weight: 500; letter-spacing: -0.035em; line-height: 0.98;
        font-size: clamp(2.6rem, 5.4vw, 5.6rem);
        text-shadow: 0 2px 30px rgb(2 6 40 / 0.35);
      }
      .l { display: block; white-space: nowrap; }
      .it { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.01em; }
      .l2 { padding-left: 21%; font-size: 1.16em; }
      .l3 { padding-left: 8%; display: flex; align-items: center; gap: 0.45em; }

      .pill {
        display: inline-flex; align-items: center;
        font-family: var(--font-hanken); font-size: 1.1rem; letter-spacing: 0; text-shadow: none;
        padding: 0.85rem 1.7rem; border-radius: 999px;
        background: #f3f6ff; color: var(--ink); font-weight: 600;
      }

      .intro {
        position: absolute; right: 6%; top: 21%; margin: 0; max-width: 21ch;
        font-size: clamp(1.05rem, 1.35vw, 1.25rem); line-height: 1.45;
        text-shadow: 0 1px 16px rgb(2 6 40 / 0.5);
      }

      /* Giant name: a dark silhouette in front of the lit glass. */
      .giant-wrap { position: absolute; left: 0; right: 0; bottom: 0; height: 40%; }
      .giant {
        position: absolute; left: -1.5%; bottom: -9%; margin: 0;
        font-family: var(--font-clash); font-weight: 600; letter-spacing: -0.055em; line-height: 0.8;
        font-size: 31vw; white-space: nowrap;
        color: var(--ink);
      }

      /* Annotations pinned to specific letters, with a short leader line. */
      .label {
        position: absolute; font-size: clamp(0.85rem, 1.05vw, 1rem); font-weight: 600;
        padding-bottom: 2.2rem; text-shadow: 0 1px 12px rgb(2 6 40 / 0.6);
      }
      .label::after {
        content: ''; position: absolute; left: 0; bottom: 0.3rem; width: 1.5px; height: 1.6rem;
        background: currentColor; opacity: 0.85;
      }
      .label-1 { left: 9%; top: -6%; }
      .label-2 { left: 47%; top: 2%; }
      .label-3 { left: 82%; top: 8%; }

      @media (max-width: 767px) {
        .top-nav { display: none; }
        .headline { top: 14%; font-size: 10vw; }
        .l2 { padding-left: 14%; }
        .l3 { flex-wrap: wrap; padding-left: 4%; }
        .intro { left: 6%; right: 6%; top: auto; bottom: 34%; max-width: none; }
        .giant { font-size: 36vw; bottom: -4%; }
        .giant-wrap { height: 26%; }
        .label-1 { left: 6%; top: -18%; }
        .label-2 { left: 40%; top: -12%; }
        .label-3 { left: 84%; top: -6%; }
      }
    </style>
  </body>
</html>
