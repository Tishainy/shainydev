---
// Ticket 05, round 5: sketch I plus one small visual detail.
// Hidden (noindex), not linked. Open one alone with /hero-lab/#k or #l.
import '../styles/global.css';
import { Font } from 'astro:assets';

const nav = ['Services', 'Work', 'Process', 'About'];
// The orb won. The lens (detail: 'lens') is kept in the code for possible later use.
const variants = [
  { id: 'r', name: 'R. Ripples from the orb', fill: 'fill-light', italics: 'it-solid', detail: 'orb', lines: 'ripple' },
  { id: 'w', name: 'W. Flowing waves', fill: 'fill-light', italics: 'it-solid', detail: 'orb', lines: 'waves' },
  { id: 'd', name: 'D. Diagonal hairlines', fill: 'fill-light', italics: 'it-solid', detail: 'orb', lines: 'diagonal' },
];
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Hero lab — ShainyDev</title>
    <Font cssVariable="--font-clash" preload />
    <Font cssVariable="--font-hanken" preload />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" />
  </head>
  <body>
    {variants.map((variant) => (
      <section class="sketch" id={variant.id}>
        <canvas class="lines" data-lines={variant.lines} aria-hidden="true"></canvas>
        <canvas class="lines lines-glow" data-lines={variant.lines} aria-hidden="true"></canvas>
        <p class="tag">{variant.name}</p>

        <header class="top">
          <span class="mark">ShainyDev</span>
          <nav class="top-nav">
            {nav.map((item) => <a href="#">{item}</a>)}
            <a href="#">Let's talk ↗</a>
          </nav>
        </header>

        <h1 class={`headline ${variant.italics}`}>
          <span class="l l1">Websites, apps</span>
          <span class="l l2 it">&amp; automations</span>
          <span class="l l3">that do the work</span>
          <span class="l l4"><span class="it">for you.</span><a class="pill" href="#">Let's talk</a></span>
        </h1>

        {variant.detail === 'orb' || variant.detail === 'tile' ? (
          <p class={`giant ${variant.fill}`} aria-hidden="true">Sha<span class="i-wrap">ı<span class={variant.detail === 'tile' ? 'orb orb-tile' : 'orb'}><span class="orb-ball"></span></span></span>ny</p>
        ) : (
          <>
            <p class={`giant ${variant.fill}`} aria-hidden="true">Shainy</p>
            <div class="lens" aria-hidden="true">
              <div class="lens-stage"></div>
            </div>
          </>
        )}
      </section>
    ))}

    <script is:inline>
      const only = location.hash.slice(1);
      if (['r', 'w', 'd'].includes(only)) {
        document.querySelectorAll('.sketch').forEach((el) => { if (el.id !== only) el.hidden = true; });
      }
    </script>

    <script>
      import gsap from 'gsap';

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
      const pointer = { x: innerWidth / 2, y: innerHeight / 2, active: false };
      addEventListener('pointermove', (e) => {
        pointer.x = e.clientX;
        pointer.y = e.clientY;
        pointer.active = true;
      });

      // ---- Both: the light inside the name drifts toward the cursor ----
      document.querySelectorAll<HTMLElement>('.sketch').forEach((section) => {
        // Queried per frame so the lens's magnified copy follows the light too.
        const fills = () => section.querySelectorAll<HTMLElement>('.giant');
        fills().forEach((el) => (el.style.backgroundSize = '130% 130%'));
        const light = { x: 50, y: 50 };
        gsap.ticker.add(() => {
          if (reduce) return;
          const rect = section.getBoundingClientRect();
          const tx = pointer.active ? 100 - ((pointer.x - rect.left) / rect.width) * 100 : 50;
          const ty = pointer.active ? 100 - ((pointer.y - rect.top) / rect.height) * 100 : 50;
          light.x += (tx - light.x) * 0.04;
          light.y += (ty - light.y) * 0.04;
          fills().forEach((el) => (el.style.backgroundPosition = `${light.x}% ${light.y}%`));
        });
      });

      // ---- Faint background grid: fades out just before every letter, with a roaming spotlight ----
      const GRID = 64;
      const HALO = 34; // how far the fade reaches out from each letter, in px

      // Three line styles to choose from.
      function drawLines(ctx: CanvasRenderingContext2D, style: string, w: number, h: number, origin?: { x: number; y: number }) {
        if (style === 'ripple') {
          // Rings spreading out from the orb.
          const c = origin ?? { x: w / 2, y: h * 0.7 };
          const max = Math.hypot(Math.max(c.x, w - c.x), Math.max(c.y, h - c.y));
          for (let r = 30; r < max; r += 46) {
            ctx.moveTo(c.x + r, c.y);
            ctx.arc(c.x, c.y, r, 0, Math.PI * 2);
          }
        } else if (style === 'waves') {
          // Gently undulating horizontal lines, each a little out of phase with the next.
          for (let y = 0, row = 0; y < h + 40; y += 34, row++) {
            for (let x = 0; x <= w; x += 8) {
              const yy = y + Math.sin(x * 0.0042 + row * 0.38) * 18 + Math.sin(x * 0.0011 - row * 0.21) * 26;
              if (x === 0) ctx.moveTo(x, yy);
              else ctx.lineTo(x, yy);
            }
          }
        } else {
          // Fine parallel hairlines at an angle.
          const gap = 26;
          for (let x = -h; x < w; x += gap) {
            ctx.moveTo(x, h);
            ctx.lineTo(x + h * 0.58, 0);
          }
        }
      }

      function textMask(section: HTMLElement, mctx: CanvasRenderingContext2D, offset: number) {
        const origin = section.getBoundingClientRect();
        const ox = offset - origin.left;
        const oy = offset - origin.top;
        mctx.fillStyle = '#000';
        mctx.strokeStyle = '#000';
        mctx.lineJoin = 'round';
        mctx.lineWidth = HALO * 2;

        // Every character, drawn in its real font at its real position.
        const walker = document.createTreeWalker(section, NodeFilter.SHOW_TEXT);
        const range = document.createRange();
        let node: Node | null;
        while ((node = walker.nextNode())) {
          const parent = node.parentElement!;
          if (parent.closest('.lens, .tag, script, style')) continue;
          const text = node.textContent ?? '';
          const cs = getComputedStyle(parent);
          if (cs.visibility === 'hidden' || cs.display === 'none') continue;
          mctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
          for (let i = 0; i < text.length; i++) {
            const ch = text[i];
            if (!ch.trim()) continue;
            range.setStart(node, i);
            range.setEnd(node, i + 1);
            const r = range.getBoundingClientRect();
            if (!r.width) continue;
            const ascent = mctx.measureText(ch).fontBoundingBoxAscent;
            mctx.strokeText(ch, r.left + ox, r.top + oy + ascent);
            mctx.fillText(ch, r.left + ox, r.top + oy + ascent);
          }
        }
        // Shapes that aren't text: the button and the orb.
        section.querySelectorAll<HTMLElement>('.pill, .orb').forEach((el) => {
          if (el.closest('.lens')) return;
          const r = el.getBoundingClientRect();
          const rad = Math.min(r.width, r.height) / 2 + HALO;
          mctx.beginPath();
          mctx.roundRect(r.left + ox - HALO, r.top + oy - HALO, r.width + HALO * 2, r.height + HALO * 2, rad);
          mctx.fill();
        });
      }

      document.querySelectorAll<HTMLElement>('.sketch').forEach((section) => {
        const base = section.querySelector<HTMLCanvasElement>('canvas.lines');
        const glow = section.querySelector<HTMLCanvasElement>('canvas.lines-glow');
        if (!base || !glow) return;
        const mask = document.createElement('canvas');
        const mctx = mask.getContext('2d')!;
        const layers: [HTMLCanvasElement, string][] = [
          [base, 'rgb(143 176 255 / 0.12)'],
          [glow, 'rgb(196 214 255 / 0.8)'],
        ];
        const glowEl = glow;
        const lineStyle = base.dataset.lines ?? 'ripple';

        function draw() {
          const dpr = Math.min(devicePixelRatio || 1, 2);
          const w = section.clientWidth + GRID * 2;
          const h = section.clientHeight + GRID * 2;

          mask.width = w * dpr;
          mask.height = h * dpr;
          mctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          mctx.filter = 'blur(18px)';
          textMask(section, mctx, GRID);
          mctx.filter = 'none';

          for (const [canvas, colour] of layers) {
            const ctx = canvas.getContext('2d')!;
            canvas.width = w * dpr;
            canvas.height = h * dpr;
            canvas.style.width = w + 'px';
            canvas.style.height = h + 'px';
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            ctx.strokeStyle = colour;
            ctx.lineWidth = 1;
            ctx.beginPath();
            const orbEl = section.querySelector('.orb');
            let origin: { x: number; y: number } | undefined;
            if (orbEl) {
              const o = orbEl.getBoundingClientRect();
              const sr = section.getBoundingClientRect();
              origin = { x: o.left - sr.left + o.width / 2 + GRID, y: o.top - sr.top + o.height / 2 + GRID };
            }
            drawLines(ctx, lineStyle, w, h, origin);
            ctx.stroke();
            ctx.globalCompositeOperation = 'destination-out';
            ctx.drawImage(mask, 0, 0, w, h);
            ctx.globalCompositeOperation = 'source-over';
          }
        }

        draw();
        document.fonts?.ready.then(draw);
        addEventListener('resize', draw);

        // Two spotlights: soft pools of light that wander across the lines on their own.
        let t = Math.random() * 100;
        gsap.ticker.add((_, delta) => {
          if (!reduce) t += delta / 1000;
          const w = section.clientWidth;
          const h = section.clientHeight;
          const x1 = w * (0.5 + 0.44 * Math.sin(t * 0.21) * Math.cos(t * 0.09));
          const y1 = h * (0.5 + 0.4 * Math.sin(t * 0.16 + 1.3));
          const x2 = w * (0.5 + 0.44 * Math.cos(t * 0.17 + 2.1));
          const y2 = h * (0.5 + 0.4 * Math.sin(t * 0.13 + 4.2) * Math.cos(t * 0.07));
          glowEl.style.setProperty('--sp1x', x1 + GRID + 'px');
          glowEl.style.setProperty('--sp1y', y1 + GRID + 'px');
          glowEl.style.setProperty('--sp2x', x2 + GRID + 'px');
          glowEl.style.setProperty('--sp2y', y2 + GRID + 'px');
        });

        // A little depth: both grid layers drift against the cursor.
        if (!reduce) {
          const gx = gsap.quickTo([base, glow], 'x', { duration: 1.2, ease: 'power3' });
          const gy = gsap.quickTo([base, glow], 'y', { duration: 1.2, ease: 'power3' });
          addEventListener('pointermove', (e) => {
            gx(-(e.clientX / innerWidth - 0.5) * 16);
            gy(-(e.clientY / innerHeight - 0.5) * 16);
          });
        }
      });

      // ---- K: the orb drops in, floats, leans toward the cursor and catches its light ----
      document.querySelectorAll<HTMLElement>('.orb').forEach((orb) => {
        const ball = orb.querySelector<HTMLElement>('.orb-ball')!;
        if (reduce) return;

        gsap.from(ball, { scale: 0.3, autoAlpha: 0, filter: 'brightness(2.2)', duration: 1.4, ease: 'expo.out', delay: 0.4 });
        gsap.to(ball, { y: -5, duration: 2.2, ease: 'sine.inOut', yoyo: true, repeat: -1, delay: 1.8 });

        const leanX = gsap.quickTo(orb, 'x', { duration: 0.8, ease: 'power3' });
        const isTile = orb.classList.contains('orb-tile');
        const tiltX = gsap.quickTo(ball, 'rotationX', { duration: 0.9, ease: 'power3' });
        const tiltY = gsap.quickTo(ball, 'rotationY', { duration: 0.9, ease: 'power3' });
        const shine = { x: 34, y: 28 };
        gsap.ticker.add(() => {
          const rect = ball.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const dx = pointer.x - cx;
          const dy = pointer.y - cy;
          const dist = Math.hypot(dx, dy) || 1;
          if (pointer.active) leanX(gsap.utils.clamp(-14, 14, dx * 0.03));
          // The square tile also tilts toward the cursor, like a small glass cube.
          if (isTile && pointer.active) {
            tiltY(gsap.utils.clamp(-28, 28, dx * 0.05));
            tiltX(gsap.utils.clamp(-28, 28, -dy * 0.05));
          }
          // The highlight slides toward the cursor, like glass catching a light.
          const tx = pointer.active ? 50 + (dx / dist) * 22 : 34;
          const ty = pointer.active ? 50 + (dy / dist) * 22 : 28;
          shine.x += (tx - shine.x) * 0.12;
          shine.y += (ty - shine.y) * 0.12;
          ball.style.setProperty('--sx', shine.x + '%');
          ball.style.setProperty('--sy', shine.y + '%');
        });

      });

      // ---- L: a lens that glides along the name, magnifying what's under it ----
      const MAGNIFY = 1.35;
      document.querySelectorAll<HTMLElement>('.lens').forEach((lens) => {
        const section = lens.closest<HTMLElement>('.sketch')!;
        const stage = lens.querySelector<HTMLElement>('.lens-stage')!;
        // The lens shows a magnified copy of the whole hero.
        section.querySelectorAll('.top, .headline, .giant').forEach((el) => stage.append(el.cloneNode(true)));
        const pos = { x: 0, y: 0 };
        let t = 0;

        function render() {
          const r = lens.offsetWidth / 2;
          const left = lens.offsetLeft + pos.x;
          const top = lens.offsetTop + pos.y;
          lens.style.transform = `translate(${pos.x}px, ${pos.y}px)`;
          stage.style.width = section.clientWidth + 'px';
          stage.style.height = section.clientHeight + 'px';
          stage.style.left = -left + 'px';
          stage.style.top = -top + 'px';
          stage.style.transformOrigin = `${left + r}px ${top + r}px`;
          stage.style.transform = `scale(${MAGNIFY})`;
        }

        gsap.ticker.add((_, delta) => {
          const s = section.getBoundingClientRect();
          const r = lens.offsetWidth / 2;
          // Anywhere inside the hero.
          const minX = -lens.offsetLeft;
          const maxX = s.width - lens.offsetLeft - r * 2;
          const minY = -lens.offsetTop;
          const maxY = s.height - lens.offsetTop - r * 2;
          let tx: number;
          let ty: number;
          if (finePointer && pointer.active && !reduce) {
            tx = pointer.x - s.left - lens.offsetLeft - r;
            ty = pointer.y - s.top - lens.offsetTop - r;
          } else if (!reduce) {
            // No mouse: wander slowly over the headline and the name.
            t += delta / 1000;
            tx = minX + ((Math.sin(t * 0.3) + 1) / 2) * (maxX - minX);
            ty = minY + (0.25 + ((Math.sin(t * 0.47) + 1) / 2) * 0.55) * (maxY - minY);
          } else {
            tx = 0;
            ty = 0;
          }
          tx = gsap.utils.clamp(minX, maxX, tx);
          ty = gsap.utils.clamp(minY, maxY, ty);
          pos.x += (tx - pos.x) * 0.08;
          pos.y += (ty - pos.y) * 0.08;
          render();
        });
      });
    </script>

    <style is:global>
      :root {
        --serif: 'Instrument Serif', Georgia, serif;
        --ink: #040a24;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--ink); color: #f3f6ff; font-family: var(--font-hanken); }
      a { color: inherit; text-decoration: none; }

      .sketch { position: relative; height: 100svh; min-height: 38rem; overflow: clip; }
      .sketch + .sketch { border-top: 1px solid rgb(255 255 255 / 0.15); }

      .tag {
        position: absolute; right: 1rem; bottom: 1rem; z-index: 9; margin: 0;
        font-size: 0.8rem; padding: 0.3rem 0.6rem; border-radius: 0.4rem; background: rgb(255 255 255 / 0.12);
      }

      .lines { position: absolute; left: -64px; top: -64px; z-index: 0; pointer-events: none; }
      .lines-glow {
        --sp1x: 30%; --sp1y: 40%; --sp2x: 70%; --sp2y: 60%;
        -webkit-mask-image:
          radial-gradient(circle 380px at var(--sp1x) var(--sp1y), #000 0%, rgb(0 0 0 / 0.45) 45%, transparent 100%),
          radial-gradient(circle 340px at var(--sp2x) var(--sp2y), #000 0%, rgb(0 0 0 / 0.45) 45%, transparent 100%);
        mask-image:
          radial-gradient(circle 380px at var(--sp1x) var(--sp1y), #000 0%, rgb(0 0 0 / 0.45) 45%, transparent 100%),
          radial-gradient(circle 340px at var(--sp2x) var(--sp2y), #000 0%, rgb(0 0 0 / 0.45) 45%, transparent 100%);
      }

      .top {
        position: absolute; top: 0; left: 0; right: 0; z-index: 2;
        display: flex; align-items: center; gap: 2rem; padding: 1.6rem 6%;
      }
      .mark { font-family: var(--font-clash); font-weight: 600; font-size: 1.35rem; letter-spacing: -0.02em; }
      .top-nav { flex: 1; display: flex; justify-content: flex-end; gap: clamp(1.5rem, 4vw, 3.5rem); font-weight: 500; opacity: 0.9; }

      /* A's placement: a centred block, each line pushed to its own spot. */
      .headline {
        position: absolute; left: 50%; top: 15%; translate: -50% 0; margin: 0; z-index: 2;
        width: min(64rem, 90vw);
        font-family: var(--font-clash); font-weight: 500; letter-spacing: -0.035em; line-height: 0.95;
        font-size: clamp(2.8rem, 6.3vw, 6.2rem);
      }
      .l { display: block; white-space: nowrap; }
      .it { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.01em; }
      .l1 { padding-left: 2%; }
      .l2 { padding-left: 40%; font-size: 1.1em; }
      .l3 { padding-left: 0; }
      .l4 { padding-left: 33%; display: flex; align-items: center; gap: 0.4em; font-size: 1.1em; }

      .it-solid .it { color: #8fb0ff; }
      /* The italic words carry the same light as the giant name. */
      .it-lit .it {
        background:
          radial-gradient(60% 120% at 20% 30%, #dbe6ff 0%, #7aa2ff 40%, transparent 80%),
          radial-gradient(50% 120% at 85% 70%, #8ef0ff 0%, #3a8bff 45%, transparent 85%),
          linear-gradient(90deg, #5b84ff, #8a6bff);
        -webkit-background-clip: text; background-clip: text; color: transparent;
        padding: 0 0.08em 0.18em 0;
        margin-bottom: -0.18em;
        display: inline-block;
      }

      .pill {
        display: inline-flex; align-items: center;
        font-family: var(--font-hanken); font-size: 1.1rem; letter-spacing: 0; font-weight: 600; font-style: normal;
        padding: 0.85rem 1.7rem; border-radius: 999px; border: 1.5px solid rgb(243 246 255 / 0.6);
      }

      /* The giant name carries all the colour. */
      .giant {
        position: absolute; left: -1%; right: -1%; bottom: -6%; margin: 0;
        font-family: var(--font-clash); font-weight: 600; letter-spacing: -0.055em; line-height: 0.8;
        font-size: 29vw; white-space: nowrap; text-align: center;
        -webkit-background-clip: text; background-clip: text; color: transparent;
      }

      /* The light every fill sits on: cobalt with a cyan and a violet glow. */
      .giant {
        --glow:
          radial-gradient(28% 70% at 16% 35%, #dbe6ff 0%, #7aa2ff 28%, transparent 70%),
          radial-gradient(24% 70% at 78% 55%, #8ef0ff 0%, #3a8bff 35%, transparent 72%),
          radial-gradient(30% 60% at 48% 90%, #8a6bff 0%, transparent 70%),
          linear-gradient(90deg, #1d3fd6, #2f5bff 50%, #1a36c4);
      }

      /* F. Vertical reeds, as in sketch C. */
      .fill-reeds {
        background:
          repeating-linear-gradient(90deg, rgb(255 255 255 / 0.22) 0 2px, rgb(255 255 255 / 0.04) 2px 1.2vw, rgb(0 0 40 / 0.35) 1.9vw 2.6vw),
          var(--glow);
        -webkit-background-clip: text; background-clip: text;
      }

      /* G. Square glass blocks. */
      .fill-blocks {
        background:
          linear-gradient(90deg, rgb(2 6 30 / 0.6) 0 3px, transparent 3px) 0 0 / 4.2vw 4.2vw,
          linear-gradient(0deg, rgb(2 6 30 / 0.6) 0 3px, transparent 3px) 0 0 / 4.2vw 4.2vw,
          radial-gradient(circle at 30% 26%, rgb(255 255 255 / 0.3), transparent 34%) 0 0 / 4.2vw 4.2vw,
          radial-gradient(farthest-corner, transparent 50%, rgb(0 6 40 / 0.4)) 0 0 / 4.2vw 4.2vw,
          var(--glow);
        -webkit-background-clip: text; background-clip: text;
      }

      /* H. Just the light: no texture. */
      .fill-light {
        background: var(--glow);
        -webkit-background-clip: text; background-clip: text;
      }

      /* K. The dot of the i becomes a small glowing glass sphere. */
      .i-wrap { position: relative; }
      /* Placed from Clash Display Semibold's own metrics: the dotless i's stem centre is
         0.124em from its left edge, and the original dot's centre sits 0.611em above the
         baseline, i.e. 0.279em below the top of the 0.89em ascent. Orb is 0.14em wide. */
      .orb {
        position: absolute; left: 0.054em; top: 0.209em;
        width: 0.14em; height: 0.14em;
      }
      .orb-ball {
        position: absolute; inset: 0; border-radius: 50%;
        --sx: 34%; --sy: 28%;
        background:
          radial-gradient(circle at var(--sx) var(--sy), #ffffff 0 6%, rgb(255 255 255 / 0.6) 12%, transparent 30%),
          radial-gradient(circle at 50% 55%, #8ef0ff 0%, #709bff 38%, #2346e0 72%, #0d1f8a 100%);
        box-shadow:
          inset -0.012em -0.016em 0.03em rgb(0 0 40 / 0.55),
          inset 0.01em 0.01em 0.02em rgb(255 255 255 / 0.5),
          0 0 0.08em rgb(142 176 255 / 0.55);
      }

      /* M. The same idea as a square glass tile, the exact size and place of the font's dot:
         the dotless i's stem runs 0.049–0.199em, the original dot 0.552–0.67em above the baseline. */
      .orb-tile {
        left: 0.049em; top: 0.22em;
        width: 0.15em; height: 0.118em;
        perspective: 0.6em;
      }
      .orb-tile .orb-ball {
        border-radius: 0.012em;
        background:
          radial-gradient(circle at var(--sx) var(--sy), rgb(255 255 255 / 0.95) 0 5%, rgb(255 255 255 / 0.45) 14%, transparent 34%),
          linear-gradient(145deg, rgb(255 255 255 / 0.35), transparent 40%),
          linear-gradient(160deg, #a9c3ff 0%, #709bff 35%, #2f5be0 70%, #16309c 100%);
        box-shadow:
          inset 0 0 0 0.004em rgb(255 255 255 / 0.55),
          inset -0.01em -0.014em 0.022em rgb(0 0 40 / 0.5),
          0 0 0.07em rgb(142 176 255 / 0.5);
      }

      /* L. A round glass lens resting on the name. */
      .lens {
        position: absolute; left: 37%; top: 71%; z-index: 3; will-change: transform; pointer-events: none;
        width: clamp(9rem, 17vw, 17rem); aspect-ratio: 1; border-radius: 50%;
        overflow: hidden; background: rgb(4 10 36 / 0.7);
        border: 1px solid rgb(255 255 255 / 0.35);
        box-shadow:
