---
// Ticket 05, attempt 2: three still hero sketches to pick a direction before animating.
// Hidden (noindex), not linked. Static on purpose: judge the composition first.
import '../styles/global.css';
import { Font } from 'astro:assets';

const nav = ['Services', 'Work', 'Process', 'About'];
const ribs = Array.from({ length: 36 });
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Hero lab — ShainyDev</title>
    <Font cssVariable="--font-clash" preload />
    <Font cssVariable="--font-hanken" preload />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" />
  </head>
  <body>
    <!-- ============ A. Reeded cobalt ============ -->
    <section class="sketch sketch-a" id="a">
      <div class="light light-a" aria-hidden="true"></div>
      <div class="reeds" aria-hidden="true">{ribs.map(() => <span></span>)}</div>

      <p class="tag">A. Reeded cobalt</p>
      <p class="mark">ShainyDev</p>

      <h1 class="headline headline-a">
        <span class="l l1">Websites, apps</span>
        <span class="l l2 it">&amp; automations</span>
        <span class="l l3">that do the work</span>
        <span class="l l4"><span class="it">for you.</span><a class="pill" href="#">Let's talk</a></span>
      </h1>

      <p class="note note-left">Hi, I'm Shainy. A freelance developer<br />for small businesses.</p>
      <p class="note note-right">Websites, automation and AI,<br />built to save you time.</p>

      <nav class="bottom-nav">
        <span class="sun" aria-hidden="true">☀</span>
        {nav.map((item) => <a href="#">{item}</a>)}
        <a href="#">Let's talk ↗</a>
      </nav>
    </section>

    <!-- ============ B. Light through glass ============ -->
    <section class="sketch sketch-b" id="b">
      <div class="glass-window" aria-hidden="true">
        <div class="light light-b"></div>
        <div class="reeds reeds-fine">{ribs.map(() => <span></span>)}</div>
      </div>

      <p class="tag">B. Light, with a glass window</p>
      <p class="mark mark-left">ShainyDev</p>

      <h1 class="headline headline-b">
        <span class="l b1">Tell me what's</span>
        <span class="l b2 it">slowing you down.</span>
        <span class="l b3">I'll build</span>
        <span class="l b4 it">the fix.</span>
      </h1>

      <p class="note note-b">Hi, I'm Shainy. I build websites,<br />automations and AI tools for small businesses.</p>
      <a class="pill pill-solid pill-b" href="#">Start a project</a>

      <nav class="side-nav">
        {nav.map((item) => <a href="#">{item}</a>)}
      </nav>
    </section>

    <!-- ============ C. Type as a window ============ -->
    <section class="sketch sketch-c" id="c">
      <p class="tag">C. Type as a window</p>
      <p class="mark">ShainyDev</p>

      <h1 class="headline headline-c">
        <span class="l c1">I build the tools</span>
        <span class="l c2 it">your business</span>
        <span class="l c3">wishes it had.</span>
      </h1>

      <p class="giant" aria-hidden="true">Shainy</p>

      <p class="note note-c">Websites<br />Automation<br />AI</p>
      <a class="pill pill-c" href="#">Let's talk</a>
    </section>

    <script is:inline>
      // Open one sketch on its own with /hero-lab/#a, #b or #c.
      const only = location.hash.slice(1);
      if (['a', 'b', 'c'].includes(only)) {
        document.querySelectorAll('.sketch').forEach((el) => { if (el.id !== only) el.hidden = true; });
      }
    </script>

    <style is:global>
      :root {
        --serif: 'Instrument Serif', Georgia, serif;
        --ink-dark: #050a1f;
        --cobalt: #709bff;
        --cobalt-deep: #1d3fd6;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--ink-dark); color: #f3f5fb; font-family: var(--font-hanken); }
      a { color: inherit; text-decoration: none; }

      .sketch {
        position: relative;
        height: 100svh;
        min-height: 40rem;
        overflow: clip;
        isolation: isolate;
      }
      .sketch + .sketch { border-top: 1px solid rgb(255 255 255 / 0.15); }

      .tag {
        position: absolute; left: 1rem; top: 1rem; z-index: 5; margin: 0;
        font-size: 0.8rem; padding: 0.3rem 0.6rem; border-radius: 0.4rem;
        background: rgb(0 0 0 / 0.55); color: #fff;
      }

      .mark {
        position: absolute; top: 4.5%; left: 50%; translate: -50% 0; margin: 0;
        font-family: var(--font-clash); font-weight: 600; font-size: 1.4rem; letter-spacing: -0.02em;
      }
      .mark-left { left: 4%; translate: none; }

      .headline { margin: 0; font-family: var(--font-clash); font-weight: 500; letter-spacing: -0.035em; line-height: 0.95; }
      .l { display: block; white-space: nowrap; }
      .it { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.01em; }

      .pill {
        display: inline-flex; align-items: center; justify-content: center;
        font-family: var(--font-hanken); font-size: 1.15rem; letter-spacing: 0; font-style: normal;
        padding: 0.9rem 1.8rem; border: 1.5px solid currentColor; border-radius: 999px;
      }
      .pill-solid { background: var(--cobalt-deep); border-color: var(--cobalt-deep); color: #fff; }

      .note { position: absolute; margin: 0; font-size: 1.05rem; line-height: 1.45; opacity: 0.8; }

      /* ---------- Reeded glass: ribs blur and shade whatever light sits behind them ---------- */
      .reeds { position: absolute; inset: 0; display: flex; z-index: 0; }
      .reeds span {
        flex: 1;
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
        background: linear-gradient(90deg,
          rgb(255 255 255 / 0.14) 0%,
          rgb(255 255 255 / 0.02) 18%,
          rgb(0 0 30 / 0.22) 62%,
          rgb(0 0 30 / 0.4) 88%,
          rgb(255 255 255 / 0.18) 100%);
      }

      /* ===== A ===== */
      .sketch-a { background: #061347; }
      .light { position: absolute; inset: 0; z-index: 0; }
      .light-a {
        background:
          radial-gradient(22% 60% at 9% 18%, #9fc0ff 0%, #4f7dff 35%, transparent 70%),
          radial-gradient(18% 70% at 92% 70%, #b9d0ff 0%, #3d63ff 40%, transparent 75%),
          radial-gradient(30% 45% at 70% 10%, #2a4cff 0%, transparent 70%),
          linear-gradient(90deg, #0a1f7a, #04103f 45%, #0b2490);
      }
      .sketch-a > :not(.light):not(.reeds) { z-index: 2; }
      .headline-a {
        position: absolute; left: 50%; top: 31%; translate: -50% 0; width: min(68rem, 92vw);
        font-size: clamp(3rem, 7.2vw, 7rem);
      }
      .headline-a .l1 { padding-left: 2%; }
      .headline-a .l2 { padding-left: 40%; font-size: 1.1em; }
      .headline-a .l3 { padding-left: 0; }
      .headline-a .l4 { padding-left: 33%; display: flex; align-items: center; gap: 0.35em; font-size: 1.1em; }
      .headline-a .pill { font-size: 1.1rem; }
      .note-left { left: 22%; bottom: 13%; }
      .note-right { right: 22%; bottom: 13%; text-align: left; }
      .bottom-nav {
        position: absolute; left: 0; right: 0; bottom: 3.5%;
        display: flex; justify-content: space-between; align-items: center;
        padding-inline: 14%; font-size: 1.05rem; font-weight: 500;
      }
      .sun { font-size: 1.2rem; opacity: 0.8; }

      /* ===== B ===== */
      .sketch-b { background: #f2f3f7; color: #0b1230; }
      .sketch-b .tag { background: rgb(0 0 0 / 0.7); }
      .glass-window {
        position: absolute; right: 0; top: 0; bottom: 0; width: 46%;
        overflow: clip; background: #0b1a66;
      }
      .light-b {
        background:
          radial-gradient(40% 35% at 30% 30%, #c9d8ff 0%, #6f95ff 30%, transparent 70%),
          radial-gradient(35% 40% at 75% 75%, #8fb0ff 0%, #2448e6 45%, transparent 75%),
          linear-gradient(160deg, #1c3ce0, #091a6a);
      }
      .reeds-fine span { backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
      .headline-b {
        position: absolute; left: 4%; top: 22%;
        font-size: clamp(3rem, 6.6vw, 6.4rem);
      }
      .headline-b .b2 { padding-left: 9%; font-size: 1em; color: var(--cobalt-deep); }
      .headline-b .b3 { padding-left: 4%; }
      .headline-b .b4 { padding-left: 34%; font-size: 1.12em; color: var(--cobalt-deep); position: relative; z-index: 3; }
      .note-b { left: 4.5%; bottom: 12%; color: #3a415a; opacity: 1; }
      .pill-b { position: absolute; left: 34%; bottom: 11.5%; }
      .side-nav {
        position: absolute; right: 2.5%; top: 50%; translate: 0 -50%; z-index: 3;
        display: grid; gap: 1.1rem; justify-items: end; color: #fff; font-size: 1.05rem; font-weight: 500;
      }

      /* ===== C ===== */
      .sketch-c { background: #040a24; }
      .headline-c {
        position: absolute; left: 6%; top: 17%;
        font-size: clamp(2.4rem, 4.6vw, 4.4rem);
      }
      .headline-c .c2 { padding-left: 22%; font-size: 1.15em; color: var(--cobalt); }
      .headline-c .c3 { padding-left: 9%; }
      .giant {
        position: absolute; left: -1%; right: -1%; bottom: -6%; margin: 0;
        font-family: var(--font-clash); font-weight: 600; letter-spacing: -0.05em; line-height: 0.8;
        font-size: 33vw; white-space: nowrap; text-align: center;
        /* Reeded light seen through the letters. */
        background:
          repeating-linear-gradient(90deg, rgb(255 255 255 / 0.22) 0 2px, rgb(255 255 255 / 0.04) 2px 1.2vw, rgb(0 0 40 / 0.35) 1.9vw 2.6vw),
          radial-gradient(30% 60% at 20% 40%, #b5cbff, transparent 70%),
          radial-gradient(30% 60% at 75% 60%, #8fb0ff, transparent 70%),
          linear-gradient(90deg, #1d3fd6, #3d63ff 50%, #1d3fd6);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .note-c { right: 6%; top: 19%; text-align: right; font-size: 1.1rem; }
      .pill-c { position: absolute; right: 6%; top: 27%; }

      /* ---------- Phones ---------- */
      @media (max-width: 767px) {
        .headline-a { top: 26%; font-size: 11vw; }
        .headline-a .l2 { padding-left: 22%; }
        .headline-a .l4 { padding-left: 14%; flex-wrap: wrap; }
        .note-left, .note-right { left: 6%; right: 6%; }
        .note-left { bottom: 22%; }
        .note-right { bottom: 13%; }
        .bottom-nav { padding-inline: 5%; font-size: 0.9rem; }
        .glass-window { width: 100%; top: 62%; }
        .headline-b { font-size: 11vw; top: 16%; }
        .note-b { bottom: 42%; }
        .pill-b { left: 4.5%; bottom: 31%; }
        .side-nav { display: none; }
        .giant { font-size: 38vw; bottom: 0; }
        .note-c, .pill-c { right: auto; left: 6%; text-align: left; }
        .note-c { top: auto; bottom: 34%; }
        .pill-c { top: auto; bottom: 25%; }
      }
    </style>
  </body>
</html>
