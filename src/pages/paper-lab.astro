---
// "Paper" direction, round 2: the star leads, a fuller homepage, light and dark.
// Hidden (noindex), not linked. Toggle the mode with the button; /paper-lab/#dark opens in dark.
import '../styles/global.css';
import { Font } from 'astro:assets';
import { projects, media } from '../data/work';

// Shainy's star: five separate shards (from her own logo SVG).
const shards = [
  'M241.495 0L313.808 125.25H169.182L241.495 0Z',
  'M25.887 148.966L168.723 126.283L116.949 261.325L25.887 148.966Z',
  'M455.819 148.966L312.983 126.283L364.757 261.325L455.819 148.966Z',
  'M100.669 412.326L118.069 262.146L238.748 350.753L100.669 412.326Z',
  'M380.321 412.326L362.922 262.146L242.243 350.753L380.321 412.326Z',
];
const star = (cls: string) =>
  `<svg class="${cls}" viewBox="0 0 482 457" aria-hidden="true">${shards.map((d, i) => `<path class="sh sh${i}" d="${d}"/>`).join('')}</svg>`;
// A small family of clean, flat marks that sit alongside the star (100×100 each).
// Triangles only ever point straight up or straight down.
const glyphs: Record<string, string> = {
  sparkle: '<path d="M50 0C54 34 66 46 100 50C66 54 54 66 50 100C46 66 34 54 0 50C34 46 46 34 50 0Z"/>',
  ring: '<path fill-rule="evenodd" d="M50 4a46 46 0 1 0 0 92a46 46 0 1 0 0-92Zm0 22a24 24 0 1 1 0 48a24 24 0 1 1 0-48Z"/>',
  arch: '<path d="M8 96V50a42 42 0 0 1 84 0v46H68V50a18 18 0 0 0-36 0v46Z"/>',
  plus: '<path d="M37 4h26v33h33v26H63v33H37V63H4V37h33Z"/>',
  flower: '<circle cx="50" cy="26" r="23"/><circle cx="74" cy="50" r="23"/><circle cx="50" cy="74" r="23"/><circle cx="26" cy="50" r="23"/>',
  half: '<path d="M4 58a46 46 0 0 1 92 0Z"/><rect x="4" y="68" width="92" height="20"/>',
  diamond: '<path d="M50 2 98 50 50 98 2 50Z"/>',
  triUp: '<path d="M50 8 96 90H4Z"/>',
  triDown: '<path d="M4 10h92L50 92Z"/>',
};
const glyph = (name: string, cls: string) => `<svg class="glyph ${cls}" viewBox="0 0 100 100" aria-hidden="true">${glyphs[name]}</svg>`;

const services = [
  { glyph: 'arch', name: 'Build', line: 'Websites and apps that look like you and work on every phone.', list: ['Business websites', 'Landing pages', 'Redesigns', 'Web apps'] },
  { glyph: 'ring', name: 'Automate', line: 'The tasks you repeat every week, done by themselves.', list: ['Workflows', 'Data & reports', 'Email design', 'Email flows'] },
  { glyph: 'sparkle', name: 'AI', line: 'Assistants and smart tools that actually help.', list: ['Chatbots', 'AI in your tools', 'Document sorting'] },
];
// Chores the services take off a client's plate. Hours are example estimates for a small business.
const chores = [
  { task: 'Copying orders from your inbox into a spreadsheet', tag: 'Automate', hours: 2 },
  { task: 'Answering the same five customer questions', tag: 'AI', hours: 3 },
  { task: 'Chasing unpaid invoices one email at a time', tag: 'Automate', hours: 1 },
  { task: 'Writing the newsletter from scratch every week', tag: 'Email', hours: 2 },
  { task: 'Explaining your opening hours on the phone', tag: 'Website', hours: 1 },
];
const choreHours = chores.reduce((n, c) => n + c.hours, 0);
const promises = [
  { glyph: 'ring', text: 'Reply within 48 hours' },
  { glyph: 'diamond', text: 'Clear plan and price upfront' },
  { glyph: 'half', text: 'Plain language, always' },
];
const steps = [
  { glyph: 'half', name: 'Talk', line: "A chat about your business and what's in the way. No jargon." },
  { glyph: 'diamond', name: 'Design', line: 'You see how it will look before anything gets built.' },
  { glyph: 'plus', name: 'Build', line: 'I build it and keep you posted, so nothing surprises you.' },
  { glyph: 'triUp', name: 'Launch', line: "We go live, I show you everything, and I stay around after." },
];
---

<html lang="en" data-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Paper lab — ShainyDev</title>
    <Font cssVariable="--font-clash" preload />
    <Font cssVariable="--font-hanken" preload />
    <Font cssVariable="--font-instrument" preload />
    <script is:inline>
      if (location.hash === '#dark') document.documentElement.dataset.mode = 'dark';
    </script>
  </head>
  <body>
    <header class="bar">
      <a class="brand" href="#"><Fragment set:html={star('brand-star')} /><span>ShainyDev</span></a>
      <nav class="nav"><a href="#svc">Services</a><a href="#work">Work</a><a href="#how">Process</a><a href="#talk">Contact</a></nav>
      <button class="mode" type="button" data-mode-toggle aria-label="Switch light or dark">
        <span class="mode-dot"></span><span data-mode-label>Dark</span>
      </button>
    </header>

    <!-- ===================== HERO: the star leads ===================== -->
    <section class="hero" data-hero>

      <div class="hero-stage">
        <div class="hero-star-wrap" data-hero-star><Fragment set:html={star('hero-star')} /></div>
        <h1 class="hero-h">
          <span class="ln"><span class="in">Websites, apps</span></span>
          <span class="ln"><span class="in"><em>&amp;</em> automations <Fragment set:html={glyph('sparkle', 'inl')} /></span></span>
          <span class="ln"><span class="in">that do the work</span></span>
          <span class="ln"><span class="in"><em>for you.</em></span></span>
        </h1>
      </div>

      <div class="hero-foot">
        <p class="hero-note">Freelance developer for small businesses. I build the tools you wish you had, and explain every step in plain language.</p>
        <a class="btn" href="#talk">Let's talk <span aria-hidden="true">→</span></a>
        <p class="scroll-cue"><span></span>Scroll</p>
      </div>
    </section>

    <!-- ===================== RED BAND TICKER ===================== -->
    <section class="band" aria-label="Services">
      <div class="band-track" data-band>
        {[0, 1].map(() =>
          ['Websites', 'Apps', 'Automations', 'Email', 'AI assistants'].map((w, i) => (
            <span class="band-item">{w}<Fragment set:html={i % 2 === 0 ? star('band-star spin') : glyph(['sparkle', 'flower'][(i - 1) / 2 % 2], 'band-glyph spin')} /></span>
          )),
        )}
      </div>
    </section>

    <!-- ===================== SERVICES ===================== -->
    <section class="svc" id="svc">
      <header class="sec-head" data-up>
        <p class="sec-no">What I do</p>
        <h2>Three ways I make your business <em>shine</em>.</h2>
      </header>
      <div class="svc-grid">
        {services.map((s, i) => (
          <article class="svc-col" data-col>
            <span class="rule" data-rule></span>
            <Fragment set:html={glyph(s.glyph, 'svc-mark')} />
            <h3>{s.name}</h3>
            <p class="svc-line">{s.line}</p>
            <ul>{s.list.map((x) => <li>{x}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <!-- ===================== WORK: posters slide past while the section holds ===================== -->
    <section class="work" id="work">
      <div class="posters" data-posters>
        <div class="poster-track" data-track>
          <article class="poster po-intro">
            <p class="sec-no">Selected work</p>
            <h2>Things I've <em>built</em>.</h2>
            <p class="po-hint">Scroll <span aria-hidden="true">→</span></p>
          </article>
          {projects.map((p, i) => (
            <article class={`poster po-${p.id}`}>
              <div class="po-media"><Fragment set:html={media(p.id)} /></div>
              <div class="po-text">
                <p class="po-kind">0{i + 1} · {p.kind} · {p.who}</p>
                <h3>{p.name}</h3>
                <p class="po-line">{p.line}</p>
              </div>
            </article>
          ))}
          <article class="poster po-next">
            <Fragment set:html={star('po-star')} />
            <h3>Your project next?</h3>
            <a class="po-btn" href="#talk">Let's talk</a>
          </article>
        </div>
        <p class="po-count" aria-hidden="true"><span data-count>01</span> / 0{projects.length}</p>
      </div>
    </section>

    <!-- ===================== PROCESS ===================== -->
    <section class="how" id="how">
      <header class="sec-head" data-up>
        <p class="sec-no">How it works</p>
        <h2>From first chat to <em>launch</em>.</h2>
      </header>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step" data-step>
            <span class="step-n"><Fragment set:html={glyph(s.glyph, 'step-mark')} />0{i + 1}</span>
            <h3>{s.name}</h3>
            <p>{s.line}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- ===================== CHORES: crossed off as you scroll ===================== -->
    <section class="chores" data-chores>
      <div class="chores-side">
        <p class="sec-no">What changes</p>
        <h2>Things you'll <em>stop</em> doing.</h2>
        <p class="chores-count"><span class="chores-n" data-hours>{choreHours}</span><span class="chores-unit">hours back,<br />every week</span></p>
        <p class="chores-note">Example estimates for a small business. Yours will differ, and I'll tell you honestly what's worth automating.</p>
      </div>
      <ol class="chore-list">
        {chores.map((c) => (
          <li class="chore" data-chore data-hours={c.hours}>
            <span class="chore-task"><span class="chore-text">{c.task}</span></span>
            <span class="chore-meta"><span class="chore-tag">{c.tag}</span><span class="chore-time">~{c.hours} h / week</span></span>
          </li>
        ))}
      </ol>
    </section>

    <!-- ===================== CONTACT: the address is the centrepiece ===================== -->
    <section class="talk" id="talk">
      <div class="talk-top">
        <p class="sec-no">Contact</p>
        <h2 class="talk-h">Got something in mind? <em>Say hi.</em></h2>
      </div>
      <a class="talk-mail" href="mailto:shainydev@gmail.com" data-talk-mail aria-label="Email shainydev@gmail.com">
        {[...'shainydev'].map((c) => <span class="ch">{c}</span>)}<span class="ch at">@</span>{[...'gmail.com'].map((c) => <span class="ch">{c}</span>)}
      </a>
      <div class="talk-foot">
        <ul class="talk-promises">
          {promises.map((p) => <li><Fragment set:html={glyph(p.glyph, 'pm')} />{p.text}</li>)}
        </ul>
        <div class="talk-actions">
          <button class="pill-btn" type="button" data-copy="shainydev@gmail.com"><span data-copy-label>Copy address</span></button>
          <a class="pill-btn" href="https://www.linkedin.com/in/shainy-naar-79618b358/">LinkedIn ↗</a>
        </div>
      </div>
    </section>

    <footer class="foot">
      <span class="brand"><Fragment set:html={star('brand-star')} /><span>ShainyDev</span></span>
      <span>Designed &amp; built by Shainy · © 2026</span>
    </footer>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import Lenis from 'lenis';
      gsap.registerPlugin(ScrollTrigger);
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Mode toggle.
      const root = document.documentElement;
      const label = document.querySelector<HTMLElement>('[data-mode-label]')!;
      const sync = () => (label.textContent = root.dataset.mode === 'dark' ? 'Light' : 'Dark');
      sync();
      document.querySelector('[data-mode-toggle]')!.addEventListener('click', () => {
        root.dataset.mode = root.dataset.mode === 'dark' ? 'light' : 'dark';
        sync();
      });

      // Contact: copy the email address (shows the address itself when the clipboard is refused).
      const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy]')!;
      const copyLabel = copyBtn.querySelector<HTMLElement>('[data-copy-label]')!;
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(copyBtn.dataset.copy!);
          copyLabel.textContent = 'Copied ✓';
        } catch {
          copyLabel.textContent = copyBtn.dataset.copy!;
        }
        setTimeout(() => (copyLabel.textContent = 'Copy address'), 2200);
      });

      if (!reduce) {
        const lenis = new Lenis();
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((t) => lenis.raf(t * 1000));
        gsap.ticker.lagSmoothing(0);

        // Hero: the star assembles shard by shard, then the headline rises in line by line.
        const dirs = [[0, -1], [-1, -0.35], [1, -0.35], [-0.7, 0.85], [0.7, 0.85]];
        const parts = gsap.utils.toArray<SVGPathElement>('.hero-star .sh');
        gsap.set(parts, { transformOrigin: '50% 50%' });
        const intro = gsap.timeline({ defaults: { ease: 'expo.out' } });
        intro
          .from(parts, { x: (i) => dirs[i][0] * 260, y: (i) => dirs[i][1] * 260, scale: 0.5, opacity: 0, duration: 1.4, stagger: 0.1 }, 0.1)
          .from('.hero-h .in', { yPercent: 110, duration: 1.1, stagger: 0.1 }, 0.5)
          .from('.hero-foot > *', { y: 24, autoAlpha: 0, duration: 0.8, stagger: 0.08 }, 0.9);
        // The star turns slowly on its own; the scroll is handled on its wrapper, so the two never fight.
        gsap.to('.hero-star', { rotation: 360, duration: 80, ease: 'none', repeat: -1 });
        gsap.to('[data-hero-star]', { rotation: 120, scale: 0.88, ease: 'none', scrollTrigger: { trigger: '[data-hero]', start: 'top top', end: 'bottom top', scrub: true } });

        // Red band: drifts, and runs faster while you scroll.
        const band = gsap.to('[data-band]', { xPercent: -50, duration: 28, ease: 'none', repeat: -1 });
        ScrollTrigger.create({
          trigger: '.band', start: 'top bottom', end: 'bottom top',
          onUpdate: (s) => gsap.to(band, { timeScale: 1 + Math.min(Math.abs(s.getVelocity()) / 250, 6), duration: 0.2, overwrite: true, onComplete: () => gsap.to(band, { timeScale: 1, duration: 1.2 }) }),
        });
        // The band's marks spin whole, the star staying in one piece.
        gsap.to('.band .spin', { rotation: 360, transformOrigin: '50% 50%', duration: 10, ease: 'none', repeat: -1 });

        // Section headings and blocks rise in (and sink away again on the way back up).
        gsap.utils.toArray<HTMLElement>('[data-up]').forEach((el) =>
          gsap.from(el, { y: 50, autoAlpha: 0, duration: 1, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 88%', toggleActions: 'play none none reverse' } }),
        );
        // Service columns: the rule draws, the shard spins in, the text follows.
        gsap.utils.toArray<HTMLElement>('[data-col]').forEach((col, i) =>
          gsap.timeline({ scrollTrigger: { trigger: col, start: 'top 85%', toggleActions: 'play none none reverse' }, delay: i * 0.1 })
            .from(col.querySelector('[data-rule]'), { scaleX: 0, transformOrigin: '0 50%', duration: 0.9, ease: 'power3.inOut' })
            .from(col.querySelector('.svc-mark'), { scale: 0, duration: 0.7, ease: 'back.out(2)' }, 0.2)
            .from(col.querySelectorAll('h3, .svc-line, li'), { y: 24, autoAlpha: 0, duration: 0.6, stagger: 0.05 }, 0.35),
        );
        // Process: the steps fill in one after another with the scroll.
        gsap.from('[data-step]', { y: 40, autoAlpha: 0, stagger: 0.15, ease: 'power2.out', scrollTrigger: { trigger: '.steps', start: 'top 80%', end: 'bottom 70%', scrub: 0.6 } });
        // Work: the posters slide sideways while the section holds (desktop; phones get a vertical stack).
        const barH = () => document.querySelector<HTMLElement>('.bar')!.offsetHeight;
        const setBar = () => document.documentElement.style.setProperty('--bar', barH() + 'px');
        setBar();
        addEventListener('resize', setBar);
        gsap.matchMedia().add('(min-width: 768px)', () => {
          const track = document.querySelector<HTMLElement>('[data-track]')!;
          const count = document.querySelector<HTMLElement>('[data-count]')!;
          const dist = () => track.scrollWidth - innerWidth;
          gsap.to(track, {
            x: () => -dist(), ease: 'none',
            scrollTrigger: {
              trigger: '[data-posters]', start: () => 'top ' + barH(), end: () => '+=' + dist(), scrub: 0.8, pin: true, invalidateOnRefresh: true,
              onUpdate: (st) => (count.textContent = '0' + Math.min(3, Math.max(1, Math.round(st.progress * 4 + 0.3)))),
            },
          });
        });

        // Chores: each one is struck through in turn and its hours are added to the counter.
        const chores = gsap.utils.toArray<HTMLElement>('[data-chore]');
        const hoursEl = document.querySelector<HTMLElement>('[data-hours]')!;
        const hours = { n: 0 };
        hoursEl.textContent = '0';
        const ct = gsap.timeline({ scrollTrigger: { trigger: '.chore-list', start: 'top 70%', end: 'bottom 55%', scrub: 0.6 } });
        let total = 0;
        chores.forEach((c, i) => {
          total += Number(c.dataset.hours);
          ct.to(c, { '--strike': 1, duration: 1, ease: 'power2.inOut' }, i)
            .to(c.querySelector('.chore-text'), { color: 'var(--mute)', duration: 0.6 }, i + 0.4)
            .fromTo(c.querySelector('.chore-tag'), { scale: 0.4, autoAlpha: 0 }, { scale: 1, autoAlpha: 1, duration: 0.5, ease: 'back.out(2)' }, i + 0.5)
            .to(hours, { n: total, duration: 0.8, ease: 'none', onUpdate: () => (hoursEl.textContent = String(Math.round(hours.n))) }, i + 0.3);
        });
        // Contact: the address types itself in, letter by letter; the promises follow.
        gsap.from('[data-talk-mail] .ch', { yPercent: 100, autoAlpha: 0, duration: 0.7, stagger: 0.035, ease: 'power3.out', scrollTrigger: { trigger: '[data-talk-mail]', start: 'top 85%', toggleActions: 'play none none reverse' } });
        gsap.from('.talk-promises li, .talk-actions > *', { y: 20, autoAlpha: 0, duration: 0.6, stagger: 0.07, ease: 'power2.out', scrollTrigger: { trigger: '.talk-foot', start: 'top 90%', toggleActions: 'play none none reverse' } });
      }
    </script>

    <style is:global>
      :root {
        --paper: #f1ede4;
        --ink: #121110;
        --red: #e3342a;
        --mute: #6a655d;
        --line: #121110;
        --soft: rgb(18 17 16 / 0.06);
        --blend: multiply;
        --sage: #b7c5a3;
        --sage-ink: #34402b;
        --night: #0b0c0f;
      }
      :root[data-mode='dark'] {
        /* A warm charcoal rather than near-black. */
        --paper: #1f1d1b;
        --ink: #f1ede4;
        --red: #ff4536;
        --mute: #a39d92;
        --line: rgb(241 237 228 / 0.85);
        --soft: rgb(241 237 228 / 0.06);
        --blend: normal;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; }
      body { background: var(--paper); color: var(--ink); font-family: var(--font-hanken); transition: background-color 0.5s, color 0.5s; }
      a { color: inherit; text-decoration: none; }
      em { font-family: var(--font-instrument); font-style: italic; font-weight: 400; letter-spacing: -0.01em; }
      .sh, .glyph { fill: var(--red); }
      /* Spinning marks draw outside their box, so their points are never clipped. */
      svg { overflow: visible; }

      /* ---------- Top bar ---------- */
      .bar {
        position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 2rem;
        padding: 1rem 4vw; background: var(--paper); border-bottom: 1.5px solid var(--line); transition: background-color 0.5s;
      }
      .brand { display: inline-flex; align-items: center; gap: 0.5rem; font: 600 1.1rem var(--font-clash); letter-spacing: -0.02em; }
      .brand-star { width: 1.5rem; height: auto; }
      .nav { margin-left: auto; display: flex; gap: 1.8rem; font-weight: 500; }
      .mode { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.9rem; border: 1.5px solid var(--line); border-radius: 999px; background: none; color: var(--ink); font: 600 0.9rem var(--font-hanken); cursor: pointer; }
      .mode-dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--ink); }

      /* ---------- Hero ---------- */
      .hero { position: relative; min-height: calc(100svh - 4rem); display: flex; flex-direction: column; padding: 0 4vw 2rem; border-bottom: 1.5px solid var(--line); overflow: clip; }
      .hero-stage { position: relative; flex: 1; display: grid; align-items: center; padding: 4vh 0; }
      .hero-star-wrap { position: absolute; right: 3vw; top: 50%; width: min(48vw, 40rem); translate: 0 -50%; mix-blend-mode: var(--blend); }
      .hero-star { display: block; width: 100%; height: auto; }
      .hero-h { position: relative; z-index: 2; margin: 0; font: 600 clamp(3rem, 8.6vw, 8.6rem)/0.92 var(--font-clash); letter-spacing: -0.05em; }
      .ln { display: block; overflow: clip; padding-bottom: 0.06em; }
      .in { display: inline-block; }
      .hero-h em { color: var(--red); }
      .inl { display: inline-block; width: 0.55em; height: auto; vertical-align: 0.06em; }
      .hero-foot { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: 1.5rem 3rem; padding-top: 1.4rem; border-top: 1.5px solid var(--line); }
      .hero-note { margin: 0; max-width: 34rem; font-size: clamp(1.05rem, 1.4vw, 1.3rem); line-height: 1.45; }
      .hero-note em { color: var(--mute); }
      .btn { display: inline-flex; gap: 0.6rem; align-items: center; padding: 0.95rem 1.8rem; border-radius: 999px; background: var(--ink); color: var(--paper); font-weight: 600; white-space: nowrap; transition: transform 0.25s; }
      .btn:hover { transform: translateY(-2px); }
      .btn-red { background: var(--red); color: #fff; }
      .scroll-cue { margin: 0; display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; color: var(--mute); }
      .scroll-cue span { width: 1px; height: 2.4rem; background: var(--ink); animation: cue 1.8s ease-in-out infinite; transform-origin: top; }
      @keyframes cue { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(0); transform-origin: bottom; } }

      /* ---------- Red band ---------- */
      .band { overflow: hidden; background: var(--red); color: #fff; padding: 1.8rem 0; border-bottom: 1.5px solid var(--line); }
      .band-track { display: flex; width: max-content; }
      .band-item { display: inline-flex; align-items: center; gap: 0.6em; padding-right: 0.6em; font: 600 clamp(2rem, 4.5vw, 4rem)/1 var(--font-clash); letter-spacing: -0.04em; white-space: nowrap; }
      .band-item:nth-child(even) { font-family: var(--font-instrument); font-style: italic; font-weight: 400; letter-spacing: -0.01em; }
      .band-star { width: 0.6em; height: auto; }
      .band-star .sh, .band-glyph { fill: #fff; }
      .band-glyph { width: 0.55em; height: auto; }

      /* ---------- Sections ---------- */
      section.svc, section.how { padding: 14svh 4vw; border-bottom: 1.5px solid var(--line); }
      .sec-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr); gap: 1rem 4vw; align-items: end; margin-bottom: 4rem; }
      .sec-no { margin: 0; font-size: 0.95rem; color: var(--mute); }
      .sec-head h2 { margin: 0; font: 600 clamp(2.4rem, 5.2vw, 5rem)/0.98 var(--font-clash); letter-spacing: -0.045em; }
      .sec-head em { color: var(--red); }

      .svc-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem 3vw; }
      .svc-col { position: relative; padding-top: 1.6rem; display: grid; gap: 0.9rem; align-content: start; }
      .rule { position: absolute; left: 0; right: 0; top: 0; height: 1.5px; background: var(--line); }
      .svc-mark { width: 3rem; height: auto; }
      .svc-col h3 { margin: 0; font: 600 clamp(2.4rem, 4vw, 3.8rem)/0.95 var(--font-clash); letter-spacing: -0.045em; }
      .svc-line { margin: 0; font-size: 1.1rem; line-height: 1.45; }
      .svc-col ul { list-style: none; margin: 0.4rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .svc-col li { padding: 0.3rem 0.75rem; border: 1px solid color-mix(in srgb, var(--line) 40%, transparent); border-radius: 999px; font-size: 0.85rem; color: var(--mute); }

      /* ---------- Work: posters ---------- */
      .work { border-bottom: 1.5px solid var(--line); }
      .posters { position: relative; height: calc(100svh - var(--bar, 68px)); overflow: hidden; }
      .poster-track { display: flex; gap: 1.5rem; height: 100%; padding: 2rem 4vw; width: max-content; }
      .poster { position: relative; flex: none; width: min(78vw, 72rem); height: 100%; border-radius: 1.4rem; overflow: hidden; }
      .po-intro { width: min(40vw, 34rem); display: grid; align-content: center; gap: 1.4rem; padding: 0 3vw 0 0; overflow: visible; }
      .po-intro h2 { margin: 0; font: 600 clamp(2.4rem, 5.2vw, 5rem)/0.98 var(--font-clash); letter-spacing: -0.045em; }
      .po-intro em { color: var(--red); }
      .po-hint { margin: 0; font-weight: 600; color: var(--red); }
      .po-media { position: absolute; inset: 0; }
      .po-text { position: absolute; left: 0; right: 0; bottom: 0; padding: 2.4rem 2.6rem; display: grid; gap: 0.6rem; justify-items: start; }
      .po-kind { margin: 0; font-size: 0.95rem; font-weight: 600; }
      .po-text h3 { margin: 0; font: 600 clamp(3rem, 8vw, 8rem)/0.9 var(--font-clash); letter-spacing: -0.05em; }
      .po-line { margin: 0; max-width: 40ch; line-height: 1.5; }
      .po-elsewhere .po-text { color: #fbf8ef; background: linear-gradient(transparent, rgb(20 24 18 / 0.55)); padding-top: 8rem; }
      .po-luna .m-luna { place-items: center end; padding-right: 9%; }
      .po-luna .po-text { top: 0; right: 45%; align-content: end; color: var(--sage-ink); }
      .po-jarvis .m-term { padding: 3.5% 4% 0; font-size: clamp(0.8rem, 1.15vw, 1.1rem); }
      .po-jarvis .po-text { color: #f1ede4; }
      :root[data-mode='dark'] .po-jarvis, :root[data-mode='dark'] .po-next { box-shadow: inset 0 0 0 1.5px rgb(241 237 228 / 0.18); }
      .po-next { width: min(48vw, 40rem); background: #121110; color: #f1ede4; display: grid; align-content: center; justify-items: start; gap: 1.6rem; padding: 3rem; }
      .po-next h3 { margin: 0; font: 600 clamp(2.6rem, 5vw, 5rem)/0.95 var(--font-clash); letter-spacing: -0.045em; }
      .po-star { width: 5rem; height: auto; }
      .po-star .sh { fill: var(--red); }
      .po-btn { display: inline-flex; padding: 0.95rem 1.5rem; border-radius: 999px; background: #f1ede4; color: #121110; font-weight: 600; transition: transform 0.25s; }
      .po-btn:hover { transform: translateY(-2px); }
      .po-count { position: absolute; right: 4vw; top: 2.6rem; margin: 0; padding: 0.4rem 0.8rem; border-radius: 999px; background: var(--paper); font-weight: 600; font-variant-numeric: tabular-nums; }
      /* Project visuals (from src/data/work.ts). Each project keeps its own colours in both modes. */
      .m-shot { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
      .m-luna { width: 100%; height: 100%; display: grid; place-items: center; background: var(--sage); }
      .m-phone { height: 86%; width: auto; filter: drop-shadow(0 1rem 1.4rem rgb(52 64 43 / 0.35)); }
      .m-term { width: 100%; height: 100%; padding: 4% 5%; display: grid; align-content: start; gap: 0.7em; background: var(--night); color: #d6dae6; font: 400 clamp(0.7rem, 1vw, 1rem)/1.45 ui-monospace, 'Cascadia Code', Consolas, monospace; }
      .m-bar { margin: 0 0 0.8em; display: flex; align-items: center; gap: 0.45em; color: #6d7385; font-size: 0.85em; }
      .m-bar span { width: 0.7em; height: 0.7em; border-radius: 50%; border: 1.5px solid #3a3f4b; }
      .m-bar span:first-child { background: var(--red); border-color: var(--red); }
      .m-bar em { margin-left: auto; font: inherit; font-style: normal; }
      .tl { margin: 0; }
      .tl.acc { color: #ff8a80; }
      .tl.ok { color: #9fe0a8; }
      .tl.dim { color: #5b6276; }
      .caret { display: inline-block; width: 0.6em; height: 1.1em; vertical-align: -0.2em; background: #d6dae6; animation: blink 1s steps(1) infinite; }
      @keyframes blink { 50% { opacity: 0; } }

      .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1.5px solid var(--line); }
      .step { padding: 1.6rem 1.4rem 2rem 0; display: grid; gap: 0.6rem; align-content: start; border-right: 1px solid color-mix(in srgb, var(--line) 25%, transparent); }
      .step + .step { padding-left: 1.4rem; }
      .step:last-child { border-right: 0; }
      .step-n { display: inline-flex; align-items: center; gap: 0.55rem; font: 500 0.95rem var(--font-hanken); color: var(--red); }
      .step-mark { width: 1.4rem; height: auto; }
      .step h3 { margin: 0; font: 600 clamp(1.8rem, 2.6vw, 2.6rem)/1 var(--font-clash); letter-spacing: -0.035em; }
      .step p { margin: 0; color: var(--mute); line-height: 1.45; }

      /* ---------- Chores ---------- */
      .chores { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 3rem 6vw; padding: 14svh 4vw; border-bottom: 1.5px solid var(--line); }
      .chores-side { align-self: start; position: sticky; top: calc(var(--bar, 68px) + 8svh); display: grid; gap: 1.4rem; }
      .chores-side h2 { margin: 0; font: 600 clamp(2.4rem, 5vw, 4.8rem)/0.98 var(--font-clash); letter-spacing: -0.045em; }
      .chores-side em { color: var(--red); }
      .chores-count { margin: 1rem 0 0; display: flex; align-items: center; gap: 1rem; }
      .chores-n { font: 600 clamp(5rem, 11vw, 10rem)/0.85 var(--font-clash); letter-spacing: -0.06em; color: var(--red); font-variant-numeric: tabular-nums; }
      .chores-unit { font-weight: 600; font-size: 1.1rem; line-height: 1.25; }
      .chores-note { margin: 0; max-width: 30ch; font-size: 0.9rem; line-height: 1.45; color: var(--mute); }
      .chore-list { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--line); }
      .chore { --strike: 0; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 1rem 2rem; padding: 2rem 0; border-bottom: 1px solid color-mix(in srgb, var(--line) 25%, transparent); }
      .chore-task { font: 600 clamp(1.4rem, 2.4vw, 2.3rem)/1.15 var(--font-clash); letter-spacing: -0.03em; }
      .chore-text { position: relative; }
      /* The red line drawn through each chore; one line per row of text. */
      .chore-text { background: linear-gradient(var(--red), var(--red)) no-repeat 0 54% / calc(var(--strike) * 100%) 0.12em; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
      .chore-meta { display: grid; justify-items: end; gap: 0.35rem; }
      .chore-tag { padding: 0.3rem 0.8rem; border-radius: 999px; background: var(--red); color: #fff; font-size: 0.85rem; font-weight: 600; }
      .chore-time { font-size: 0.85rem; color: var(--mute); white-space: nowrap; }

      /* ---------- Contact: the address is the centrepiece ---------- */
      .talk { padding: 16svh 4vw 14svh; border-bottom: 1.5px solid var(--line); }
      .talk-top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr); gap: 1rem 4vw; align-items: end; }
      .talk-h { margin: 0; font: 600 clamp(2rem, 3.6vw, 3.4rem)/1 var(--font-clash); letter-spacing: -0.04em; }
      .talk-h em { color: var(--red); }
      .talk-mail { display: block; margin: 7svh 0 6svh; padding-bottom: 0.08em; overflow: hidden; white-space: nowrap; font: 600 clamp(2rem, 8.6vw, 12rem)/1.05 var(--font-clash); letter-spacing: -0.055em; border-bottom: 1.5px solid var(--line); }
      .ch { display: inline-block; transition: color 0.3s; }
      .talk-mail:hover .ch { color: var(--red); }
      .talk-mail .at { color: var(--red); font: italic 400 1.02em/1 var(--font-instrument); letter-spacing: 0; padding: 0 0.04em; }
      .talk-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.6rem 3rem; }
      .talk-promises { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.8rem 2.6rem; font-weight: 600; font-size: 1.05rem; }
      .talk-promises li { display: inline-flex; align-items: center; gap: 0.6rem; }
      .pm { width: 1.2rem; height: auto; }
      .talk-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }
      .pill-btn { display: inline-flex; align-items: center; padding: 0.85rem 1.4rem; border: 1.5px solid var(--line); border-radius: 999px; background: none; color: var(--ink); font: 600 1rem var(--font-hanken); cursor: pointer; transition: background-color 0.25s, color 0.25s; }
      .pill-btn:hover { background: var(--ink); color: var(--paper); }
      .link { font-weight: 600; text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: 0.3em; }
      .foot { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.6rem 4vw; font-size: 0.9rem; color: var(--mute); }

      /* ---------- Phones ---------- */
      @media (max-width: 767px) {
        .nav { display: none; }
        .mode { margin-left: auto; }
          .hero-stage { align-items: end; }
        .hero-star-wrap { top: 30%; right: 6vw; width: 80vw; }
        .hero-h { font-size: 12.5vw; }
        .hero { padding-bottom: 3.5rem; }
        .hero-foot { grid-template-columns: minmax(0, 1fr); }
        .scroll-cue { display: none; }
        .sec-head { grid-template-columns: minmax(0, 1fr); }
        .svc-grid { grid-template-columns: minmax(0, 1fr); }
        .posters { height: auto; overflow: visible; }
        .poster-track { flex-direction: column; width: auto; padding: 0 4vw 4rem; gap: 1.2rem; }
        .poster { width: 100%; height: auto; aspect-ratio: 3 / 4.4; }
        .po-intro, .po-next { width: 100%; aspect-ratio: auto; padding: 14svh 0 2rem; }
        .po-next { padding: 2.4rem 1.6rem; }
        .po-count { display: none; }
        .po-text { padding: 1.6rem; }
        .po-luna { aspect-ratio: 3 / 5.3; }
        .po-luna .m-luna { place-items: start center; padding: 8% 0 0; }
        .po-luna .m-phone { height: 50%; }
        .po-luna .po-text { right: 0; top: auto; }
        .po-jarvis .m-term { font-size: 0.72rem; }
        .steps { grid-template-columns: minmax(0, 1fr); }
        .step, .step + .step { padding: 1.4rem 0; border-right: 0; border-bottom: 1px solid color-mix(in srgb, var(--line) 25%, transparent); }
        .chores, .talk { grid-template-columns: minmax(0, 1fr); }
        /* The side column dissolves so the counter can stick under the bar while the list scrolls. */
        .chores { gap: 1.6rem; }
        .chores-side { display: contents; }
        .chores-side > .sec-no, .chores-side > h2 { margin: 0; }
        .chores-count { position: sticky; top: var(--bar, 68px); z-index: 3; align-self: start; margin: 0 -4vw; padding: 0.8rem 4vw; background: var(--paper); border-bottom: 1.5px solid var(--line); transition: background-color 0.5s; }
        .chores-n { font-size: 3.6rem; }
        .chores-unit { font-size: 1rem; }
        .chores-note { order: 5; }
        .chore { grid-template-columns: minmax(0, 1fr); gap: 0.8rem; padding: 1.4rem 0; }
        .chore-meta { grid-auto-flow: column; justify-content: start; align-items: center; gap: 0.8rem; }
        .talk-top { grid-template-columns: minmax(0, 1fr); }
        .talk-mail { font-size: 8.7vw; letter-spacing: -0.05em; }
        .foot { flex-direction: column; align-items: flex-start; }
      }
      @media (prefers-reduced-motion: reduce) {
        .scroll-cue span, .caret { animation: none; }
        .ch, .pill-btn { transition: none; }
        .chore { --strike: 1; }
        /* Without the scroll-driven slide, the posters scroll sideways by hand. */
        .posters { overflow-x: auto; }
      }
    </style>
  </body>
</html>
