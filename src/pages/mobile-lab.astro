---
// Phone concepts, round 2 (ticket 14): three completely different takes on the same content.
// Hidden (noindex), not linked. Built for a phone. Open one alone with /mobile-lab/#a, #b or #c.
import '../styles/global.css';
import { Font } from 'astro:assets';
import { site } from '../data/content';

const { lines, cta } = site.hero;
const services = site.services.items;
const { build, automate, ai } = site.interludes;

// Finished-state demos for the sketches (on the real site they animate).
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
function demoHtml(kind: string) {
  if (kind === 'build')
    return `<div class="m"><div class="m-nav"><span class="m-logo">${esc(build.demoBusiness)}</span><span>Services · Book</span></div>
      <p class="m-h">${esc(build.demoHeadline)}</p><span class="m-btn">${esc(build.demoButton)}</span><div class="m-img"></div></div>`;
  if (kind === 'automate')
    return `<div class="flow">${automate.steps.map((s) => `<span class="flow-dot"></span><span>${esc(s)}</span>`).join('')}</div>
      <div class="mail"><b>${esc(automate.email.subject)}</b>${esc(automate.email.greeting)} ${esc(automate.email.body)}</div>`;
  return `<div class="chat"><p class="bub them">${esc(ai.question)}</p><p class="bub bot">${esc(ai.answer)}</p></div>`;
}
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Mobile lab — ShainyDev</title>
    <Font cssVariable="--font-clash" preload />
    <Font cssVariable="--font-hanken" preload />
    <Font cssVariable="--font-instrument" preload />
  </head>
  <body>
    <main class="phone">
      <!-- ======================= A. MESSAGES ======================= -->
      <div class="concept" id="a">
        <section class="sk a-hero">
          <p class="tag">A · Messages</p>
          <header class="a-top">
            <span class="a-avatar glass-orb" aria-hidden="true"></span>
            <span class="a-who"><b>Shainy</b><small>online · replies within 48h</small></span>
          </header>
          <div class="a-thread">
            {lines.map((l, i) => (
              <p class:list={['a-bub', { 'a-it': l.italic }]} style={`--d:${0.5 + i * 0.75}s`}>{l.text}</p>
            ))}
          </div>
          <div class="a-replies" style={`--d:${0.6 + lines.length * 0.75}s`}>
            <a class="a-reply a-reply-main" href="#">{cta}</a>
            <a class="a-reply" href="#a-stories">What do you do?</a>
          </div>
        </section>

        <section class="sk a-stories" id="a-stories" data-stories>
          <div class="a-bars">
            {services.map(() => <span class="a-bar"><span class="a-bar-fill"></span></span>)}
          </div>
          {services.map((item, i) => (
            <article class:list={['a-story', { on: i === 0 }]}>
              <p class="a-kicker">What I can do for you</p>
              <p class="word">{item.name}</p>
              <p class="sum">{item.summary}</p>
              <div class="demo" set:html={demoHtml(item.interlude)} />
            </article>
          ))}
          <button class="a-tap a-tap-prev" aria-label="Previous service"></button>
          <button class="a-tap a-tap-next" aria-label="Next service"></button>
          <p class="a-hint">Tap to continue</p>
        </section>
      </div>

      <!-- ======================= B. POSTER ======================= -->
      <div class="concept" id="b">
        <section class="sk b-hero">
          <p class="tag">B · Poster</p>
          <p class="b-mark">ShainyDev</p>
          <h1 class="b-poster">
            <span class="b-w b-w1">Websites,</span>
            <span class="b-w b-w2">apps <em>&amp;</em></span>
            <span class="b-w b-w3">automations</span>
            <span class="b-w4">that do the work <em>for you.</em></span>
          </h1>
          <svg class="b-ribbon" viewBox="0 0 400 300" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="rib" x1="0" x2="1">
                <stop offset="0" stop-color="#2f5bff" stop-opacity="0" />
                <stop offset="0.35" stop-color="#709bff" />
                <stop offset="0.7" stop-color="#8ef0ff" />
                <stop offset="1" stop-color="#8a6bff" stop-opacity="0" />
              </linearGradient>
              <filter id="ribblur" x="-20%" y="-60%" width="140%" height="220%"><feGaussianBlur stdDeviation="6" /></filter>
            </defs>
            <path d="M-20 210 C 80 120, 160 260, 250 170 S 380 110, 430 150" stroke="url(#rib)" stroke-width="26" fill="none" filter="url(#ribblur)" opacity="0.7" />
            <path d="M-20 210 C 80 120, 160 260, 250 170 S 380 110, 430 150" stroke="url(#rib)" stroke-width="3" fill="none" />
          </svg>
          <span class="b-orb glass-orb" aria-hidden="true"></span>
          <a class="b-cta" href="#">{cta} <span aria-hidden="true">→</span></a>
        </section>

        <section class="sk b-svc">
          <p class="b-kicker">What I can do for you</p>
          <ul class="b-list">
            {services.map((item, i) => (
              <li>
                <button class="b-item" data-sheet-open={i}>
                  <span class="b-item-word">{item.name}</span>
                  <span class="b-item-sum">{item.summary}</span>
                </button>
              </li>
            ))}
          </ul>
          <p class="b-hint">Tap a service</p>
          <dialog class="b-sheet" data-sheet>
            <span class="b-grab" aria-hidden="true"></span>
            {services.map((item, i) => (
              <div class="b-sheet-body" data-sheet-body={i} hidden>
                <p class="word">{item.name}</p>
                <p class="sum">{item.summary}</p>
                <p class="desc">{item.description}</p>
                <div class="demo" set:html={demoHtml(item.interlude)} />
              </div>
            ))}
            <form method="dialog"><button class="b-close">Close</button></form>
          </dialog>
        </section>
      </div>

      <!-- ======================= C. ORB INTERFACE ======================= -->
      <div class="concept" id="c">
        <section class="sk c-hero">
          <p class="tag">C · Orb interface</p>
          <p class="c-mark">ShainyDev</p>
          <div class="c-stage" aria-hidden="true">
            <span class="c-ring"></span><span class="c-ring"></span><span class="c-ring"></span>
            <span class="c-orb glass-orb"></span>
          </div>
          <h1 class="c-hl">
            {lines.map((l) => <span class:list={['c-l', { 'c-it': l.italic }]}>{l.text}</span>)}
          </h1>
          <a class="c-cta" href="#">{cta}</a>
        </section>

        <section class="sk c-svc" data-orbs>
          <p class="c-kicker">What I can do for you</p>
          <div class="c-picker" role="tablist">
            {services.map((item, i) => (
              <button class:list={['c-pick', { on: i === 0 }]} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-pick={i}>
                <span class="c-pick-orb glass-orb" aria-hidden="true"></span>
                <span class="c-pick-label">{item.name}</span>
              </button>
            ))}
          </div>
          {services.map((item, i) => (
            <article class="c-panel" data-panel={i} hidden={i !== 0}>
              <p class="sum">{item.summary}</p>
              <p class="desc">{item.description}</p>
              <div class="demo" set:html={demoHtml(item.interlude)} />
            </article>
          ))}
        </section>
      </div>
    </main>

    <script is:inline>
      const only = location.hash.slice(1);
      if (['a', 'b', 'c'].includes(only)) document.querySelectorAll('.concept').forEach((el) => { if (el.id !== only) el.hidden = true; });
    </script>

    <script>
      // ---- A: stories. Tap left/right; each story runs 6s, then moves on. ----
      const stories = document.querySelector<HTMLElement>('[data-stories]');
      if (stories) {
        const items = [...stories.querySelectorAll<HTMLElement>('.a-story')];
        const bars = [...stories.querySelectorAll<HTMLElement>('.a-bar')];
        let index = 0;
        let timer = 0;
        const show = (i: number) => {
          index = (i + items.length) % items.length;
          items.forEach((el, k) => el.classList.toggle('on', k === index));
          bars.forEach((bar, k) => {
            bar.classList.toggle('done', k < index);
            bar.classList.remove('run');
            void bar.offsetWidth;
            if (k === index) bar.classList.add('run');
          });
          clearTimeout(timer);
          timer = window.setTimeout(() => show(index + 1), 6000);
        };
        stories.querySelector('.a-tap-next')!.addEventListener('click', () => show(index + 1));
        stories.querySelector('.a-tap-prev')!.addEventListener('click', () => show(index - 1));
        show(0);
      }

      // ---- B: bottom sheet. ----
      const sheet = document.querySelector<HTMLDialogElement>('[data-sheet]');
      document.querySelectorAll<HTMLElement>('[data-sheet-open]').forEach((button) => {
        button.addEventListener('click', () => {
          const i = button.dataset.sheetOpen;
          sheet!.querySelectorAll<HTMLElement>('[data-sheet-body]').forEach((b) => (b.hidden = b.dataset.sheetBody !== i));
          sheet!.showModal();
        });
      });
      sheet?.addEventListener('click', (e) => { if (e.target === sheet) sheet.close(); });

      // ---- C: orb picker; cycles on its own until tapped. ----
      const orbs = document.querySelector<HTMLElement>('[data-orbs]');
      if (orbs) {
        const picks = [...orbs.querySelectorAll<HTMLButtonElement>('[data-pick]')];
        const panels = [...orbs.querySelectorAll<HTMLElement>('[data-panel]')];
        let current = 0;
        const select = (i: number) => {
          current = i;
          picks.forEach((p, k) => { p.classList.toggle('on', k === i); p.setAttribute('aria-selected', String(k === i)); });
          panels.forEach((p, k) => (p.hidden = k !== i));
        };
        const auto = window.setInterval(() => select((current + 1) % picks.length), 5000);
        picks.forEach((p, i) => p.addEventListener('click', () => { clearInterval(auto); select(i); }));
      }
    </script>

    <style is:global>
      * { box-sizing: border-box; }
      body { margin: 0; background: #2a2d36; color: var(--color-fg); font-family: var(--font-body); }
      .phone { max-width: 430px; margin: 0 auto; background: var(--color-bg); }
      .sk { position: relative; min-height: 100svh; overflow: clip; border-bottom: 1px dashed var(--color-line); }
      .tag {
        position: absolute; right: 0.6rem; bottom: 0.6rem; z-index: 9; margin: 0;
        font-size: 0.7rem; padding: 0.25rem 0.5rem; border-radius: 0.35rem; background: rgb(255 255 255 / 0.12);
      }
      .word {
        margin: 0; font-family: var(--font-clash); font-weight: 600; letter-spacing: -0.05em; line-height: 0.9; font-size: 3.6rem;
        background: var(--light-fill); -webkit-background-clip: text; background-clip: text; color: transparent; justify-self: start; padding-right: 0.06em;
      }
      .sum { margin: 0; font-family: var(--font-serif); font-style: italic; font-size: 1.7rem; line-height: 1.05; }
      .desc { margin: 0; font-size: 1rem; line-height: 1.5; color: color-mix(in srgb, var(--color-fg) 82%, transparent); }
      .demo { margin-top: 0.4rem; }

      /* ---------- A: Messages ---------- */
      .a-hero { display: flex; flex-direction: column; padding: 1rem 5vw 2rem; }
      .a-top { display: flex; align-items: center; gap: 0.7rem; padding: 0.4rem 0 1rem; border-bottom: 1px solid var(--color-line); }
      .a-avatar { width: 2.6rem; height: 2.6rem; font-size: 16rem; flex: none; }
      .a-who { display: grid; line-height: 1.2; }
      .a-who b { font-family: var(--font-clash); font-weight: 600; font-size: 1.1rem; }
      .a-who small { color: var(--color-accent); font-size: 0.8rem; }
      .a-thread { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; gap: 0.5rem; padding: 2rem 0 1rem; }
      .a-bub {
        margin: 0; align-self: flex-start; max-width: 92%; padding: 0.6rem 1rem; border-radius: 1.4rem; border-bottom-left-radius: 0.4rem;
        background: color-mix(in srgb, var(--color-fg) 9%, transparent);
        font-family: var(--font-clash); font-weight: 500; letter-spacing: -0.03em; font-size: 2rem; line-height: 1.05;
        opacity: 0; transform: translateY(14px) scale(0.96); transform-origin: 0 100%;
        animation: pop 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.2) forwards var(--d);
      }
      .a-it { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.01em; font-size: 2.2rem; }
      .a-replies { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: flex-end; opacity: 0; transform: translateY(10px); animation: pop 0.4s forwards var(--d); }
      .a-reply { padding: 0.75rem 1.2rem; border-radius: 999px; border: 1.5px solid var(--color-accent); color: var(--color-accent); text-decoration: none; font-weight: 600; }
      .a-reply-main { background: var(--color-accent); color: var(--color-on-accent); }
      @keyframes pop { to { opacity: 1; transform: none; } }

      .a-stories { padding: 1rem 5vw 2rem; }
      .a-bars { display: flex; gap: 0.35rem; }
      .a-bar { flex: 1; height: 3px; border-radius: 3px; background: color-mix(in srgb, var(--color-fg) 18%, transparent); overflow: hidden; }
      .a-bar-fill { display: block; height: 100%; width: 0; background: var(--color-fg); }
      .a-bar.done .a-bar-fill { width: 100%; }
      .a-bar.run .a-bar-fill { animation: fill 6s linear forwards; }
      @keyframes fill { to { width: 100%; } }
      .a-story { display: none; gap: 0.9rem; padding-top: 1.6rem; }
      .a-story.on { display: grid; animation: pop 0.4s forwards; opacity: 0; transform: translateY(10px); }
      .a-kicker { margin: 0; font-family: var(--font-serif); font-style: italic; color: var(--color-muted); font-size: 1.1rem; }
      .a-tap { position: absolute; top: 0; bottom: 0; width: 35%; border: 0; background: none; z-index: 2; }
      .a-tap-prev { left: 0; }
      .a-tap-next { right: 0; width: 65%; }
      .a-hint { position: absolute; left: 0; right: 0; bottom: 1.2rem; text-align: center; margin: 0; font-size: 0.8rem; color: var(--color-muted); }

      /* ---------- B: Poster ---------- */
      .b-hero { display: flex; flex-direction: column; padding: 1rem 5vw 1.5rem; }
      .b-mark, .c-mark { margin: 0; font-family: var(--font-clash); font-weight: 600; letter-spacing: -0.02em; font-size: 1.05rem; }
      .b-poster { margin: 6svh 0 0; font-family: var(--font-clash); font-weight: 600; letter-spacing: -0.055em; line-height: 0.86; position: relative; z-index: 2; }
      .b-w { display: block; white-space: nowrap; }
      .b-w1, .b-w2 { font-size: min(18vw, 5rem); }
      .b-w2 em { font-family: var(--font-serif); font-weight: 400; letter-spacing: 0; }
      .b-w3 { font-size: min(14.2vw, 3.9rem); background: var(--light-fill); -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: 0.06em; }
      .b-w4 { display: block; margin-top: 1rem; font-family: var(--font-hanken); font-weight: 500; letter-spacing: 0; font-size: 1.2rem; line-height: 1.3; }
      .b-w4 em { font-family: var(--font-serif); font-size: 1.35em; }
      .b-ribbon { position: absolute; left: 0; right: 0; bottom: 6svh; width: 100%; height: 42svh; z-index: 0; }
      .b-orb { position: absolute; right: 18%; bottom: calc(6svh + 22svh); width: 3.6rem; height: 3.6rem; font-size: 22.5rem; z-index: 1; }
      .b-cta {
        margin-top: auto; position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: center;
        padding: 1.1rem 1.4rem; border-radius: 1rem; background: var(--color-fg); color: var(--color-bg); text-decoration: none;
        font-weight: 600; font-size: 1.15rem;
      }
      .b-svc { padding: 3rem 5vw 2rem; }
      .b-kicker, .c-kicker { margin: 0 0 1rem; font-family: var(--font-serif); font-style: italic; color: var(--color-muted); font-size: 1.4rem; }
      .b-list { list-style: none; margin: 0; padding: 0; }
      .b-item {
        width: 100%; display: grid; gap: 0.2rem; text-align: left; padding: 1rem 0; border: 0; border-top: 1px solid var(--color-line);
        background: none; color: inherit; cursor: pointer;
      }
      .b-list li:last-child .b-item { border-bottom: 1px solid var(--color-line); }
      .b-item-word { font-family: var(--font-clash); font-weight: 600; letter-spacing: -0.05em; font-size: 3.6rem; line-height: 0.95; }
      .b-item:active .b-item-word { background: var(--light-fill); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .b-item-sum { font-family: var(--font-serif); font-style: italic; font-size: 1.2rem; color: var(--color-muted); }
      .b-hint { margin: 1rem 0 0; font-size: 0.8rem; color: var(--color-muted); }
      .b-sheet {
        position: fixed; inset: auto 0 0 0; margin: 0 auto; width: 100%; max-width: 430px; max-height: 88svh; overflow: auto;
        border: 0; border-radius: 1.6rem 1.6rem 0 0; padding: 0.8rem 5vw 1.5rem; background: color-mix(in srgb, var(--color-fg) 6%, var(--color-bg)); color: inherit;
      }
      .b-sheet[open] { animation: up 0.35s cubic-bezier(0.2, 0.9, 0.3, 1); }
      .b-sheet::backdrop { background: rgb(0 0 0 / 0.55); }
      @keyframes up { from { transform: translateY(100%); } }
      .b-grab { display: block; width: 2.6rem; height: 4px; border-radius: 4px; margin: 0 auto 1rem; background: var(--color-muted); }
      .b-sheet-body { display: grid; gap: 0.8rem; }
      .b-close { margin-top: 1rem; width: 100%; padding: 0.9rem; border-radius: 0.8rem; border: 1px solid var(--color-line); background: none; color: inherit; font-weight: 600; }

      /* ---------- C: Orb interface ---------- */
      .c-hero { display: flex; flex-direction: column; align-items: center; padding: 1rem 5vw 2rem; text-align: center; }
      .c-mark { align-self: flex-start; }
      .c-stage { position: relative; width: 62vw; max-width: 16rem; aspect-ratio: 1; margin: 7svh 0 4svh; display: grid; place-items: center; }
      .c-orb { width: 46%; height: 46%; font-size: min(46vw, 46rem); max-width: 7.4rem; max-height: 7.4rem; }
      .c-ring {
        position: absolute; inset: 27%; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--color-accent) 70%, transparent);
        animation: ripple 3.6s ease-out infinite;
      }
      .c-ring:nth-child(2) { animation-delay: 1.2s; }
      .c-ring:nth-child(3) { animation-delay: 2.4s; }
      @keyframes ripple { from { transform: scale(1); opacity: 0.8; } to { transform: scale(2.3); opacity: 0; } }
      .c-hl { margin: 0; font-family: var(--font-clash); font-weight: 500; letter-spacing: -0.035em; line-height: 1; font-size: 2.5rem; }
      .c-l { display: block; }
      .c-it { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.01em; font-size: 1.12em; color: color-mix(in srgb, var(--color-fg) 80%, var(--color-accent)); }
      .c-cta { margin-top: 2rem; padding: 0.9rem 2rem; border-radius: 999px; background: var(--color-accent); color: var(--color-on-accent); text-decoration: none; font-weight: 600; }
      .c-svc { padding: 3rem 5vw 2rem; }
      .c-picker { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin-bottom: 1.6rem; }
      .c-pick { display: grid; justify-items: center; gap: 0.6rem; padding: 0.8rem 0; border: 0; background: none; color: var(--color-muted); cursor: pointer; }
      .c-pick-orb { width: 2.2rem; height: 2.2rem; font-size: 14rem; filter: grayscale(1) brightness(0.55); transition: transform 0.4s cubic-bezier(0.3, 1.6, 0.5, 1), filter 0.4s; }
      .c-pick.on .c-pick-orb { transform: scale(1.5); filter: none; }
      .c-pick-label { font-family: var(--font-clash); font-weight: 600; letter-spacing: -0.02em; font-size: 1.1rem; }
      .c-pick.on .c-pick-label { color: var(--color-fg); }
      .c-panel { display: grid; gap: 0.8rem; animation: pop 0.4s forwards; opacity: 0; transform: translateY(10px); }

      /* ---------- Demos (finished state) ---------- */
      .m { border: 1px solid var(--color-line); border-radius: 0.9rem; padding: 0.9rem; background: color-mix(in srgb, var(--color-fg) 3%, transparent); display: grid; gap: 0.6rem; }
      .m-nav { display: flex; justify-content: space-between; font-size: 0.75rem; }
      .m-logo { font-family: var(--font-serif); font-style: italic; font-size: 0.95rem; }
      .m-h { margin: 0; font-family: var(--font-clash); font-weight: 600; letter-spacing: -0.03em; font-size: 1.3rem; }
      .m-btn { justify-self: start; padding: 0.35rem 0.75rem; border-radius: 999px; background: var(--color-accent); color: var(--color-on-accent); font-size: 0.72rem; font-weight: 600; }
      .m-img { height: 4.5rem; border-radius: 0.5rem; background: var(--light-fill); }
      .flow { display: grid; grid-template-columns: auto 1fr; gap: 0.5rem 0.8rem; align-items: center; font-family: var(--font-clash); font-weight: 500; font-size: 0.95rem; }
      .flow-dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--color-accent); }
      .mail { margin-top: 0.6rem; border: 1px solid var(--color-line); border-radius: 0.7rem; padding: 0.7rem; font-size: 0.85rem; }
      .mail b { display: block; font-family: var(--font-clash); font-size: 0.95rem; margin-bottom: 0.2rem; }
      .chat { display: grid; gap: 0.5rem; }
      .bub { margin: 0; max-width: 85%; padding: 0.6rem 0.85rem; border-radius: 1rem; font-size: 0.95rem; line-height: 1.35; }
      .them { justify-self: end; background: var(--color-accent); color: var(--color-on-accent); border-bottom-right-radius: 0.3rem; }
      .bot { justify-self: start; background: color-mix(in srgb, var(--color-fg) 9%, transparent); border-bottom-left-radius: 0.3rem; }

      @media (prefers-reduced-motion: reduce) {
        .a-bub, .a-replies, .a-story.on, .c-panel { animation: none; opacity: 1; transform: none; }
        .c-ring { animation: none; opacity: 0; }
      }
    </style>
  </body>
</html>
