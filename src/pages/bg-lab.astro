---
// Ticket 05: backgrounds with sketch A's vibe (full-bleed light behind glass) without its reeds.
// Hidden (noindex), not linked. Open one alone with /bg-lab/#1, #2 or #3.
import '../styles/global.css';
import { Font } from 'astro:assets';

const nav = ['Services', 'Work', 'Process', 'About'];
const variants = [
  { id: '1', name: '1. Flowing ribbed glass', bg: 'flow' },
  { id: '2', name: '2. Ripple glass', bg: 'ripple' },
  { id: '3', name: '3. Water caustics', bg: 'caustics' },
];
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Background lab — ShainyDev</title>
    <Font cssVariable="--font-clash" preload />
    <Font cssVariable="--font-hanken" preload />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" />
  </head>
  <body>
    {variants.map((variant) => (
      <section class={`sketch bg-${variant.bg}`} id={`v${variant.id}`} data-bg={variant.bg}>
        <div class="light" aria-hidden="true"></div>
        <canvas class="glass" aria-hidden="true"></canvas>

        <p class="tag">{variant.name}</p>
        <p class="mark">ShainyDev</p>

        <h1 class="headline">
          <span class="l l1">Websites, apps</span>
          <span class="l l2 it">&amp; automations</span>
          <span class="l l3">that do the work</span>
          <span class="l l4"><span class="it">for you.</span><a class="pill" href="#">Let's talk</a></span>
        </h1>

        <p class="note note-left">Hi, I'm Shainy. A freelance developer<br />for small businesses.</p>
        <p class="note note-right">Websites, automation and AI,<br />built to save you time.</p>

        <nav class="bottom-nav">
          {nav.map((item) => <a href="#">{item}</a>)}
          <a href="#">Let's talk ↗</a>
        </nav>
      </section>
    ))}

    <script is:inline>
      const only = location.hash.slice(1);
      if (['1', '2', '3'].includes(only)) {
        document.querySelectorAll('.sketch').forEach((el) => { if (el.id !== 'v' + only) el.hidden = true; });
      }
    </script>

    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const MODES: Record<string, number> = { flow: 0, ripple: 1, caustics: 2 };

      const vert = `attribute vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }`;
      const frag = `
        precision highp float;
        uniform vec2 res;
        uniform float t;
        uniform float dpr;
        uniform int mode;

        // The light behind the glass: one cobalt family with a few soft, slowly drifting glows.
        vec3 light(vec2 px) {
          vec2 uv = px / res;
          float a = res.x / res.y;
          vec3 col = mix(vec3(0.04, 0.12, 0.48), vec3(0.016, 0.063, 0.25), smoothstep(0.0, 0.45, uv.x));
          col = mix(col, vec3(0.043, 0.14, 0.56), smoothstep(0.45, 1.0, uv.x));
          vec2 q = vec2(uv.x * a, uv.y);
          vec2 c1 = vec2((0.12 + 0.04 * sin(t * 0.11)) * a, 0.78 + 0.05 * cos(t * 0.09));
          vec2 c2 = vec2((0.88 + 0.03 * cos(t * 0.08)) * a, 0.32 + 0.06 * sin(t * 0.12));
          vec2 c3 = vec2((0.62 + 0.05 * sin(t * 0.07)) * a, 0.9);
          vec2 c4 = vec2((0.36 + 0.04 * cos(t * 0.1)) * a, 0.12);
          col += vec3(0.62, 0.74, 1.0) * exp(-dot(q - c1, q - c1) / 0.035);
          col += vec3(0.68, 0.8, 1.0) * exp(-dot(q - c2, q - c2) / 0.04);
          col += vec3(0.16, 0.3, 1.0) * 0.8 * exp(-dot(q - c3, q - c3) / 0.06);
          col += vec3(0.29, 0.43, 1.0) * 0.6 * exp(-dot(q - c4, q - c4) / 0.05);
          return col;
        }

        // Shading across one glass rib: a bright lip, a soft body, a dark fold, a bright edge.
        vec4 rib(float f) {
          vec3 white = vec3(1.0);
          vec3 dark = vec3(0.0, 0.024, 0.16);
          if (f < 0.12) return vec4(white, mix(0.22, 0.04, f / 0.12));
          if (f < 0.6) return vec4(mix(white, dark, smoothstep(0.12, 0.6, f)), mix(0.04, 0.26, (f - 0.12) / 0.48));
          if (f < 0.88) return vec4(dark, mix(0.26, 0.45, (f - 0.6) / 0.28));
          return vec4(mix(dark, white, (f - 0.88) / 0.12), mix(0.45, 0.16, (f - 0.88) / 0.12));
        }

        void main() {
          vec2 px = gl_FragCoord.xy / dpr;
          vec2 size = res / dpr;
          vec3 col;

          if (mode == 2) {
            // Caustics: a domain-warped field whose zero-crossings become filaments of light.
            vec2 p = px / size.y * 3.2;
            float v = 0.0;
            for (int k = 0; k < 4; k++) {
              float fk = float(k);
              p += 0.42 * vec2(sin(p.y * 1.3 + t * 0.35 + fk * 1.1), cos(p.x * 1.1 - t * 0.28 + fk * 1.7));
              float f = sin(p.x + p.y * 0.6 + t * 0.2) + 0.7 * cos(p.y * 1.2 - p.x * 0.4 - t * 0.15);
              v += 0.022 / (abs(f) + 0.035);
            }
            v = clamp(v, 0.0, 1.6);
            col = mix(vec3(0.016, 0.05, 0.22), vec3(0.17, 0.33, 0.95), clamp(v * 0.55, 0.0, 1.0));
            col = mix(col, vec3(0.6, 0.9, 1.0), clamp((v - 0.9) * 0.6, 0.0, 1.0));
            col *= 0.75 + 0.35 * smoothstep(0.0, 1.0, px.y / size.y * 0.6 + 0.2);
            gl_FragColor = vec4(col, 1.0);
            return;
          }

          float spacing = 46.0;
          float v;
          vec2 across;
          if (mode == 0) {
            // Flowing ribs: horizontal bands bent by two slow waves.
            float bend = 34.0 * sin(px.x * 0.0035 + px.y * 0.004 + t * 0.12)
                       + 60.0 * sin(px.x * 0.0012 - px.y * 0.0021 - t * 0.07);
            v = (px.y + bend) / spacing;
            across = vec2(0.0, 1.0);
          } else {
            // Ripple ribs: rings around a point below the bottom-right corner.
            vec2 c = vec2(size.x * 0.82, -size.y * 0.18);
            vec2 d = px - c;
            v = length(d) / spacing - t * 0.04;
            across = normalize(d);
          }
          float f = fract(v);
          // Refraction: inside each rib the light is pulled toward one edge, like real fluted glass.
          vec2 bent = px + across * (f - 0.5) * 70.0;
          col = light(bent * dpr);
          vec4 shade = rib(mode == 1 ? 1.0 - f : f);
          col = mix(col, shade.rgb, shade.a);
          gl_FragColor = vec4(col, 1.0);
        }`;

      function start(canvas: HTMLCanvasElement, section: HTMLElement, mode: number) {
        const gl = canvas.getContext('webgl');
        if (!gl) return;
        const compile = (type: number, src: string) => {
          const sh = gl.createShader(type)!;
          gl.shaderSource(sh, src);
          gl.compileShader(sh);
          if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) console.error(gl.getShaderInfoLog(sh));
          return sh;
        };
        const prog = gl.createProgram()!;
        gl.attachShader(prog, compile(gl.VERTEX_SHADER, vert));
        gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, frag));
        gl.linkProgram(prog);
        gl.useProgram(prog);
        gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
        const loc = gl.getAttribLocation(prog, 'p');
        gl.enableVertexAttribArray(loc);
        gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
        const u = (name: string) => gl.getUniformLocation(prog, name);
        const [resLoc, tLoc, dprLoc, modeLoc] = [u('res'), u('t'), u('dpr'), u('mode')];

        let dpr = 1;
        const resize = () => {
          dpr = Math.min(devicePixelRatio || 1, 2);
          canvas.width = section.clientWidth * dpr;
          canvas.height = section.clientHeight * dpr;
          canvas.style.width = section.clientWidth + 'px';
          canvas.style.height = section.clientHeight + 'px';
        };
        resize();
        addEventListener('resize', resize);

        const t0 = performance.now();
        const frame = (now: number) => {
          gl.viewport(0, 0, canvas.width, canvas.height);
          gl.uniform2f(resLoc, canvas.width, canvas.height);
          gl.uniform1f(tLoc, reduce ? 8 : (now - t0) / 1000 + 8);
          gl.uniform1f(dprLoc, dpr);
          gl.uniform1i(modeLoc, mode);
          gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
          if (!reduce) requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      }

      document.querySelectorAll<HTMLElement>('.sketch').forEach((section) => {
        if (section.hidden) return;
        const canvas = section.querySelector<HTMLCanvasElement>('canvas.glass')!;
        start(canvas, section, MODES[section.dataset.bg ?? 'flow'] ?? 0);
      });
    </script>

    <style is:global>
      :root { --serif: 'Instrument Serif', Georgia, serif; }
      * { box-sizing: border-box; }
      body { margin: 0; background: #061347; color: #f3f6ff; font-family: var(--font-hanken); }
      a { color: inherit; text-decoration: none; }

      .sketch { position: relative; height: 100svh; min-height: 40rem; overflow: clip; isolation: isolate; }
      .sketch + .sketch { border-top: 1px solid rgb(255 255 255 / 0.2); }

      .tag {
        position: absolute; left: 1rem; top: 1rem; z-index: 9; margin: 0;
        font-size: 0.8rem; padding: 0.3rem 0.6rem; border-radius: 0.4rem; background: rgb(0 0 0 / 0.55);
      }

      /* The light behind the glass: one saturated cobalt family, drifting slowly. */
      .light {
        position: absolute; inset: -10%; z-index: 0;
        background:
          radial-gradient(24% 40% at 12% 22%, #b9d0ff 0%, #4f7dff 35%, transparent 70%),
          radial-gradient(22% 45% at 88% 68%, #c6dcff 0%, #3d63ff 40%, transparent 75%),
          radial-gradient(30% 40% at 62% 12%, #2a4cff 0%, transparent 70%),
          radial-gradient(26% 36% at 38% 86%, #4a6dff 0%, transparent 70%),
          linear-gradient(100deg, #0a1f7a, #04103f 45%, #0b2490);
        filter: blur(18px);
        animation: drift 26s ease-in-out infinite alternate;
      }
      @keyframes drift {
        from { transform: translate3d(-2%, -1%, 0) scale(1); }
        to { transform: translate3d(2%, 2%, 0) scale(1.06); }
      }
      .glass { position: absolute; inset: 0; z-index: 1; }
      .light { display: none; }

      .sketch > :not(.light):not(.glass) { z-index: 2; }

      .mark {
        position: absolute; top: 4.5%; left: 50%; translate: -50% 0; margin: 0;
        font-family: var(--font-clash); font-weight: 600; font-size: 1.4rem; letter-spacing: -0.02em;
      }

      .headline {
        position: absolute; left: 50%; top: 27%; translate: -50% 0; margin: 0; width: min(66rem, 92vw);
        font-family: var(--font-clash); font-weight: 500; letter-spacing: -0.035em; line-height: 0.95;
        font-size: clamp(3rem, 7vw, 6.8rem);
        text-shadow: 0 2px 30px rgb(2 6 40 / 0.35);
      }
      .l { display: block; white-space: nowrap; }
      .it { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.01em; }
      .l1 { padding-left: 2%; }
      .l2 { padding-left: 40%; font-size: 1.1em; }
      .l3 { padding-left: 0; }
      .l4 { padding-left: 33%; display: flex; align-items: center; gap: 0.4em; font-size: 1.1em; }
      .pill {
        margin-left: 0.9em;
        font-family: var(--font-hanken); font-size: 1.1rem; font-style: normal; letter-spacing: 0; font-weight: 600;
        padding: 0.85rem 1.7rem; border-radius: 999px; border: 1.5px solid currentColor; text-shadow: none;
      }

      .note { position: absolute; margin: 0; font-size: 1.05rem; line-height: 1.45; opacity: 0.85; bottom: 13%; }
      .note-left { left: 22%; }
      .note-right { right: 22%; }

      .bottom-nav {
        position: absolute; left: 0; right: 0; bottom: 3.5%;
        display: flex; justify-content: space-between; padding-inline: 14%; font-weight: 500; font-size: 1.05rem;
      }

      @media (max-width: 767px) {
        .headline { top: 22%; font-size: 11vw; }
        .l2 { padding-left: 22%; }
        .l4 { padding-left: 12%; flex-wrap: wrap; row-gap: 1rem; }
        .note-left, .note-right { left: 6%; right: 6%; }
        .note-left { bottom: 22%; }
        .note-right { bottom: 13%; }
        .bottom-nav { padding-inline: 5%; font-size: 0.9rem; }
      }

      @media (prefers-reduced-motion: reduce) {
        .light { animation: none; }
      }
    </style>
  </body>
</html>
