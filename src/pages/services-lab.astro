---
// Ticket 06, round 3: three still layout sketches for Services. Hidden (noindex), not linked.
// Open one alone with /services-lab/#a, #b or #c.
import '../styles/global.css';
import { Font } from 'astro:assets';
import { site } from '../data/content';

const [build, automate, ai] = site.services.items;
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Services lab — ShainyDev</title>
    <Font cssVariable="--font-clash" preload />
    <Font cssVariable="--font-hanken" preload />
    <Font cssVariable="--font-instrument" preload />
  </head>
  <body>
    <!-- ================= A. Glass orbs ================= -->
    <section class="sketch sk-a" id="a">
      <p class="tag">A. Glass orbs</p>
      <h2 class="kicker a-kicker">What I can do for you</h2>

      <div class="a-group a-build">
        <span class="sphere sphere-1" aria-hidden="true"></span>
        <p class="a-word">Build</p>
        <p class="a-summary">Websites<br /><span class="indent">&amp; apps</span></p>
        <p class="a-desc">{build.description}</p>
      </div>

      <div class="a-group a-automate">
        <span class="sphere sphere-2" aria-hidden="true"></span>
        <p class="a-word">Automate</p>
        <p class="a-summary">Workflows,<br /><span class="indent">data &amp; email</span></p>
        <p class="a-desc">{automate.description}</p>
      </div>

      <div class="a-group a-ai">
        <span class="sphere sphere-3" aria-hidden="true"></span>
        <p class="a-word">AI</p>
        <p class="a-summary">Assistants &amp;<br /><span class="indent">smart features</span></p>
        <p class="a-desc">{ai.description}</p>
      </div>
    </section>

    <!-- ================= B. The type index ================= -->
    <section class="sketch sk-b" id="b">
      <p class="tag">B. The type index (Automate active)</p>
      <h2 class="kicker b-kicker">What I can do for you</h2>

      <div class="b-rows">
        <div class="b-row">
          <p class="b-word b-off">Build</p>
          <p class="b-summary">Workflows,<br /><span class="indent">data &amp; email</span></p>
        </div>
        <div class="b-row">
          <p class="b-word b-on">Automate<span class="b-orb glass-orb" aria-hidden="true"></span></p>
        </div>
        <div class="b-row">
          <p class="b-word b-off">AI</p>
          <div class="b-detail">
            <p class="b-desc">{automate.description}</p>
            <ul class="b-list">
              {automate.list.map((entry) => <li>{entry}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= C. Film strip ================= -->
    <section class="sketch sk-c" id="c">
      <p class="tag">C. Film strip (scrolling moves it sideways)</p>
      <div class="c-strip">
        <div class="c-frame">
          <p class="c-word">Build<span class="c-orb glass-orb" aria-hidden="true"></span></p>
          <h2 class="kicker c-kicker">What I can do for you</h2>
          <p class="c-summary"><span>Websites</span><span class="indent">&amp; apps</span></p>
          <p class="c-desc">{build.description}</p>
          <ul class="c-list">
            {build.list.map((entry) => <li>{entry}</li>)}
          </ul>
          <p class="c-showcase">{site.interludes.build.caption}</p>
        </div>
        <div class="c-frame c-next">
          <p class="c-word">Automate</p>
        </div>
      </div>
      <div class="c-progress" aria-hidden="true">
        <span class="c-dot is-on glass-orb"></span><span class="c-dot"></span><span class="c-dot"></span>
      </div>
    </section>

    <script is:inline>
      const only = location.hash.slice(1);
      if (['a', 'b', 'c'].includes(only)) {
        document.querySelectorAll('.sketch').forEach((el) => { if (el.id !== only) el.hidden = true; });
      }
    </script>

    <style is:global>
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--color-bg); color: var(--color-fg); font-family: var(--font-body); }
      .sketch { position: relative; overflow: clip; }
      .sketch + .sketch { border-top: 1px solid var(--color-line); }
      .tag {
        position: absolute; right: 1rem; top: 1rem; z-index: 9; margin: 0;
        font-size: 0.8rem; padding: 0.3rem 0.6rem; border-radius: 0.4rem; background: rgb(255 255 255 / 0.1);
      }
      .kicker {
        margin: 0; font-family: var(--font-serif); font-style: italic; font-weight: 400;
        font-size: clamp(1.4rem, 2.1vw, 2rem); color: var(--color-muted);
      }
      .indent { padding-left: 0.9em; }
      .lit {
        background: var(--light-fill); -webkit-background-clip: text; background-clip: text; color: transparent;
      }

      /* ================= A ================= */
      .sk-a { height: 150svh; }
      .a-kicker { position: absolute; left: 6vw; top: 8svh; }
      .sphere {
        position: absolute; border-radius: 50%;
        background:
          radial-gradient(circle at 32% 26%, rgb(255 255 255 / 0.95) 0 3%, rgb(255 255 255 / 0.45) 8%, transparent 22%),
          radial-gradient(circle at 70% 78%, rgb(142 240 255 / 0.55), transparent 40%),
          radial-gradient(circle at 50% 55%, #8ef0ff 0%, #709bff 34%, #2346e0 68%, #0b1a70 100%);
        box-shadow:
          inset -2vw -2.6vw 4vw rgb(0 0 40 / 0.55),
          inset 1vw 1vw 2vw rgb(255 255 255 / 0.25),
          0 0 6vw rgb(112 155 255 / 0.35);
      }
      .a-group { position: absolute; }
      .a-word {
        position: absolute; margin: 0; white-space: nowrap;
        font-family: var(--font-display); font-weight: 600; letter-spacing: -0.05em; line-height: 0.85;
        mix-blend-mode: normal;
      }
      .a-summary {
        position: absolute; margin: 0; white-space: nowrap;
        font-family: var(--font-serif); font-style: italic; font-size: clamp(2rem, 3.4vw, 3.4rem); line-height: 1;
      }
      .a-summary .indent { display: inline-block; }
      .a-desc { position: absolute; margin: 0; width: 24vw; font-size: clamp(1rem, 1.25vw, 1.2rem); line-height: 1.5; color: var(--color-muted); }

      .a-build { left: 0; top: 0; width: 100%; height: 50svh; }
      .sphere-1 { width: 30vw; height: 30vw; left: 8vw; top: 16svh; }
      .a-build .a-word { left: 24vw; top: 26svh; font-size: 13vw; }
      .a-build .a-summary { left: 66vw; top: 18svh; }
      .a-build .a-desc { left: 66vw; top: 33svh; }

      .a-automate { left: 0; top: 0; width: 100%; height: 100%; }
      .sphere-2 { width: 22vw; height: 22vw; right: 9vw; top: 70svh; }
      .a-automate .a-word { left: 6vw; top: 72svh; font-size: 13vw; }
      .a-automate .a-summary { left: 8vw; top: 92svh; }
      .a-automate .a-desc { left: 40vw; top: 94svh; }

      .a-ai { left: 0; top: 0; width: 100%; height: 100%; }
      .sphere-3 { width: 15vw; height: 15vw; left: 30vw; top: 118svh; }
      .a-ai .a-word { left: 40vw; top: 116svh; font-size: 13vw; }
      .a-ai .a-summary { left: 64vw; top: 117svh; }
      .a-ai .a-desc { left: 64vw; top: 130svh; }

      /* ================= B ================= */
      .sk-b { height: 100svh; }
      .b-kicker { position: absolute; left: 5vw; top: 9svh; }
      .b-rows { position: absolute; left: 4vw; right: 4vw; top: 17svh; display: grid; }
      .b-row { position: relative; display: flex; align-items: flex-end; gap: 4vw; }
      .b-word {
        margin: 0; white-space: nowrap;
        font-family: var(--font-display); font-weight: 600; letter-spacing: -0.055em; line-height: 0.84;
        font-size: 16vw;
      }
      .b-off { color: transparent; -webkit-text-stroke: 1.5px color-mix(in srgb, var(--color-fg) 32%, transparent); }
      .b-on {
        background: var(--light-fill); -webkit-background-clip: text; background-clip: text; color: transparent;
        display: inline-flex; align-items: baseline;
      }
      .b-orb { width: 0.16em; height: 0.16em; margin-left: 0.05em; }
      .b-summary {
        margin: 0 0 1.4vw; font-family: var(--font-serif); font-style: italic; font-size: clamp(2.2rem, 4vw, 4rem); line-height: 1;
      }
      .b-summary .indent { display: inline-block; }
      .b-detail { display: grid; grid-template-columns: 1.2fr 1fr; gap: 3vw; align-items: end; margin-bottom: 1.4vw; flex: 1; }
      .b-desc { margin: 0; font-size: clamp(1.1rem, 1.45vw, 1.45rem); line-height: 1.5; }
      .b-list { list-style: none; margin: 0; padding: 0; }
      .b-list li {
        padding: 0.45rem 0; border-top: 1px solid var(--color-line);
        font-family: var(--font-display); font-weight: 500; font-size: clamp(1.05rem, 1.4vw, 1.4rem); letter-spacing: -0.01em;
      }

      /* ================= C ================= */
      .sk-c { height: 100svh; }
      .c-strip { position: absolute; inset: 0; display: flex; }
      .c-frame { position: relative; flex: none; width: 88vw; height: 100%; }
      .c-next { width: 60vw; border-left: 1px solid var(--color-line); }
      .c-word {
        position: absolute; left: 4vw; top: -0.12em; margin: 0; white-space: nowrap;
        font-family: var(--font-display); font-weight: 600; letter-spacing: -0.055em; line-height: 0.84;
        font-size: 21vw;
        background: var(--light-fill); -webkit-background-clip: text; background-clip: text; color: transparent;
        display: inline-flex; align-items: baseline;
      }
      .c-next .c-word { left: 5vw; opacity: 0.35; }
      .c-orb { width: 0.16em; height: 0.16em; margin-left: 0.05em; }
      .c-kicker { position: absolute; left: 6vw; top: 42svh; }
      .c-summary {
        position: absolute; left: 6vw; top: 49svh; margin: 0;
        font-family: var(--font-serif); font-style: italic; font-size: clamp(2.6rem, 5vw, 5rem); line-height: 1;
        display: grid;
      }
      .c-summary .indent { padding-left: 1.2em; }
      .c-desc { position: absolute; left: 38vw; top: 47svh; width: 24vw; margin: 0; font-size: clamp(1.1rem, 1.4vw, 1.4rem); line-height: 1.5; }
      .c-list { position: absolute; left: 38vw; top: 66svh; width: 22vw; list-style: none; margin: 0; padding: 0; }
      .c-list li {
        padding: 0.45rem 0; border-top: 1px solid var(--color-line);
        font-family: var(--font-display); font-weight: 500; font-size: clamp(1.05rem, 1.35vw, 1.35rem);
      }
      .c-showcase {
        position: absolute; left: 66vw; right: 3vw; top: 46svh; bottom: 12svh; margin: 0;
        display: grid; place-items: center; text-align: center;
        font-family: var(--font-serif); font-style: italic; font-size: clamp(1.6rem, 2.4vw, 2.4rem); line-height: 1.15;
        color: var(--color-muted);
        border-left: 1px solid var(--color-line);
      }
      .c-progress { position: absolute; left: 6vw; bottom: 6svh; display: flex; gap: 0.8rem; align-items: center; }
      .c-dot { width: 0.7rem; height: 0.7rem; border-radius: 50%; border: 1px solid var(--color-muted); font-size: 4rem; }
      .c-dot.is-on { width: 1.1rem; height: 1.1rem; border: 0; }
    </style>
  </body>
</html>
