---
// Work section, three directions to compare (A Index, B Posters, C Expand).
// Hidden (noindex), not linked. /work-lab/#dark opens in dark.
import '../styles/global.css';
import { Font } from 'astro:assets';

import { star, projects, media } from '../data/work';
---

<html lang="en" data-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Work lab — ShainyDev</title>
    <Font cssVariable="--font-clash" preload />
    <Font cssVariable="--font-hanken" preload />
    <Font cssVariable="--font-instrument" preload />
    <script is:inline>
      if (location.hash === '#dark') document.documentElement.dataset.mode = 'dark';
    </script>
  </head>
  <body>
    <header class="bar">
      <a class="brand" href="#top"><Fragment set:html={star('brand-star')} /><span>Work lab</span></a>
      <nav class="nav"><a href="#a">A · Index</a><a href="#b">B · Posters</a><a href="#c">C · Expand</a></nav>
      <button class="mode" type="button" data-mode-toggle aria-label="Switch light or dark"><span class="mode-dot"></span><span data-mode-label>Dark</span></button>
    </header>

    <!-- ===================== A · INDEX ===================== -->
    <section class="opt" id="a">
      <p class="opt-tag"><b>A</b> Index · hover a row to open it (on phone they open as you scroll)</p>
      <header class="sec-head">
        <p class="sec-no">Selected work</p>
        <h2>Things I've <em>built</em>.</h2>
      </header>
      <ol class="idx">
        {projects.map((p, i) => (
          <li class={`row${i === 0 ? ' open' : ''}`} data-row>
            <div class="row-head">
              <span class="row-n">0{i + 1}</span>
              <h3 class="row-name">{p.name}</h3>
              <span class="row-kind">{p.kind}<small>{p.who} · {p.status}</small></span>
              <span class="row-plus" aria-hidden="true"></span>
            </div>
            <div class="row-body"><div class="row-inner">
              <div class={`row-media rm-${p.id}`}><Fragment set:html={media(p.id, 'sm')} /></div>
              <div class="row-text">
                <p>{p.line}</p>
                <ul class="did">{p.did.map((d) => <li>{d}</li>)}</ul>
              </div>
            </div></div>
          </li>
        ))}
      </ol>
    </section>

    <!-- ===================== B · POSTERS ===================== -->
    <section class="opt opt-b" id="b">
      <p class="opt-tag"><b>B</b> Posters · the section holds while the projects slide past</p>
      <div class="posters" data-posters>
        <div class="poster-track" data-track>
          <article class="poster po-intro">
            <p class="sec-no">Selected work</p>
            <h2>Things I've <em>built</em>.</h2>
            <p class="po-hint">Scroll <span aria-hidden="true">→</span></p>
          </article>
          {projects.map((p, i) => (
            <article class={`poster po-${p.id}`}>
              <div class="po-media"><Fragment set:html={media(p.id)} /></div>
              <div class="po-text">
                <p class="po-kind">0{i + 1} · {p.kind} · {p.who}</p>
                <h3>{p.name}</h3>
                <p class="po-line">{p.line}</p>
              </div>
            </article>
          ))}
          <article class="poster po-next">
            <Fragment set:html={star('po-star')} />
            <h3>Your project <em>next?</em></h3>
            <a class="btn" href="mailto:info@shainydev.com">Let's talk</a>
          </article>
        </div>
        <p class="po-count" aria-hidden="true"><span data-count>01</span> / 0{projects.length}</p>
      </div>
    </section>

    <!-- ===================== C · EXPAND ===================== -->
    <section class="opt" id="c">
      <p class="opt-tag"><b>C</b> Expand · each project grows from a card to the full screen</p>
      <header class="sec-head">
        <p class="sec-no">Selected work</p>
        <h2>Things I've <em>built</em>.</h2>
      </header>
    </section>
    {projects.map((p, i) => (
      <section class={`ex ex-${p.id}`} data-ex>
        <div class="ex-card" data-ex-card><Fragment set:html={media(p.id)} /></div>
        <div class="ex-text" data-ex-text>
          <p class="ex-kind">0{i + 1} · {p.kind} · {p.who} · {p.status}</p>
          <h3>{p.name}</h3>
          <p class="ex-line">{p.line}</p>
        </div>
      </section>
    ))}
    <div class="end">End of the three options. Tell me A, B or C, or which parts to mix.</div>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import Lenis from 'lenis';
      gsap.registerPlugin(ScrollTrigger);
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      const root = document.documentElement;
      const barH = () => document.querySelector<HTMLElement>('.bar')!.offsetHeight;
      const setBar = () => root.style.setProperty('--bar', barH() + 'px');
      setBar();
      addEventListener('resize', setBar);
      const label = document.querySelector<HTMLElement>('[data-mode-label]')!;
      const sync = () => (label.textContent = root.dataset.mode === 'dark' ? 'Light' : 'Dark');
      sync();
      document.querySelector('[data-mode-toggle]')!.addEventListener('click', () => {
        root.dataset.mode = root.dataset.mode === 'dark' ? 'light' : 'dark';
        sync();
      });

      // A: one row open at a time. Hover opens on desktop; on touch screens the row nearest the middle opens.
      const rows = [...document.querySelectorAll<HTMLElement>('[data-row]')];
      const openRow = (r: HTMLElement) => rows.forEach((x) => x.classList.toggle('open', x === r));
      const canHover = matchMedia('(hover: hover)').matches;
      rows.forEach((r) => {
        if (canHover) r.addEventListener('mouseenter', () => openRow(r));
        r.querySelector('.row-head')!.addEventListener('click', () => openRow(r));
      });
      if (!canHover)
        rows.forEach((r) => ScrollTrigger.create({ trigger: r, start: 'top 55%', end: 'bottom 45%', onToggle: (s) => s.isActive && openRow(r) }));

      if (!reduce) {
        const lenis = new Lenis();
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((t) => lenis.raf(t * 1000));
        gsap.ticker.lagSmoothing(0);

        // A: the rules draw in as the rows arrive.
        gsap.from('.row', { '--rule': 0, duration: 1, ease: 'power3.inOut', stagger: 0.12, scrollTrigger: { trigger: '.idx', start: 'top 80%', toggleActions: 'play none none reverse' } });

        const mm = gsap.matchMedia();
        mm.add('(min-width: 768px)', () => {
          // B: the track slides sideways while the section is held.
          const track = document.querySelector<HTMLElement>('[data-track]')!;
          const count = document.querySelector<HTMLElement>('[data-count]')!;
          const dist = () => track.scrollWidth - innerWidth;
          gsap.to(track, {
            x: () => -dist(), ease: 'none',
            scrollTrigger: {
              trigger: '[data-posters]', start: () => 'top ' + barH(), end: () => '+=' + dist(), scrub: 0.8, pin: true, invalidateOnRefresh: true,
              onUpdate: (s) => (count.textContent = '0' + Math.min(3, Math.max(1, Math.round(s.progress * 4 + 0.3)))),
            },
          });
        });

        // C: each card opens out to the full screen, then the name rises over it.
        gsap.utils.toArray<HTMLElement>('[data-ex]').forEach((sec) => {
          const card = sec.querySelector('[data-ex-card]')!;
          const text = sec.querySelector('[data-ex-text]')!;
          gsap.timeline({ scrollTrigger: { trigger: sec, start: () => 'top ' + barH(), end: '+=120%', scrub: 0.8, pin: true, invalidateOnRefresh: true } })
            .fromTo(card, { clipPath: 'inset(16% 18% 16% 18% round 1.6rem)' }, { clipPath: 'inset(0% 0% 0% 0% round 0rem)', ease: 'power2.inOut', duration: 1 })
            .fromTo(card.firstElementChild, { scale: 1.18 }, { scale: 1, ease: 'power2.inOut', duration: 1 }, 0)
            .fromTo(text.children, { yPercent: 60, autoAlpha: 0 }, { yPercent: 0, autoAlpha: 1, stagger: 0.08, duration: 0.5, ease: 'power3.out' }, 0.75)
            .to({}, { duration: 0.3 });
        });
      }
    </script>

    <style is:global>
      :root {
        --paper: #f1ede4; --ink: #121110; --red: #e3342a; --mute: #6a655d; --line: #121110;
        --soft: rgb(18 17 16 / 0.06);
        /* Each project keeps its own brand colours in both modes. */
        --bar: 68px; --sage: #b7c5a3; --sage-ink: #34402b; --else: #e6e1cf; --night: #0b0c0f;
      }
      :root[data-mode='dark'] {
        --paper: #121110; --ink: #f1ede4; --red: #ff4536; --mute: #a39d92; --line: rgb(241 237 228 / 0.85);
        --soft: rgb(241 237 228 / 0.06);
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; }
      body { background: var(--paper); color: var(--ink); font-family: var(--font-hanken); transition: background-color 0.5s, color 0.5s; }
      a { color: inherit; text-decoration: none; }
      em { font-family: var(--font-instrument); font-style: italic; font-weight: 400; letter-spacing: -0.01em; }
      .sh { fill: var(--red); }
      svg { overflow: visible; }
      img { max-width: 100%; }

      .bar { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 2rem; padding: 1rem 4vw; background: var(--paper); border-bottom: 1.5px solid var(--line); }
      .brand { display: inline-flex; align-items: center; gap: 0.5rem; font: 600 1.1rem var(--font-clash); letter-spacing: -0.02em; }
      .brand-star { width: 1.5rem; height: auto; }
      .nav { margin-left: auto; display: flex; gap: 1.6rem; font-weight: 500; }
      .mode { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.9rem; border: 1.5px solid var(--line); border-radius: 999px; background: none; color: var(--ink); font: 600 0.9rem var(--font-hanken); cursor: pointer; }
      .mode-dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--ink); }

      .opt { padding: 10svh 4vw 12svh; border-bottom: 1.5px solid var(--line); }
      .opt-tag { margin: 0 0 6svh; display: flex; align-items: center; gap: 0.8rem; font-size: 0.95rem; color: var(--mute); }
      .opt-tag b { display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--red); color: #fff; font: 600 1rem var(--font-clash); }
      .sec-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr); gap: 1rem 4vw; align-items: end; margin-bottom: 4rem; }
      .sec-no { margin: 0; font-size: 0.95rem; color: var(--mute); }
      .sec-head h2, .po-intro h2 { margin: 0; font: 600 clamp(2.4rem, 5.2vw, 5rem)/0.98 var(--font-clash); letter-spacing: -0.045em; }
      .sec-head em, .po-intro em { color: var(--red); }

      /* Shared project visuals */
      .m-shot { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
      .m-luna { width: 100%; height: 100%; display: grid; place-items: center; background: var(--sage); }
      .m-phone { height: 86%; width: auto; filter: drop-shadow(0 1rem 1.4rem rgb(52 64 43 / 0.35)); }
      .m-term { width: 100%; height: 100%; padding: 4% 5%; display: grid; align-content: start; gap: 0.7em; background: var(--night); color: #d6dae6; font: 400 clamp(0.7rem, 1vw, 1rem)/1.45 ui-monospace, 'Cascadia Code', Consolas, monospace; }
      .m-bar { margin: 0 0 0.8em; display: flex; align-items: center; gap: 0.45em; color: #6d7385; font-size: 0.85em; }
      .m-bar span { width: 0.7em; height: 0.7em; border-radius: 50%; border: 1.5px solid #3a3f4b; }
      .m-bar span:first-child { background: var(--red); border-color: var(--red); }
      .m-bar em { margin-left: auto; font: inherit; font-style: normal; }
      .tl { margin: 0; }
      .tl.acc { color: #ff8a80; } .tl.ok { color: #9fe0a8; } .tl.dim { color: #5b6276; }
      .caret { display: inline-block; width: 0.6em; height: 1.1em; vertical-align: -0.2em; background: #d6dae6; animation: blink 1s steps(1) infinite; }
      @keyframes blink { 50% { opacity: 0; } }
      .did { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; font-size: 0.95rem; }
      .did li::before { content: '✦ '; color: var(--red); }

      /* ---------- A · Index ---------- */
      .idx { list-style: none; margin: 0; padding: 0; border-bottom: 1.5px solid var(--line); }
      .row { position: relative; --rule: 1; }
      .row::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 1.5px; background: var(--line); transform: scaleX(var(--rule)); transform-origin: left; }
      .row-head { display: grid; grid-template-columns: 4rem minmax(0, 1fr) auto 2.6rem; align-items: center; gap: 1rem 2rem; padding: 1.6rem 0; cursor: pointer; }
      .row-n { font-size: 0.95rem; color: var(--red); font-weight: 600; }
      .row-name { margin: 0; font: 600 clamp(2.6rem, 7.4vw, 7.5rem)/0.95 var(--font-clash); letter-spacing: -0.05em; transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.4s; }
      .row.open .row-name { transform: translateX(1.2rem); }
      .row-kind { display: grid; gap: 0.2rem; text-align: right; font-weight: 600; }
      .row-kind small { font-weight: 400; color: var(--mute); font-size: 0.9rem; }
      .row-plus { position: relative; width: 2.6rem; height: 2.6rem; border: 1.5px solid var(--line); border-radius: 50%; transition: background-color 0.4s, border-color 0.4s; }
      .row-plus::before, .row-plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.9rem; height: 1.5px; background: currentColor; translate: -50% -50%; transition: rotate 0.4s; }
      .row-plus::after { rotate: 90deg; }
      .row.open .row-plus { background: var(--red); border-color: var(--red); color: #fff; }
      .row.open .row-plus::after { rotate: 0deg; }
      .row-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.7s cubic-bezier(0.65, 0, 0.35, 1); }
      .row.open .row-body { grid-template-rows: 1fr; }
      .row-inner { min-height: 0; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 2rem 4vw; padding-left: 6rem; }
      .row-media { aspect-ratio: 16 / 9.5; border-radius: 1rem; overflow: hidden; margin-bottom: 2.4rem; translate: 0 2rem; opacity: 0; transition: translate 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s, opacity 0.6s 0.1s; }
      .row-text { display: grid; gap: 1.2rem; align-content: end; padding-bottom: 2.4rem; opacity: 0; transition: opacity 0.6s 0.25s; }
      .row-text p { margin: 0; max-width: 34ch; font-size: clamp(1.05rem, 1.3vw, 1.2rem); line-height: 1.5; color: var(--mute); }
      .row.open .row-media { translate: 0 0; opacity: 1; }
      .row.open .row-text { opacity: 1; }

      /* ---------- B · Posters ---------- */
      .opt-b { padding-inline: 0; padding-bottom: 0; }
      .opt-b .opt-tag { padding-inline: 4vw; }
      .posters { position: relative; height: calc(100svh - var(--bar)); overflow: hidden; }
      .poster-track { display: flex; gap: 1.5rem; height: 100%; padding: 2rem 4vw; width: max-content; }
      .poster { position: relative; flex: none; width: min(78vw, 72rem); height: 100%; border-radius: 1.4rem; overflow: hidden; }
      .po-intro { width: min(40vw, 34rem); display: grid; align-content: center; gap: 1.4rem; padding: 0 3vw 0 0; }
      .po-hint { margin: 0; font-weight: 600; color: var(--red); }
      .po-media { position: absolute; inset: 0; }
      .po-text { position: absolute; left: 0; right: 0; bottom: 0; padding: 2.4rem 2.6rem; display: grid; gap: 0.6rem; justify-items: start; }
      .po-kind { margin: 0; font-size: 0.95rem; font-weight: 600; }
      .po-text h3 { margin: 0; font: 600 clamp(3rem, 8vw, 8rem)/0.9 var(--font-clash); letter-spacing: -0.05em; }
      .po-line { margin: 0; max-width: 40ch; line-height: 1.5; }
      .po-southbound .po-text { color: #fbf8ef; background: linear-gradient(transparent, rgb(20 24 18 / 0.55)); padding-top: 8rem; }
      .po-luna .po-media .m-luna { place-items: center end; padding-right: 9%; }
      .po-luna .po-text { top: 0; right: 45%; align-content: end; color: var(--sage-ink); }
      .po-jarvis .m-term { padding: 3.5% 4% 0; font-size: clamp(0.8rem, 1.15vw, 1.1rem); }
      .po-jarvis .po-text { color: #f1ede4; }
      .po-jarvis h3 { color: #f1ede4; }
      .po-next { width: min(48vw, 40rem); background: var(--red); color: #fff; display: grid; align-content: center; justify-items: start; gap: 1.6rem; padding: 3rem; }
      .po-next h3 { margin: 0; font: 600 clamp(2.6rem, 5vw, 5rem)/0.95 var(--font-clash); letter-spacing: -0.045em; }
      .po-star { width: 5rem; height: auto; } .po-star .sh { fill: #fff; }
      .btn { display: inline-flex; padding: 0.95rem 1.5rem; border-radius: 999px; background: #fff; color: var(--red); font-weight: 600; }
      .po-count { position: absolute; right: 4vw; top: 2.6rem; margin: 0; padding: 0.4rem 0.8rem; border-radius: 999px; background: var(--paper); font-weight: 600; font-variant-numeric: tabular-nums; }

      /* ---------- C · Expand ---------- */
      #c { border-bottom: 0; padding-bottom: 4svh; }
      .ex { position: relative; height: calc(100svh - var(--bar)); overflow: hidden; }
      .ex .m-shot { object-position: center; }
      .ex-card { position: absolute; inset: 0; overflow: hidden; }
      .ex-card > * { transform-origin: 50% 50%; }
      .ex-text { position: absolute; left: 4vw; right: 4vw; bottom: 6svh; display: grid; gap: 0.7rem; justify-items: start; pointer-events: none; }
      .ex-kind { margin: 0; font-weight: 600; font-size: 0.95rem; }
      .ex-text h3 { margin: 0; font: 600 clamp(3.4rem, 11vw, 11rem)/0.88 var(--font-clash); letter-spacing: -0.055em; }
      .ex-line { margin: 0; max-width: 42ch; line-height: 1.5; }
      .ex-southbound .ex-text { color: #fbf8ef; }
      .ex-southbound .ex-card::after { content: ''; position: absolute; inset: 50% 0 0; background: linear-gradient(transparent, rgb(20 24 18 / 0.55)); pointer-events: none; }
      .ex-luna .m-luna { place-items: center end; padding-right: 12%; }
      .ex-luna .ex-text { color: var(--sage-ink); right: 50%; }
      .ex-jarvis .m-term { padding: 9svh 6vw 0; font-size: clamp(0.85rem, 1.4vw, 1.3rem); }
      .ex-jarvis .ex-text { color: #f1ede4; }
      .end { padding: 10svh 4vw; text-align: center; color: var(--mute); border-top: 1.5px solid var(--line); }

      @media (max-width: 767px) {
        .nav { gap: 0.9rem; font-size: 0.85rem; }
        .bar { gap: 1rem; flex-wrap: wrap; }
        .brand span { display: none; }
        .sec-head { grid-template-columns: minmax(0, 1fr); margin-bottom: 2.4rem; }
        .row-head { grid-template-columns: 2rem minmax(0, 1fr) 2.4rem; }
        .row-kind { grid-column: 2 / 3; text-align: left; font-size: 0.95rem; }
        .row-plus { grid-row: 1; grid-column: 3; width: 2.4rem; height: 2.4rem; }
        .row-inner { grid-template-columns: minmax(0, 1fr); padding-left: 0; gap: 1.2rem; }
        .row-media { margin-bottom: 0; }
        .row-luna .m-phone, .rm-luna .m-phone { height: 90%; }
        .rm-luna { aspect-ratio: 4 / 4.2; }
        .posters { height: auto; overflow: visible; }
        .poster-track { flex-direction: column; width: auto; padding: 0 4vw 4rem; gap: 1.2rem; }
        .poster { width: 100%; height: auto; aspect-ratio: 3 / 4.4; }
        .po-luna { aspect-ratio: 3 / 5.3; }
        .po-intro, .po-next { width: 100%; aspect-ratio: auto; padding: 2rem 0; }
        .po-next { padding: 2.4rem 1.6rem; }
        .po-count { display: none; }
        .po-text { padding: 1.6rem; }
        .po-luna .po-media .m-luna, .ex-luna .m-luna { place-items: start center; padding: 8% 0 0; }
        .po-luna .m-phone { height: 50%; }
        .ex-luna .m-phone { height: 58%; }
        .po-luna .po-text, .ex-luna .ex-text { right: 0; top: auto; }
        .po-jarvis .m-term { font-size: 0.72rem; }
        .ex-jarvis .m-term { font-size: 0.75rem; padding: 12svh 5vw 0; }
      }
      @media (prefers-reduced-motion: reduce) {
        .caret { animation: none; }
        .row-body, .row-media, .row-text, .row-name { transition: none; }
      }
    </style>
  </body>
</html>
