---
import '../styles/site.css';
import { Font } from 'astro:assets';
import { site } from '../data/site';
import { star } from '../lib/marks';
import Intro from '../components/Intro.astro';

interface Props {
  /** Accent colour: the brand red, or one of the preview colours. */
  accent?: 'red' | 'cobalt' | 'tangerine' | 'pink' | 'green' | 'plum';
  /** Include the site intro overlays (preview: variant picked by #a, #b or #c). */
  intro?: boolean;
  /** A hidden preview page: kept out of search engines, with a small switcher for the intros. */
  lab?: boolean;
  /** Preview: a switcher for trying accent colours live (picked by #red, #tangerine, …). */
  accents?: boolean;
}
const { accent = 'red', intro = false, lab = false, accents = false } = Astro.props;
// Accent previews, with the swatch shown in the switcher (the light-mode colour).
const swatches = [['red', '#e3342a'], ['tangerine', '#e2520b'], ['pink', '#d6246a'], ['green', '#17734a'], ['plum', '#8e2f6b']];
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en" data-mode="light" data-accent={accent}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.meta.title}</title>
    {lab && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={site.meta.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.meta.title} />
    <meta property="og:description" content={site.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f1ede4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1f1d1b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-clash" preload />
    <Font cssVariable="--font-hanken" preload />
    <Font cssVariable="--font-instrument" preload />
    <!-- Light or dark before first paint: the visitor's saved choice, otherwise their system setting. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('mode');
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.mode = dark ? 'dark' : 'light';
      } catch {}
    </script>
    {accents && (
      <script is:inline define:vars={{ names: swatches.map((x) => x[0]) }}>
        if (names.includes(location.hash.slice(1))) document.documentElement.dataset.accent = location.hash.slice(1);
      </script>
    )}
    {intro && (
      <script is:inline>
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const v = location.hash.slice(1);
          document.documentElement.dataset.intro = ['a', 'b', 'c'].includes(v) ? v : 'a';
        }
      </script>
    )}
  </head>
  <body>
    {intro && <Intro />}
    <a class="skip" href="#main">Skip to content</a>
    <header class="bar">
      <a class="brand" href="#main" aria-label={`${site.brand}, back to top`}><Fragment set:html={star('brand-star')} /><span>{site.brand}</span></a>
      <nav class="nav" aria-label="Sections">
        {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <button class="mode" type="button" data-mode-toggle aria-label="Switch between light and dark">
        <span class="mode-dot"></span><span data-mode-label>Dark</span>
      </button>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <span class="brand"><Fragment set:html={star('brand-star')} /><span>{site.brand}</span></span>
      <span>{site.footer} · © {new Date().getFullYear()}</span>
    </footer>
    {lab && intro && (
      <nav class="lab-switch" aria-label="Intro previews">
        <span>Intro</span>
        <a href="#a" data-lab-intro>A · Star</a><a href="#b" data-lab-intro>B · Counter</a><a href="#c" data-lab-intro>C · Split</a>
      </nav>
    )}
    {lab && accents && (
      <nav class="lab-switch" aria-label="Accent colour previews">
        <span>Colour</span>
        {swatches.map(([name, sw]) => <a href={`#${name}`} data-lab-accent style={`--sw:${sw}`}><i></i>{name[0].toUpperCase() + name.slice(1)}</a>)}
      </nav>
      <script is:inline>
        // Switch the accent in place; the hash keeps the choice on reload and in shared links.
        const links = document.querySelectorAll('[data-lab-accent]');
        const mark = () => links.forEach((a) => a.toggleAttribute('aria-current', a.hash.slice(1) === document.documentElement.dataset.accent));
        mark();
        links.forEach((a) => a.addEventListener('click', (e) => {
          e.preventDefault();
          history.replaceState(null, '', a.hash);
          document.documentElement.dataset.accent = a.hash.slice(1);
          mark();
        }));
      </script>
    )}
    <script>
      import '../scripts/site';
    </script>
    {lab && intro && (
      <script is:inline>
        // Picking an intro reloads the page from the top so it plays again.
        document.querySelectorAll('[data-lab-intro]').forEach((a) => {
          if (a.hash === (location.hash || '#a')) a.setAttribute('aria-current', 'true');
          a.addEventListener('click', (e) => {
            e.preventDefault();
            history.replaceState(null, '', a.hash);
            scrollTo(0, 0);
            location.reload();
          });
        });
      </script>
    )}
  </body>
</html>
