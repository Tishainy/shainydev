---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { site } from '../data/content';
import ThemeToggle from '../components/ThemeToggle.astro';

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.meta.title}</title>
    <meta name="description" content={site.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-clash" preload />
    <Font cssVariable="--font-hanken" preload />
    <Font cssVariable="--font-unbounded" />
    <!-- Apply the saved theme before first paint so there's no flash. Dark is the default. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body class="bg-bg text-fg antialiased">
    <header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-bg/80 backdrop-blur">
      <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <a href="#top" class="font-display text-lg font-bold tracking-tight">{site.brand}</a>
        <div class="flex items-center gap-4">
          <ul class="hidden gap-5 text-sm text-muted md:flex">
            {site.nav.map((item) => (
              <li><a href={item.href} class="hover:text-fg">{item.label}</a></li>
            ))}
          </ul>
          <ThemeToggle />
        </div>
      </nav>
    </header>
    <main id="top">
      <slot />
    </main>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
